<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: '/' },
            { title: 'Masters', link: '/masters' },
            { title: 'Category Master' }
        ]) %>

        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-1">Category Master</h1>
            </div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                <i class="bi bi-plus-lg me-1"></i> Create Category
            </button>
        </div>

        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show auto-hide-alert">
                <span><i class="bi bi-check-circle me-2"></i><%= e(success) %></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <div class="alert-time-line"></div>
            </div>
        <% } %>

        <%
        const hasActiveFilters = Boolean(statusFilter && statusFilter !== '');
        %>

        <!-- STANDARDIZED SEARCH & FILTER HEADER -->
        <div class="row g-3 align-items-center mb-3">
            <div class="col-12 col-md d-flex flex-grow-1 gap-2">
                <form method="GET" action="/categories" class="w-100 d-flex gap-2">
                    <div class="manage-search-wrapper">
                        <i class="bi bi-search manage-search-icon"></i>
                        <input type="text" name="search" class="form-control manage-search-input" placeholder="Search by ID or category name..." value="<%= e(search) %>" aria-label="Search Categories">
                        <% if (search) { %>
                            <a href="/categories" class="btn btn-sm text-muted position-absolute end-0 top-50 translate-middle-y me-2" title="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </a>
                        <% } %>
                    </div>
                    <% if (statusFilter !== '') { %><input type="hidden" name="status" value="<%= statusFilter %>"><% } %>
                </form>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2 justify-content-end">
                <button class="btn btn-filter-toggle <%= hasActiveFilters ? 'active' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection" aria-expanded="<%= hasActiveFilters ? 'true' : 'false' %>" aria-controls="filterSection">
                    <i class="bi bi-funnel"></i>
                    <span>Filters</span>
                    <% if (hasActiveFilters) { %>
                        <span class="badge bg-primary text-white rounded-pill ms-1">Active</span>
                    <% } %>
                    <i class="bi bi-chevron-down filter-toggle-icon"></i>
                </button>
            </div>
        </div>

        <!-- EXPANDABLE FILTER PANEL -->
        <div class="collapse mb-4 <%= hasActiveFilters ? 'show' : '' %>" id="filterSection">
            <div class="filter-panel-box">
                <form method="GET" action="/categories" id="filterForm">
                    <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small fw-semibold text-muted">Status</label>
                            <select name="status" id="statusFilter" class="form-select">
                                <option value="">All Status</option>
                                <option value="1" <%= statusFilter === '1' ? 'selected' : '' %>>Active</option>
                                <option value="0" <%= statusFilter === '0' ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="filter-actions">
                        <a href="/categories<%= search ? '?search=' + encodeURIComponent(search) : '' %>" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel-fill me-1"></i> Apply Filters
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- CATEGORIES TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="fw-bold">
                    <span>Records: </span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5"><%= numberFormat(totalRecords) %></span>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Category ID</th>
                                    <th>Category Name</th>
                                    <th>Description</th>
                                    <th>Created By</th>
                                    <th>Created At</th>
                                    <th>Updated By</th>
                                    <th>Updated At</th>
                                    <th class="action-column text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!categories || categories.length === 0) { %>
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            <i class="bi bi-folder2-open fs-2 d-block mb-2"></i>
                                            No categories found.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% categories.forEach(function(row) { %>
                                        <tr>
                                            <td>
                                                <span
                                                    class="status-dot <%= (parseInt(row.status) === 1) ? 'active' : 'inactive' %>"
                                                    title="<%= (parseInt(row.status) === 1) ? 'Active' : 'Inactive' %>"></span>
                                                <strong><%= e(row.category_code) %></strong>
                                            </td>
                                            <td><%= e(row.category_name) %></td>
                                            <td class="text-muted">
                                                <%= row.description ? e(row.description) : '-' %>
                                            </td>
                                            <td><%= e(row.created_by_name || row.created_by || '-') %></td>
                                            <td><%= e(row.created_at) %></td>
                                            <td><%= e(row.updated_by_name || row.updated_by || '-') %></td>
                                            <td><%= row.updated_at ? e(row.updated_at) : '-' %></td>
                                            <td class="action-column text-end text-nowrap">
                                                <a href="/categories/view/<%= row.id %>"
                                                    class="btn btn-sm btn-outline-secondary" title="View">
                                                    <i class="bi bi-eye"></i>
                                                </a>

                                                <button type="button" class="btn btn-sm btn-outline-primary" title="Edit"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editCategoryModal<%= row.id %>">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            </td>
                                        </tr>

                                        <%
                                        const isEditValidation = (validationAction === 'edit' && validationId === parseInt(row.id));
                                        const editCategoryName = isEditValidation ? (formData.category_name || row.category_name) : row.category_name;
                                        const editDescription = isEditValidation ? (formData.description || row.description) : row.description;
                                        const editStatus = isEditValidation ? (formData.status === 1 || formData.status === '1') : (parseInt(row.status) === 1);
                                        %>

                                        <div class="modal fade" id="editCategoryModal<%= row.id %>" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <div>
                                                            <h5 class="modal-title">Edit Category</h5>
                                                            <small class="text-muted"><%= e(row.category_code) %></small>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>

                                                    <form method="POST" action="/categories">
                                                        <div class="modal-body">
                                                            <input type="hidden" name="form_action" value="edit">
                                                            <input type="hidden" name="id" value="<%= row.id %>">

                                                            <div class="row g-3">
                                                                <div class="col-6 col-md-6">
                                                                    <label class="form-label">Category Code</label>
                                                                    <input type="text" class="form-control"
                                                                        value="<%= e(row.category_code) %>" readonly>
                                                                </div>

                                                                <div class="col-6 col-md-6">
                                                                    <label class="form-label">Status</label>
                                                                    <div class="form-check form-switch mt-2">
                                                                        <input class="form-check-input" type="checkbox"
                                                                            name="status" id="editStatus<%= row.id %>"
                                                                            <%= editStatus ? 'checked' : '' %>>
                                                                        <label class="form-check-label"
                                                                            for="editStatus<%= row.id %>"
                                                                            id="editStatusLabel<%= row.id %>">
                                                                            <%= editStatus ? 'Active' : 'Inactive' %>
                                                                        </label>
                                                                    </div>
                                                                </div>

                                                                <div class="col-12">
                                                                    <label class="form-label">Category Name <span class="text-danger">*</span></label>
                                                                    <input type="text" name="category_name"
                                                                        class="form-control <%= (isEditValidation && (categoryNameError || duplicateNameError)) ? 'is-invalid' : '' %>"
                                                                        value="<%= e(editCategoryName) %>"
                                                                        placeholder="Enter category name">

                                                                    <% if (isEditValidation && categoryNameError) { %>
                                                                        <div class="validation-message"><i
                                                                                class="bi bi-exclamation-circle me-1"></i><%= e(categoryNameError) %>
                                                                        </div>
                                                                    <% } else if (isEditValidation && duplicateNameError) { %>
                                                                        <div class="validation-message"><i
                                                                                class="bi bi-exclamation-circle me-1"></i><%= e(duplicateNameError) %>
                                                                        </div>
                                                                    <% } %>
                                                                </div>

                                                                <div class="col-12">
                                                                    <div class="d-flex justify-content-between">
                                                                        <label class="form-label">Description</label>
                                                                        <small class="text-muted"
                                                                            id="editDescriptionCount<%= row.id %>"><%= (editDescription || '').length %> / 200</small>
                                                                    </div>

                                                                    <textarea name="description"
                                                                        id="editDescription<%= row.id %>"
                                                                        class="form-control <%= (isEditValidation && descriptionError) ? 'is-invalid' : '' %>"
                                                                        rows="4"
                                                                        placeholder="Enter category description"><%= e(editDescription || '') %></textarea>

                                                                    <% if (isEditValidation && descriptionError) { %>
                                                                        <div class="validation-message"><i
                                                                                class="bi bi-exclamation-circle me-1"></i><%= e(descriptionError) %>
                                                                        </div>
                                                                    <% } %>
                                                                </div>

                                                                <div class="col-12">
                                                                    <hr>
                                                                    <div class="row g-3">
                                                                        <div class="col-12 col-md-6">
                                                                            <label class="form-label text-muted">Created By</label>
                                                                            <input type="text" class="form-control"
                                                                                value="<%= e(row.created_by_name || row.created_by || '') %>" readonly>
                                                                        </div>
                                                                        <div class="col-12 col-md-6">
                                                                            <label class="form-label text-muted">Created At</label>
                                                                            <input type="text" class="form-control"
                                                                                value="<%= e(row.created_at) %>" readonly>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button>
                                                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Update</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            <!-- STANDARDIZED PAGINATION -->
            <%- renderPagination({ page, totalPages, totalRecords, limit, queryParams, baseUrl: '/categories' }) %>
        </div>

    </div>
</main>

<!-- CREATE MODAL -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="POST" action="/categories">
                <div class="modal-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="modal-title mb-0 fw-bold">Create Category</h5>
                        <small class="text-muted">Add a new product category</small>
                    </div>
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="form_action" value="create">

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-check form-switch m-0 d-flex align-items-center gap-2 justify-content-end">
                                <input class="form-check-input" type="checkbox" name="status" id="createStatus" <%= (validationAction === 'create' && formData.status === 0) ? '' : 'checked' %>>
                                <label class="form-check-label mb-0 fw-semibold" for="createStatus" id="createStatusLabel">
                                    <%= (validationAction === 'create' && formData.status === 0) ? 'Inactive' : 'Active' %>
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Category Name <span class="text-danger">*</span></label>
                            <input type="text" name="category_name"
                                class="form-control <%= (validationAction === 'create' && (categoryNameError || duplicateNameError)) ? 'is-invalid' : '' %>"
                                value="<%= validationAction === 'create' ? e(formData.category_name || '') : '' %>"
                                placeholder="Enter category name">

                            <% if (validationAction === 'create' && categoryNameError) { %>
                                <div class="validation-message"><i class="bi bi-exclamation-circle me-1"></i><%= e(categoryNameError) %></div>
                            <% } else if (validationAction === 'create' && duplicateNameError) { %>
                                <div class="validation-message"><i class="bi bi-exclamation-circle me-1"></i><%= e(duplicateNameError) %></div>
                            <% } %>
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <label class="form-label">Description</label>
                                <small class="text-muted" id="createDescriptionCount">
                                    <%= validationAction === 'create' ? (formData.description || '').length : 0 %> / 200
                                </small>
                            </div>

                            <textarea name="description" id="createDescription"
                                class="form-control <%= (validationAction === 'create' && descriptionError) ? 'is-invalid' : '' %>"
                                rows="4"
                                placeholder="Enter category description"><%= validationAction === 'create' ? e(formData.description || '') : '' %></textarea>

                            <% if (validationAction === 'create' && descriptionError) { %>
                                <div class="validation-message"><i class="bi bi-exclamation-circle me-1"></i><%= e(descriptionError) %></div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const validationAction = <%- JSON.stringify(validationAction || '') %>;
        const validationId = <%= parseInt(validationId || 0) %>;

        if (validationAction === 'create') {
            const modal = document.getElementById('createCategoryModal');
            if (modal) {
                bootstrap.Modal.getOrCreateInstance(modal).show();
            }
        }

        if (validationAction === 'edit' && validationId > 0) {
            const modal = document.getElementById('editCategoryModal' + validationId);
            if (modal) {
                bootstrap.Modal.getOrCreateInstance(modal).show();
            }
        }
    });
</script>

<%- include('includes/footer') %>
