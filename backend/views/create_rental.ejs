<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: 'index.php' },
            { title: 'Rentals', link: 'manage_rental.php' },
            { title: 'Rental Checkout' }
        ]) %>

        <!-- PAGE TITLE -->
        <div class="page-heading d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">
                    <i class="bi bi-cart-plus text-primary me-2"></i>Rental Checkout
                </h1>
                <p class="text-muted mb-0">Issue equipment on rental, record advance collection, and schedule return timing.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="manage_rental.php" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Rentals
                </a>
            </div>
        </div>

        <!-- VALIDATION ERRORS -->
        <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <strong class="fs-6">Please correct the following errors:</strong>
                </div>
                <ul class="mb-0 ps-3">
                    <% errors.forEach(err => { %>
                        <li><%= err %></li>
                    <% }) %>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- MAIN RENTAL FORM -->
        <form method="POST" action="create_rental.php" id="rentalCheckoutForm" novalidate>
            <div class="row g-4">

                <!-- LEFT COLUMN: CUSTOMER & PRODUCT SELECTION -->
                <div class="col-12 col-xl-8">

                    <!-- 1. CUSTOMER SELECTION CARD -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-header bg-surface py-3 px-4 border-bottom">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-person-badge me-2"></i>1. Customer Information
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <!-- Rental Number (Auto-generated) -->
                                <div class="col-12 col-sm-4">
                                    <label class="form-label small fw-semibold">Rental #</label>
                                    <input type="text" class="form-control bg-surface-soft fw-bold text-primary" value="<%= rentalNo %>" readonly>
                                    <small class="text-muted">Auto-generated</small>
                                </div>

                                <!-- Customer Selection -->
                                <div class="col-12 col-sm-8">
                                    <label class="form-label small fw-semibold">Select Customer <span class="text-danger">*</span></label>
                                    <select name="customer_id" id="customerSelect" class="form-select" required>
                                        <option value="">-- Select Customer from Database --</option>
                                        <% customers.forEach(c => { %>
                                            <option
                                                value="<%= c.id %>"
                                                <%= (old && String(old.customer_id) === String(c.id)) ? 'selected' : '' %>
                                            >
                                                <%= c.customer_code %> - <%= c.customer_name %> (<%= c.mobile_number %>)
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <!-- DYNAMIC CUSTOMER PROFILE WIDGET -->
                            <div id="customerProfileBox" class="mt-3 p-3 rounded-3 border bg-surface-soft d-none">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 pb-2 border-bottom">
                                    <div>
                                        <h6 class="fw-bold mb-0 text-body" id="dispCustName">Customer Name</h6>
                                        <span class="text-muted small" id="dispCustCode">CUS-001</span> &bull;
                                        <span class="text-muted small" id="dispCustMobile">9876543210</span>
                                    </div>
                                    <div id="dispCreditBadge">
                                        <span class="badge bg-success-subtle text-success">Active Customer</span>
                                    </div>
                                </div>

                                <div class="row g-2 text-center">
                                    <div class="col-6 col-sm-4">
                                        <div class="p-2 bg-surface rounded border">
                                            <span class="text-muted small d-block">Credit Limit</span>
                                            <strong class="fs-6 text-body" id="dispCreditLimit">₹0.00</strong>
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <div class="p-2 bg-surface rounded border">
                                            <span class="text-muted small d-block">Current Outstanding</span>
                                            <strong class="fs-6 text-danger" id="dispPrevOutstanding">₹0.00</strong>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-4">
                                        <div class="p-2 bg-surface rounded border text-start">
                                            <span class="text-muted small d-block">Address</span>
                                            <span class="small text-truncate d-block" id="dispCustAddress">-</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. PRODUCT SELECTION CARD -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-header bg-surface py-3 px-4 border-bottom">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-box-seam me-2"></i>2. Rental Product Selection
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <!-- Product Select -->
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Select Rental Product <span class="text-danger">*</span></label>
                                    <select name="product_id" id="productSelect" class="form-select" required>
                                        <option value="">-- Choose Rental Equipment --</option>
                                        <% products.forEach(p => { %>
                                            <option
                                                value="<%= p.id %>"
                                                <%= (old && String(old.product_id) === String(p.id)) ? 'selected' : '' %>
                                            >
                                                <%= p.product_code %> - <%= p.product_name %> (Available Stock: <%= p.stock_quantity %>)
                                            </option>
                                        <% }) %>
                                    </select>
                                    <small class="text-muted">Only active products configured for rental with available stock are listed.</small>
                                </div>
                            </div>

                            <!-- DYNAMIC PRODUCT PROFILE & RATE MATRIX -->
                            <div id="productProfileBox" class="mt-3 p-3 rounded-3 border bg-surface-soft d-none">
                                <div class="row g-3 align-items-center">
                                    <div class="col-12 col-md-8">
                                        <h6 class="fw-bold mb-1 text-primary" id="dispProdName">Product Name</h6>
                                        <div class="small text-muted mb-2">
                                            <span class="badge bg-light text-dark border" id="dispProdCode">PRO-001</span> &bull;
                                            <span id="dispProdCategory">Category</span> &bull;
                                            <span id="dispProdBrand">Brand</span>
                                        </div>
                                        <div>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check2-circle me-1"></i>In Stock: <strong id="dispProdStock">0</strong> units
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4 text-md-end" id="dispProdImageContainer">
                                        <img src="" id="dispProdImage" class="img-fluid rounded border d-none" style="max-height: 80px; object-fit: cover;" alt="Product">
                                    </div>
                                </div>

                                <!-- Available Rental Rates Matrix -->
                                <div class="mt-3 pt-3 border-top">
                                    <label class="form-label small fw-bold text-muted mb-2">Configured Rental Rates:</label>
                                    <div class="row g-2" id="rentalRatesPills">
                                        <!-- Populated dynamically via JS -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. RENTAL TIMING & PERIOD CARD -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-header bg-surface py-3 px-4 border-bottom">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-calendar2-range me-2"></i>3. Rental Schedule & Timing
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <!-- Period Type -->
                                <div class="col-12 col-sm-4">
                                    <label class="form-label small fw-semibold">Billing Period <span class="text-danger">*</span></label>
                                    <select name="rental_period_type" id="rentalPeriodType" class="form-select" required>
                                        <option value="daily" <%= (old && old.rental_period_type === 'daily') ? 'selected' : '' %>>Daily</option>
                                        <option value="hourly" <%= (old && old.rental_period_type === 'hourly') ? 'selected' : '' %>>Hourly</option>
                                        <option value="weekly" <%= (old && old.rental_period_type === 'weekly') ? 'selected' : '' %>>Weekly</option>
                                        <option value="monthly" <%= (old && old.rental_period_type === 'monthly') ? 'selected' : '' %>>Monthly</option>
                                        <option value="custom" <%= (old && old.rental_period_type === 'custom') ? 'selected' : '' %>>Custom</option>
                                    </select>
                                </div>

                                <!-- Base Rental Rate -->
                                <div class="col-6 col-sm-4">
                                    <label class="form-label small fw-semibold">Rental Rate (₹) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input
                                            type="number"
                                            step="0.01"
                                            min="0"
                                            name="rental_rate"
                                            id="rentalRateInput"
                                            class="form-control"
                                            value="<%= (old && old.rental_rate) || '0.00' %>"
                                            required
                                        >
                                    </div>
                                </div>

                                <!-- Security Deposit -->
                                <div class="col-6 col-sm-4">
                                    <label class="form-label small fw-semibold">Security Deposit (₹)</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input
                                            type="number"
                                            step="0.01"
                                            min="0"
                                            name="security_deposit"
                                            id="securityDepositInput"
                                            class="form-control"
                                            value="<%= (old && old.security_deposit) || '0.00' %>"
                                        >
                                    </div>
                                </div>

                                <!-- Check-In Date & Time (Current Datetime auto-populated) -->
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small fw-semibold">
                                        <i class="bi bi-box-arrow-right text-success me-1"></i>Check-In Date & Time (Issued) <span class="text-danger">*</span>
                                    </label>
                                    <input
                                        type="datetime-local"
                                        name="check_in_datetime"
                                        id="checkInDatetime"
                                        class="form-control"
                                        value="<%= (old && old.check_in_datetime) || defaultCheckIn %>"
                                        required
                                    >
                                    <small class="text-muted">Defaults to current system date & time.</small>
                                </div>

                                <!-- Check-Out Date & Time (Expected Return) -->
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small fw-semibold">
                                        <i class="bi bi-box-arrow-in-left text-primary me-1"></i>Check-Out Date & Time (Expected Return) <span class="text-danger">*</span>
                                    </label>
                                    <input
                                        type="datetime-local"
                                        name="expected_checkout_datetime"
                                        id="expectedCheckoutDatetime"
                                        class="form-control"
                                        value="<%= (old && old.expected_checkout_datetime) || defaultCheckOut %>"
                                        required
                                    >
                                    <small class="text-muted">Expected date & time the customer will return the tool.</small>
                                </div>
                            </div>

                            <!-- DURATION & ESTIMATE PREVIEW BANNER -->
                            <div class="mt-3 p-3 bg-primary-subtle border border-primary-subtle rounded-3 text-primary d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <i class="bi bi-stopwatch me-1"></i>
                                    Estimated Duration: <strong id="dispDurationText">1 Day</strong>
                                </div>
                                <div>
                                    Estimated Total Rental Fee: <strong class="fs-5" id="dispEstimatedFee">₹0.00</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- RIGHT COLUMN: FINANCIAL SUMMARY & SUBMISSION -->
                <div class="col-12 col-xl-4">

                    <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 2rem;">
                        <div class="card-header bg-surface py-3 px-4 border-bottom">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-calculator me-2"></i>4. Payment & Checkout
                            </h5>
                        </div>
                        <div class="card-body p-4">

                            <!-- HIDDEN ESTIMATED TOTAL -->
                            <input type="hidden" name="total_rental_amount" id="hiddenTotalAmount" value="0.00">

                            <!-- Financial Breakdown Summary -->
                            <div class="bg-surface-soft p-3 rounded-3 border mb-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Estimated Rental Fee:</span>
                                    <strong class="text-body" id="summaryRentalFee">₹0.00</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Security Deposit:</span>
                                    <strong class="text-body" id="summaryDeposit">₹0.00</strong>
                                </div>
                                <hr class="my-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold text-body">Total Estimated Due:</span>
                                    <strong class="fw-bold text-primary fs-5" id="summaryGrandTotal">₹0.00</strong>
                                </div>
                            </div>

                            <!-- ADVANCE RENTAL AMOUNT (Mandatory Field) -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-body">
                                    Advance Rental Amount (₹) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-success-subtle text-success fw-bold">₹</span>
                                    <input
                                        type="number"
                                        step="0.01"
                                        min="0"
                                        name="advance_rental_amount"
                                        id="advanceAmountInput"
                                        class="form-control form-control-lg fw-bold text-success"
                                        placeholder="0.00"
                                        value="<%= (old && old.advance_rental_amount !== undefined) ? old.advance_rental_amount : '0.00' %>"
                                        required
                                    >
                                </div>
                                <div class="form-text small text-muted">
                                    Amount collected from the customer at the time of issuing the rental tool.
                                </div>
                                <div id="advanceValidationMsg" class="text-danger small mt-1 d-none">
                                    <i class="bi bi-exclamation-circle me-1"></i>Advance amount cannot be negative.
                                </div>
                            </div>

                            <!-- Balance Due / Status Indicator -->
                            <div class="p-2.5 rounded-3 border mb-3 bg-surface text-center" id="balanceStatusBox">
                                <span class="text-muted small d-block">Balance to Collect upon Return:</span>
                                <strong class="fs-5 text-danger" id="summaryRemainingBalance">₹0.00</strong>
                            </div>

                            <!-- PAYMENT METHOD -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Payment Mode</label>
                                <select name="payment_method" class="form-select">
                                    <option value="Cash" <%= (old && old.payment_method === 'Cash') ? 'selected' : '' %>>Cash</option>
                                    <option value="UPI" <%= (old && old.payment_method === 'UPI') ? 'selected' : '' %>>UPI / GPay / PhonePe</option>
                                    <option value="Card" <%= (old && old.payment_method === 'Card') ? 'selected' : '' %>>Credit / Debit Card</option>
                                    <option value="Bank Transfer" <%= (old && old.payment_method === 'Bank Transfer') ? 'selected' : '' %>>Bank Transfer / NEFT</option>
                                    <option value="Credit" <%= (old && old.payment_method === 'Credit') ? 'selected' : '' %>>Customer Ledger Credit</option>
                                </select>
                            </div>

                            <!-- NOTES -->
                            <div class="mb-4">
                                <label class="form-label small fw-semibold">Notes / Equipment Condition</label>
                                <textarea name="notes" class="form-control" rows="2" placeholder="Accessories included, condition, serial no..."><%= (old && old.notes) || '' %></textarea>
                            </div>

                            <!-- SUBMIT BUTTON -->
                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm fw-bold py-2.5" id="submitRentalBtn">
                                <i class="bi bi-check-circle me-1"></i> Confirm & Submit Rental
                            </button>
                        </div>
                    </div>

                </div>

            </div>
        </form>

    </div>
</main>

<script>
// Embedded product rates dataset from server
const serverRentalRates = <%- JSON.stringify(rentalRates) %>;

document.addEventListener('DOMContentLoaded', function () {
    const customerSelect = document.getElementById('customerSelect');
    const productSelect = document.getElementById('productSelect');
    const rentalPeriodType = document.getElementById('rentalPeriodType');
    const rentalRateInput = document.getElementById('rentalRateInput');
    const securityDepositInput = document.getElementById('securityDepositInput');
    const checkInDatetime = document.getElementById('checkInDatetime');
    const expectedCheckoutDatetime = document.getElementById('expectedCheckoutDatetime');
    const advanceAmountInput = document.getElementById('advanceAmountInput');

    let currentProductRates = [];

    // Helper: format currency
    function formatINR(val) {
        const num = parseFloat(val) || 0;
        return '₹' + num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // 1. Customer Selection AJAX Handler
    customerSelect.addEventListener('change', function () {
        const custId = parseInt(this.value, 10);
        const profileBox = document.getElementById('customerProfileBox');

        if (!custId) {
            profileBox.classList.add('d-none');
            return;
        }

        fetch(`/ajax_rental.php?action=get_customer&customer_id=${custId}`)
            .then(res => res.json())
            .then(data => {
                if (data.success && data.customer) {
                    const c = data.customer;
                    document.getElementById('dispCustName').textContent = c.customer_name;
                    document.getElementById('dispCustCode').textContent = c.customer_code;
                    document.getElementById('dispCustMobile').textContent = c.mobile_number;
                    document.getElementById('dispCustAddress').textContent = c.address;
                    document.getElementById('dispCreditLimit').textContent = formatINR(c.credit_limit);
                    document.getElementById('dispPrevOutstanding').textContent = formatINR(c.current_outstanding);
                    profileBox.classList.remove('d-none');
                } else {
                    profileBox.classList.add('d-none');
                }
            })
            .catch(err => {
                console.error('Customer fetch error:', err);
                profileBox.classList.add('d-none');
            });
    });

    // 2. Product Selection AJAX Handler
    productSelect.addEventListener('change', function () {
        const prodId = parseInt(this.value, 10);
        const prodBox = document.getElementById('productProfileBox');

        if (!prodId) {
            prodBox.classList.add('d-none');
            currentProductRates = [];
            return;
        }

        fetch(`/ajax_rental.php?action=get_product&product_id=${prodId}`)
            .then(res => res.json())
            .then(data => {
                if (data.success && data.product) {
                    const p = data.product;
                    currentProductRates = p.rates || [];

                    document.getElementById('dispProdName').textContent = p.product_name;
                    document.getElementById('dispProdCode').textContent = p.product_code;
                    document.getElementById('dispProdCategory').textContent = p.category_name;
                    document.getElementById('dispProdBrand').textContent = p.brand_name;
                    document.getElementById('dispProdStock').textContent = p.stock_quantity;

                    const imgElem = document.getElementById('dispProdImage');
                    if (p.image_path) {
                        imgElem.src = '/' + p.image_path.replace(/^\/+/, '');
                        imgElem.classList.remove('d-none');
                    } else {
                        imgElem.classList.add('d-none');
                    }

                    // Render Rate Pills
                    const pillsContainer = document.getElementById('rentalRatesPills');
                    pillsContainer.innerHTML = '';

                    if (currentProductRates.length === 0) {
                        pillsContainer.innerHTML = '<div class="col-12 text-muted small">No specific rate period configured. You can enter rates manually below.</div>';
                    } else {
                        currentProductRates.forEach(rate => {
                            const col = document.createElement('div');
                            col.className = 'col-6 col-sm-3';
                            col.innerHTML = `
                                <div class="p-2 border rounded text-center bg-surface cursor-pointer rate-pill" data-period="${rate.period}" data-rate="${rate.rental_rate}" data-deposit="${rate.security_deposit}" style="cursor: pointer;">
                                    <span class="text-muted small text-capitalize d-block">${rate.period}</span>
                                    <strong class="text-primary">${formatINR(rate.rental_rate)}</strong>
                                    ${rate.security_deposit > 0 ? `<small class="text-muted d-block" style="font-size: 0.75rem;">Dep: ${formatINR(rate.security_deposit)}</small>` : ''}
                                </div>
                            `;
                            pillsContainer.appendChild(col);
                        });

                        // Add click event to rate pills
                        pillsContainer.querySelectorAll('.rate-pill').forEach(pill => {
                            pill.addEventListener('click', function () {
                                const p = this.getAttribute('data-period');
                                const r = this.getAttribute('data-rate');
                                const d = this.getAttribute('data-deposit');

                                rentalPeriodType.value = p;
                                rentalRateInput.value = r;
                                if (parseFloat(d) > 0) {
                                    securityDepositInput.value = d;
                                }
                                updateCalculations();
                            });
                        });
                    }

                    // Auto-select rate matching current period type
                    applySelectedPeriodRate();

                    prodBox.classList.remove('d-none');
                    updateCalculations();
                } else {
                    prodBox.classList.add('d-none');
                }
            })
            .catch(err => {
                console.error('Product fetch error:', err);
                prodBox.classList.add('d-none');
            });
    });

    // 3. Period Type Change Handler
    function applySelectedPeriodRate() {
        const period = rentalPeriodType.value;
        const matchedRate = currentProductRates.find(r => r.period === period);
        if (matchedRate) {
            rentalRateInput.value = matchedRate.rental_rate.toFixed(2);
            if (matchedRate.security_deposit > 0) {
                securityDepositInput.value = matchedRate.security_deposit.toFixed(2);
            }
        }
    }

    rentalPeriodType.addEventListener('change', function () {
        applySelectedPeriodRate();
        adjustCheckoutDatetimeByPeriod();
        updateCalculations();
    });

    // Adjust checkout datetime helper based on chosen period
    function adjustCheckoutDatetimeByPeriod() {
        const checkInVal = checkInDatetime.value;
        if (!checkInVal) return;

        const inDate = new Date(checkInVal);
        if (isNaN(inDate.getTime())) return;

        const period = rentalPeriodType.value;
        let outDate = new Date(inDate.getTime());

        if (period === 'hourly') {
            outDate.setHours(outDate.getHours() + 4);
        } else if (period === 'daily') {
            outDate.setDate(outDate.getDate() + 1);
        } else if (period === 'weekly') {
            outDate.setDate(outDate.getDate() + 7);
        } else if (period === 'monthly') {
            outDate.setMonth(outDate.getMonth() + 1);
        }

        // Format to YYYY-MM-DDTHH:mm
        const pad = (n) => String(n).padStart(2, '0');
        const formatted = `${outDate.getFullYear()}-${pad(outDate.getMonth() + 1)}-${pad(outDate.getDate())}T${pad(outDate.getHours())}:${pad(outDate.getMinutes())}`;
        expectedCheckoutDatetime.value = formatted;
    }

    // 4. Update Calculations & Estimates
    function updateCalculations() {
        const checkInStr = checkInDatetime.value;
        const checkOutStr = expectedCheckoutDatetime.value;
        const period = rentalPeriodType.value;
        const rate = parseFloat(rentalRateInput.value) || 0;
        const deposit = parseFloat(securityDepositInput.value) || 0;
        const advance = parseFloat(advanceAmountInput.value) || 0;

        let units = 1;
        let durationText = '1 Day';

        if (checkInStr && checkOutStr) {
            const dtIn = new Date(checkInStr);
            const dtOut = new Date(checkOutStr);
            const diffMs = dtOut.getTime() - dtIn.getTime();

            if (!isNaN(diffMs) && diffMs > 0) {
                const diffHours = Math.max(1, Math.ceil(diffMs / (1000 * 60 * 60)));
                const diffDays = Math.max(1, Math.ceil(diffMs / (1000 * 60 * 60 * 24)));
                const diffWeeks = Math.max(1, Math.ceil(diffDays / 7));
                const diffMonths = Math.max(1, Math.ceil(diffDays / 30));

                if (period === 'hourly') {
                    units = diffHours;
                    durationText = `${units} Hour${units > 1 ? 's' : ''}`;
                } else if (period === 'daily') {
                    units = diffDays;
                    durationText = `${units} Day${units > 1 ? 's' : ''}`;
                } else if (period === 'weekly') {
                    units = diffWeeks;
                    durationText = `${units} Week${units > 1 ? 's' : ''}`;
                } else if (period === 'monthly') {
                    units = diffMonths;
                    durationText = `${units} Month${units > 1 ? 's' : ''}`;
                } else {
                    units = diffDays;
                    durationText = `${units} Day${units > 1 ? 's' : ''}`;
                }
            }
        }

        const totalRentalFee = units * rate;
        const grandTotalDue = totalRentalFee + deposit;
        const remainingBalance = Math.max(0, grandTotalDue - advance);

        document.getElementById('dispDurationText').textContent = durationText;
        document.getElementById('dispEstimatedFee').textContent = formatINR(totalRentalFee);

        document.getElementById('summaryRentalFee').textContent = formatINR(totalRentalFee);
        document.getElementById('summaryDeposit').textContent = formatINR(deposit);
        document.getElementById('summaryGrandTotal').textContent = formatINR(grandTotalDue);
        document.getElementById('summaryRemainingBalance').textContent = formatINR(remainingBalance);

        document.getElementById('hiddenTotalAmount').value = grandTotalDue.toFixed(2);
    }

    rentalRateInput.addEventListener('input', updateCalculations);
    securityDepositInput.addEventListener('input', updateCalculations);
    checkInDatetime.addEventListener('change', updateCalculations);
    expectedCheckoutDatetime.addEventListener('change', updateCalculations);
    advanceAmountInput.addEventListener('input', function () {
        const val = parseFloat(this.value);
        const msg = document.getElementById('advanceValidationMsg');
        if (val < 0) {
            msg.classList.remove('d-none');
        } else {
            msg.classList.add('d-none');
        }
        updateCalculations();
    });

    // Form submission validation
    document.getElementById('rentalCheckoutForm').addEventListener('submit', function (e) {
        const cust = customerSelect.value;
        const prod = productSelect.value;
        const inDt = checkInDatetime.value;
        const outDt = expectedCheckoutDatetime.value;
        const adv = parseFloat(advanceAmountInput.value);

        if (!cust) {
            e.preventDefault();
            alert('Please select a customer.');
            customerSelect.focus();
            return;
        }

        if (!prod) {
            e.preventDefault();
            alert('Please select a rental product.');
            productSelect.focus();
            return;
        }

        if (!inDt) {
            e.preventDefault();
            alert('Please select Check-In Date & Time.');
            checkInDatetime.focus();
            return;
        }

        if (!outDt) {
            e.preventDefault();
            alert('Please select Check-Out Date & Time.');
            expectedCheckoutDatetime.focus();
            return;
        }

        if (new Date(outDt) <= new Date(inDt)) {
            e.preventDefault();
            alert('Check-Out (Expected Return) Date & Time must be later than Check-In Date & Time.');
            expectedCheckoutDatetime.focus();
            return;
        }

        if (isNaN(adv) || adv < 0) {
            e.preventDefault();
            alert('Please enter a valid, non-negative Advance Rental Amount.');
            advanceAmountInput.focus();
            return;
        }
    });

    // Trigger initial state if old values existed
    if (customerSelect.value) {
        customerSelect.dispatchEvent(new Event('change'));
    }
    if (productSelect.value) {
        productSelect.dispatchEvent(new Event('change'));
    }
    updateCalculations();
});
</script>

