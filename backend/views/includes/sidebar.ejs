<%
const salesPages = ['manage_sales_note.php', 'create_sales_note.php', 'edit_sales_note.php', 'view_sales_note.php', 'manage_sales_note', 'create_sales_note', 'edit_sales_note', 'view_sales_note'];
const rentalPages = ['manage_rental.php', 'create_rental.php', 'edit_rental.php', 'view_rental.php', 'manage_rental', 'create_rental', 'view_rental'];
const productPages = ['manage_product.php', 'create_product.php', 'edit_product.php', 'view_product.php', 'manage_product', 'create_product', 'edit_product', 'view_product'];
const customerPages = ['manage_customer.php', 'create_customer.php', 'edit_customer.php', 'view_customer.php', 'manage_customer', 'create_customer', 'edit_customer', 'view_customer'];
const reportPages = ['reports.php', 'reports'];
const userPages = ['manage_user.php', 'create_user.php', 'edit_user.php', 'view_user.php', 'manage_user', 'create_user', 'edit_user', 'view_user'];

const cur = typeof currentPath !== 'undefined' ? currentPath : '';

const menuItems = [
    {
        title: 'Dashboard',
        icon: 'bi-speedometer2',
        link: '/',
        active: (cur === '/' || cur === '/index' || currentPage === 'index.php' || currentPage === '')
    },
    {
        title: 'Sales',
        icon: 'bi-receipt',
        link: '/sales-notes',
        active: (cur.startsWith('/sales-notes') || salesPages.includes(currentPage))
    },
    {
        title: 'Rentals',
        icon: 'bi-clock-history',
        link: '/rentals',
        active: (cur.startsWith('/rentals') || rentalPages.includes(currentPage))
    },
    {
        title: 'Product',
        icon: 'bi-box-seam',
        link: '/products',
        active: (cur.startsWith('/products') || productPages.includes(currentPage))
    },
    {
        title: 'Customers',
        icon: 'bi-people',
        link: '/customers',
        active: (cur.startsWith('/customers') || customerPages.includes(currentPage))
    },
    {
        title: 'Users',
        icon: 'bi-person-badge',
        link: '/users',
        active: (cur.startsWith('/users') || userPages.includes(currentPage))
    },

        {
        title: 'Reports',
        icon: 'bi-file-earmark-bar-graph',
        link: '/reports',
        active: (cur.startsWith('/reports') || reportPages.includes(currentPage))
    },
        {
        title: 'Profile',
        icon: 'bi-person-circle',
        link: '/profile',
        active: (cur === '/profile' || currentPage === 'profile.php')
    },
    {
        title: 'Settings',
        icon: 'bi-gear',
        link: '/masters',
        active: (cur === '/settings' || cur === '/masters' || cur.startsWith('/categories') || cur.startsWith('/brands') || cur.startsWith('/units') || ['masters.php', 'manage_category.php', 'manage_brand.php', 'manaage_unit.php'].includes(currentPage))
    }
];
%>

<aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">

    <!-- Logo -->
    <div class="sidebar-header">
        <a class="brand-mark" href="/" aria-label="Dashboard">
            <span class="brand-icon">
                <i class="bi bi-tools"></i>
            </span>

            <span class="brand-copy">
                <span class="brand-title">
                    Sun PowerTools
                </span>
            </span>
        </a>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">
        <% menuItems.forEach(function(item) { %>
            <a class="nav-link <%= item.active ? 'active' : '' %>" href="<%= e(item.link) %>"
                <%= item.active ? 'aria-current="page"' : '' %>>
                <span class="nav-icon">
                    <i class="bi <%= e(item.icon) %>" aria-hidden="true"></i>
                </span>
                <span class="nav-text">
                    <%= e(item.title) %>
                </span>
            </a>
        <% }); %>
    </nav>
</aside>
