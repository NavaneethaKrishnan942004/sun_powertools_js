<%- include('includes/header') %>
<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: '/' },
            { title: 'Masters', link: '/masters' },
            { title: 'User Master' }
        ]) %>

        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-1">User Master</h1>
            </div>
            <a href="/users/create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Create User</a>
        </div>

        <% if (locals.success && success) { %>
            <div class="alert alert-success alert-dismissible fade show auto-hide-alert">
                <span><i class="bi bi-check-circle me-2"></i><%= success %></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <div class="alert-time-line"></div>
            </div>
        <% } %>

        <% if (locals.error && error) { %>
            <div class="alert alert-danger alert-dismissible fade show auto-hide-alert">
                <span><i class="bi bi-exclamation-circle me-2"></i><%= error %></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <div class="alert-time-line"></div>
            </div>
        <% } %>

        <%
        const hasActiveFilters = Boolean((statusFilter && statusFilter !== '') || (roleFilter && roleFilter !== ''));
        %>

        <!-- STANDARDIZED SEARCH & FILTER HEADER -->
        <div class="row g-3 align-items-center mb-3">
            <div class="col-12 col-md d-flex flex-grow-1 gap-2">
                <form method="GET" action="/users" class="w-100 d-flex gap-2">
                    <div class="manage-search-wrapper">
                        <i class="bi bi-search manage-search-icon"></i>
                        <input type="text" name="search" class="form-control manage-search-input" placeholder="Search by ID, user name, email, phone..." value="<%= search || '' %>" aria-label="Search Users">
                        <% if (search) { %>
                            <a href="/users" class="btn btn-sm text-muted position-absolute end-0 top-50 translate-middle-y me-2" title="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </a>
                        <% } %>
                    </div>
                    <% if (roleFilter) { %><input type="hidden" name="role" value="<%= roleFilter %>"><% } %>
                    <% if (statusFilter !== '') { %><input type="hidden" name="status" value="<%= statusFilter %>"><% } %>
                </form>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2 justify-content-end">
                <button class="btn btn-filter-toggle <%= hasActiveFilters ? 'active' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection" aria-expanded="<%= hasActiveFilters ? 'true' : 'false' %>" aria-controls="filterSection">
                    <i class="bi bi-funnel"></i>
                    <span>Filters</span>
                    <% if (hasActiveFilters) { %>
                        <span class="badge bg-primary text-white rounded-pill ms-1">Active</span>
                    <% } %>
                    <i class="bi bi-chevron-down filter-toggle-icon"></i>
                </button>
            </div>
        </div>

        <!-- EXPANDABLE FILTER PANEL -->
        <div class="collapse mb-4 <%= hasActiveFilters ? 'show' : '' %>" id="filterSection">
            <div class="filter-panel-box">
                <form method="GET" action="/users" id="userFilterForm">
                    <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small fw-semibold text-muted">Role</label>
                            <select name="role" id="userRoleFilter" class="form-select">
                                <option value="">All Roles</option>
                                <option value="user" <%= roleFilter === 'user' ? 'selected' : '' %>>User</option>
                                <option value="admin" <%= roleFilter === 'admin' ? 'selected' : '' %>>Admin</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small fw-semibold text-muted">Status</label>
                            <select name="status" id="userStatusFilter" class="form-select">
                                <option value="">All Status</option>
                                <option value="1" <%= statusFilter === '1' ? 'selected' : '' %>>Active</option>
                                <option value="0" <%= statusFilter === '0' ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="filter-actions">
                        <a href="/users<%= search ? '?search=' + encodeURIComponent(search) : '' %>" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel-fill me-1"></i> Apply Filters
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- USERS TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="fw-bold">
                    <span>Records: </span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5"><%= numberFormat(totalRecords) %></span>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">User ID</th>
                                <th>User Name</th>
                                <th>User Mail</th>
                                <th>Phone No</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Created At</th>
                                <th>Updated At</th>
                                <th class="action-column text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!users || users.length === 0) { %>
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="bi bi-people fs-2 d-block mb-2 text-muted"></i>
                                        <p class="mb-0 fw-medium">No users found.</p>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% users.forEach(function(row) { %>
                                    <tr>
                                        <td class="ps-4">
                                            <span class="status-dot <%= parseInt(row.status) === 1 ? 'active' : 'inactive' %>"
                                                title="<%= parseInt(row.status) === 1 ? 'Active' : 'Inactive' %>"></span>
                                            <strong><%= row.user_id %></strong>
                                        </td>
                                        <td class="fw-semibold text-body"><%= row.user_name %></td>
                                        <td><%= row.user_email %></td>
                                        <td><%= row.user_phone %></td>
                                        <td>
                                            <span class="badge <%= row.role === 'admin' ? 'text-bg-primary' : 'text-bg-secondary' %>">
                                                <%= row.role.charAt(0).toUpperCase() + row.role.slice(1) %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge <%= parseInt(row.status) === 1 ? 'text-bg-success' : 'text-bg-danger' %>">
                                                <%= parseInt(row.status) === 1 ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td><small class="text-muted"><%= row.created_at ? new Date(row.created_at).toLocaleDateString('en-GB') : '-' %></small></td>
                                        <td><small class="text-muted"><%= row.updated_at ? new Date(row.updated_at).toLocaleDateString('en-GB') : '-' %></small></td>
                                        <td class="action-column text-end pe-4 text-nowrap">
                                            <div class="btn-group btn-group-sm">
                                                <a href="/users/view/<%= row.id %>" class="btn btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                                                <a href="/users/edit/<%= row.id %>" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- STANDARDIZED PAGINATION -->
            <%- renderPagination({ page, totalPages, totalRecords, limit, queryParams, baseUrl: '/users' }) %>
        </div>
    </div>
</main>
<%- include('includes/footer') %>
