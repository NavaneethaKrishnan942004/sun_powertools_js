<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: '/' },
            { title: 'Rentals' }
        ]) %>

        <!-- PAGE HEADING & PRIMARY ACTIONS -->
        <div class="page-heading d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">
                    <i class="bi bi-clock-history text-primary me-2"></i>Rental Management
                </h1>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/rentals/create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Create Rental Checkout
                </a>
            </div>
        </div>

        <!-- ALERTS / NOTIFICATIONS -->
        <% if (locals.success) { %>
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="fw-medium"><%= success %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="fw-medium"><%= error %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- SUMMARY KPI CARDS -->
        <div class="row g-3 mb-4">
            <!-- Total Rentals -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="metric-card metric-primary p-3 rounded-4 shadow-sm border bg-surface">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Total Rentals</span>
                        <div class="avatar-xs bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                            <i class="bi bi-tools fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1"><%= numberFormat(analytics.total_rentals, 0) %></h3>
                    <div class="text-muted small">
                        <span class="badge bg-primary-subtle text-primary"><%= numberFormat(analytics.returned_rentals, 0) %></span> returned
                    </div>
                </div>
            </div>

            <!-- Active Rentals -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="metric-card metric-info p-3 rounded-4 shadow-sm border bg-surface">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Active Rentals</span>
                        <div class="avatar-xs bg-info-subtle text-info rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                            <i class="bi bi-clock-history fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1 text-info"><%= numberFormat(analytics.active_rentals, 0) %></h3>
                    <div class="text-muted small">Currently rented out</div>
                </div>
            </div>

            <!-- Overdue Rentals -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="metric-card <%= analytics.overdue_rentals > 0 ? 'metric-danger border-danger-subtle' : 'metric-warning' %> p-3 rounded-4 shadow-sm border bg-surface">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Overdue Returns</span>
                        <div class="avatar-xs <%= analytics.overdue_rentals > 0 ? 'bg-danger text-white' : 'bg-warning-subtle text-warning-emphasis' %> rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1 <%= analytics.overdue_rentals > 0 ? 'text-danger' : 'text-body' %>"><%= numberFormat(analytics.overdue_rentals, 0) %></h3>
                    <div class="text-muted small">
                        <% if (analytics.overdue_rentals > 0) { %>
                            <span class="text-danger fw-semibold">Action needed</span> - past due date
                        <% } else { %>
                            All returns on schedule
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Total Advance Collected -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="metric-card metric-success p-3 rounded-4 shadow-sm border bg-surface">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Advance Collected</span>
                        <div class="avatar-xs bg-success-subtle text-success rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                            <i class="bi bi-currency-rupee fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1 text-success">₹<%= numberFormat(analytics.total_advance_collected, 2) %></h3>
                    <div class="text-muted small">Advances from active rentals</div>
                </div>
            </div>
        </div>

        <%
        const hasActiveFilters = Boolean(statusFilter || fromDateFilter || toDateFilter);
        %>

        <!-- STANDARDIZED SEARCH & FILTER HEADER -->
        <div class="row g-3 align-items-center mb-3">
            <div class="col-12 col-md d-flex flex-grow-1 gap-2">
                <form method="GET" action="/rentals" class="w-100 d-flex gap-2">
                    <div class="manage-search-wrapper">
                        <i class="bi bi-search manage-search-icon"></i>
                        <input type="text" name="search" class="form-control manage-search-input" placeholder="Search by Rental #, Customer Name, Mobile, Product..." value="<%= search %>" aria-label="Search Rentals">
                        <% if (search) { %>
                            <a href="/rentals" class="btn btn-sm text-muted position-absolute end-0 top-50 translate-middle-y me-2" title="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </a>
                        <% } %>
                    </div>
                    <% if (statusFilter) { %><input type="hidden" name="status" value="<%= statusFilter %>"><% } %>
                    <% if (fromDateFilter) { %><input type="hidden" name="from_date" value="<%= fromDateFilter %>"><% } %>
                    <% if (toDateFilter) { %><input type="hidden" name="to_date" value="<%= toDateFilter %>"><% } %>
                </form>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2 justify-content-end">
                <button class="btn btn-filter-toggle <%= hasActiveFilters ? 'active' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection" aria-expanded="<%= hasActiveFilters ? 'true' : 'false' %>" aria-controls="filterSection">
                    <i class="bi bi-funnel"></i>
                    <span>Filters</span>
                    <% if (hasActiveFilters) { %>
                        <span class="badge bg-primary text-white rounded-pill ms-1">Active</span>
                    <% } %>
                    <i class="bi bi-chevron-down filter-toggle-icon"></i>
                </button>
            </div>
        </div>

        <!-- EXPANDABLE FILTER PANEL -->
        <div class="collapse mb-4 <%= hasActiveFilters ? 'show' : '' %>" id="filterSection">
            <div class="filter-panel-box">
                <form method="GET" action="/rentals" id="rentalFilterForm">
                    <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>
                    <div class="row g-3">
                        <!-- Status Filter -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-1">Rental Status</label>
                            <select name="status" class="form-select">
                                <option value="">All Statuses</option>
                                <option value="Active" <%= statusFilter === 'Active' ? 'selected' : '' %>>Active</option>
                                <option value="Overdue" <%= statusFilter === 'Overdue' ? 'selected' : '' %>>Overdue</option>
                                <option value="Returned" <%= statusFilter === 'Returned' ? 'selected' : '' %>>Returned</option>
                                <option value="Cancelled" <%= statusFilter === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>

                        <!-- From Date -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
                            <input type="date" name="from_date" class="form-control" value="<%= fromDateFilter %>">
                        </div>

                        <!-- To Date -->
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
                            <input type="date" name="to_date" class="form-control" value="<%= toDateFilter %>">
                        </div>
                    </div>

                    <div class="filter-actions">
                        <a href="/rentals<%= search ? '?search=' + encodeURIComponent(search) : '' %>" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel-fill me-1"></i> Apply Filters
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RENTALS DATA TABLE -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="fw-bold">
                    <span>Records: </span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5"><%= numberFormat(totalRecords) %></span>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0" id="rentalsTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Rental ID</th>
                                <th>Customer</th>
                                <th>Product</th>
                                <th>Start & Rate</th>
                                <th>Duration & Expected Return</th>
                                <th>Advance & Deposit</th>
                                <th>Status</th>
                                <th class="action-column action-column-wide text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (rentals.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <div class="my-4">
                                             <i class="bi bi-clock-history display-4 text-muted d-block mb-3"></i>
                                            <h5 class="fw-semibold text-body">No Rental Records Found</h5>
                                            <p class="text-muted mb-3">Start renting power tools by creating a new rental transaction.</p>
                                            <a href="/rentals/create" class="btn btn-primary">
                                                <i class="bi bi-plus-lg me-1"></i> Create Rental
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% rentals.forEach(row => { %>
                                    <tr>
                                        <!-- RENTAL ID -->
                                        <td class="ps-4 text-nowrap">
                                            <div class="fw-bold text-primary">
                                                <a href="/rentals/view/<%= row.id %>" class="text-decoration-none text-primary">
                                                    <%= row.rental_no %>
                                                </a>
                                            </div>
                                            <small class="text-muted"><%= row.created_at ? String(row.created_at).slice(0, 10) : '' %></small>
                                        </td>

                                        <!-- CUSTOMER -->
                                        <td>
                                            <div class="fw-semibold text-body">
                                                <a href="/customers/view/<%= row.customer_id %>" class="text-decoration-none text-body">
                                                    <%= row.customer_name %>
                                                </a>
                                            </div>
                                            <div class="small text-muted">
                                                <span><%= row.customer_code %></span> &bull;
                                                <span><i class="bi bi-telephone me-1"></i><%= row.mobile_number %></span>
                                            </div>
                                        </td>

                                        <!-- PRODUCT -->
                                        <td>
                                            <div class="fw-semibold text-body text-truncate" style="max-width: 250px;" title="<%= row.product_name %>">
                                                <a href="/products/view/<%= row.product_id %>" class="text-decoration-none text-body">
                                                    <%= row.product_name %>
                                                </a>
                                            </div>
                                            <div class="small text-muted">
                                                <span class="badge bg-light text-dark border"><%= row.product_code %></span>
                                                <% if (row.brand_name) { %>
                                                    <span class="ms-1 text-muted"><%= row.brand_name %></span>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- CHECK-IN & RATE -->
                                        <td class="text-nowrap">
                                            <div class="fw-medium">
                                                <i class="bi bi-box-arrow-right text-success me-1"></i>
                                                <%= row.check_in_datetime ? String(row.check_in_datetime).replace('T', ' ').slice(0, 16) : '-' %>
                                            </div>
                                            <small class="text-muted text-capitalize"><%= row.rental_period_type || 'Daily' %> @ ₹<%= numberFormat(row.rental_rate, 2) %></small>
                                        </td>

                                        <!-- DURATION & EXPECTED CHECK-OUT -->
                                        <td class="text-nowrap">
                                            <div class="fw-medium <%= row.effective_status === 'Overdue' ? 'text-danger fw-bold' : '' %>">
                                                <i class="bi bi-box-arrow-in-left <%= row.effective_status === 'Overdue' ? 'text-danger' : 'text-primary' %> me-1"></i>
                                                <%= row.expected_checkout_datetime ? String(row.expected_checkout_datetime).replace('T', ' ').slice(0, 16) : '-' %>
                                            </div>
                                            <div class="small">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    <%= row.estimated_duration || 1 %> <%= (row.rental_period_type || 'day').replace(/s$/, '') %>(s)
                                                </span>
                                                <% if (row.effective_status === 'Returned' && row.actual_return_datetime) { %>
                                                    <span class="text-success ms-1"><i class="bi bi-check2-circle"></i> <%= row.actual_duration || 'Returned' %></span>
                                                <% } else if (row.effective_status === 'Overdue') { %>
                                                    <span class="text-danger fw-semibold ms-1"><i class="bi bi-exclamation-circle"></i> Overdue</span>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- ADVANCE & DEPOSIT AMOUNT -->
                                        <td class="text-nowrap">
                                            <div class="fw-bold text-success">
                                                Advance: ₹<%= numberFormat(row.advance_rental_amount, 2) %>
                                            </div>
                                            <% if (Number(row.security_deposit) > 0) { %>
                                                <small class="text-muted d-block">Deposit: ₹<%= numberFormat(row.security_deposit, 2) %></small>
                                            <% } %>
                                        </td>

                                        <!-- STATUS -->
                                        <td>
                                            <%- getRentalStatusBadge(row.rental_status, row.expected_checkout_datetime) %>
                                        </td>

                                        <!-- ACTIONS -->
                                        <td class="action-column action-column-wide text-end pe-4 text-nowrap">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <!-- View -->
                                                <a href="/rentals/view/<%= row.id %>" class="btn btn-outline-secondary" title="View Rental Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>

                                                <!-- Return Product (if Active or Overdue) -->
                                                <% if (['Active', 'Overdue'].includes(row.effective_status)) { %>
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-success"
                                                        title="Return Product"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#returnModal"
                                                        data-rental-id="<%= row.id %>"
                                                        data-rental-no="<%= row.rental_no %>"
                                                        data-customer="<%= row.customer_name %>"
                                                        data-customer-code="<%= row.customer_code %>"
                                                        data-product="<%= row.product_name %>"
                                                        data-period="<%= row.rental_period_type || 'Daily' %>"
                                                        data-rate="<%= row.rental_rate %>"
                                                        data-duration="<%= row.estimated_duration || 1 %>"
                                                        data-advance="<%= row.advance_rental_amount %>"
                                                        data-deposit="<%= row.security_deposit || 0 %>"
                                                        data-checkin="<%= row.check_in_datetime ? String(row.check_in_datetime).replace('T', ' ').slice(0, 16) : '' %>"
                                                        data-expected="<%= row.expected_checkout_datetime ? String(row.expected_checkout_datetime).replace('T', ' ').slice(0, 16) : '' %>"
                                                    >
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Return
                                                    </button>
                                                <% } %>

                                                <!-- Cancel (if Active) -->
                                                <% if (row.rental_status === 'Active') { %>
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-danger"
                                                        title="Cancel Rental"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#cancelModal"
                                                        data-rental-id="<%= row.id %>"
                                                        data-rental-no="<%= row.rental_no %>"
                                                    >
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- STANDARDIZED PAGINATION -->
            <%- renderPagination({ page, totalPages, totalRecords, limit, queryParams, baseUrl: '/rentals' }) %>
        </div>

    </div>
</main>

<!-- RETURN PRODUCT MODAL WITH LIVE CALCULATION -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="POST" action="/rentals/return" id="returnForm">
                <input type="hidden" name="id" id="returnRentalId">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-success" id="returnModalLabel">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Return Rental Product & Settlement
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- CONTRACT OVERVIEW -->
                    <div class="p-3 bg-surface-soft rounded-3 border mb-3">
                        <div class="row g-2">
                            <div class="col-12 col-sm-6">
                                <span class="text-muted small">Rental Number:</span>
                                <strong class="text-primary d-block" id="modalRentalNo">-</strong>
                            </div>
                            <div class="col-12 col-sm-6">
                                <span class="text-muted small">Customer:</span>
                                <strong class="d-block" id="modalCustomer">-</strong>
                            </div>
                            <div class="col-12 col-sm-6">
                                <span class="text-muted small">Product:</span>
                                <strong class="d-block" id="modalProduct">-</strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted small">Advance Paid:</span>
                                <strong class="text-success d-block" id="modalAdvance">₹0.00</strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted small">Deposit Held:</span>
                                <strong class="text-body d-block" id="modalDeposit">₹0.00</strong>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Actual Return Date & Time -->
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-semibold">Actual Return Date & Time <span class="text-danger">*</span></label>
                            <input
                                type="datetime-local"
                                name="actual_return_datetime"
                                id="modalReturnDatetime"
                                class="form-control"
                                value="<%= currentDatetimeLocal %>"
                                required
                            >
                        </div>

                        <!-- Additional Charges / Late Fee -->
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-semibold">Additional Charges / Late Penalty (₹)</label>
                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                name="additional_charges"
                                id="modalAdditionalCharges"
                                class="form-control"
                                value="0.00"
                            >
                        </div>

                        <!-- Deposit Deductions -->
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-semibold">Deposit Deductions (Damage / Loss) (₹)</label>
                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                name="deposit_deduction_amount"
                                id="modalDepositDeduction"
                                class="form-control"
                                value="0.00"
                            >
                        </div>

                        <!-- Deposit Deduction Reason -->
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-semibold">Reason for Deposit Deduction</label>
                            <input
                                type="text"
                                name="deposit_deduction_reason"
                                id="modalDeductionReason"
                                class="form-control"
                                placeholder="e.g., Broken blade, missing accessories..."
                            >
                        </div>

                        <!-- Notes / Condition -->
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Condition Notes / Remarks</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Tool returned in good condition..."></textarea>
                        </div>
                    </div>

                    <!-- LIVE SETTLEMENT CALCULATION SUMMARY CARD -->
                    <div class="mt-4 p-3 bg-light border rounded-3">
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-receipt me-1"></i>Live Return Settlement Summary
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-muted">Rental Start:</td>
                                        <td class="text-end fw-semibold" id="modalDispStart">-</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Expected Return:</td>
                                        <td class="text-end fw-semibold" id="modalDispExpected">-</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Actual Duration:</td>
                                        <td class="text-end fw-bold text-primary" id="modalDispActualDuration">-</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Overdue Duration:</td>
                                        <td class="text-end fw-bold" id="modalDispOverdueDuration">-</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Original Rental Amount:</td>
                                        <td class="text-end fw-semibold" id="modalDispOriginalAmount">₹0.00</td>
                                    </tr>
                                    <tr id="modalOverdueRow">
                                        <td class="text-muted text-danger">Additional Overdue Fee:</td>
                                        <td class="text-end fw-bold text-danger" id="modalDispOverdueAmount">₹0.00</td>
                                    </tr>
                                    <tr class="border-top">
                                        <td class="fw-bold text-body">Total Rental Amount:</td>
                                        <td class="text-end fw-bold text-primary fs-6" id="modalDispTotalAmount">₹0.00</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Advance Paid:</td>
                                        <td class="text-end text-success fw-semibold" id="modalDispAdvance">₹0.00</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Security Deposit Held:</td>
                                        <td class="text-end fw-semibold" id="modalDispDeposit">₹0.00</td>
                                    </tr>
                                    <tr class="border-top">
                                        <td class="fw-bold text-success">Security Deposit Returned to Customer:</td>
                                        <td class="text-end fw-bold text-success fs-6" id="modalDispDepositReturned">₹0.00</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Deposit Applied Toward Outstanding Charges:</td>
                                        <td class="text-end text-warning-emphasis fw-semibold" id="modalDispDepositUsed">₹0.00</td>
                                    </tr>
                                    <tr class="border-top bg-surface-soft">
                                        <td class="fw-bold text-danger fs-6">Remaining Amount Due from Customer:</td>
                                        <td class="text-end fw-bold text-danger fs-5" id="modalDispRemainingDue">₹0.00</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-check-lg me-1"></i> Confirm Product Return & Settle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CANCEL RENTAL MODAL -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="POST" action="/rentals/cancel" id="cancelForm">
                <input type="hidden" name="id" id="cancelRentalId">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-danger" id="cancelModalLabel">
                        <i class="bi bi-x-circle me-2"></i>Cancel Rental Transaction
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <i class="bi bi-exclamation-triangle text-warning display-4 mb-3 d-block"></i>
                    <h6 class="fw-bold mb-2">Are you sure you want to cancel rental <span id="cancelRentalNo" class="text-primary"></span>?</h6>
                    <p class="text-muted small mb-3">Cancelling this rental will restore the product stock back to inventory and cancel the customer ledger transaction.</p>
                    <div class="text-start">
                        <label class="form-label small fw-semibold">Reason for Cancellation</label>
                        <input type="text" name="reason" class="form-control" placeholder="Customer cancelled, wrong order, etc." required>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Yes, Cancel Rental
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const returnModal = document.getElementById('returnModal');
    const returnDatetimeInput = document.getElementById('modalReturnDatetime');
    const additionalChargesInput = document.getElementById('modalAdditionalCharges');
    const depositDeductionInput = document.getElementById('modalDepositDeduction');
    const deductionReasonInput = document.getElementById('modalDeductionReason');

    function formatINR(val) {
        const num = parseFloat(val) || 0;
        return '₹' + num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function refreshReturnSettlement() {
        const rentalId = document.getElementById('returnRentalId').value;
        if (!rentalId) return;

        const actualReturn = returnDatetimeInput.value;
        const addCharges = additionalChargesInput.value || 0;
        const deductions = depositDeductionInput.value || 0;
        const reason = deductionReasonInput.value || '';

        fetch(`/rentals/ajax?action=calculate_return_settlement&rental_id=${rentalId}&actual_return=${encodeURIComponent(actualReturn)}&additional_charges=${encodeURIComponent(addCharges)}&deposit_deductions=${encodeURIComponent(deductions)}&deposit_deduction_reason=${encodeURIComponent(reason)}`)
            .then(res => res.json())
            .then(data => {
                if (data.success && data.settlement) {
                    const s = data.settlement;
                    document.getElementById('modalDispActualDuration').textContent = s.actualDurationText;
                    document.getElementById('modalDispOverdueDuration').textContent = s.overdueDurationText;
                    document.getElementById('modalDispOriginalAmount').textContent = formatINR(s.originalRentalAmount);
                    document.getElementById('modalDispOverdueAmount').textContent = formatINR(s.overdueAmount);
                    document.getElementById('modalDispTotalAmount').textContent = formatINR(s.totalRentalAmount);
                    document.getElementById('modalDispAdvance').textContent = formatINR(s.advanceRentalAmount);
                    document.getElementById('modalDispDeposit').textContent = formatINR(s.securityDeposit);
                    document.getElementById('modalDispDepositReturned').textContent = formatINR(s.depositReturnAmount);
                    document.getElementById('modalDispDepositUsed').textContent = formatINR(s.depositUsed);
                    document.getElementById('modalDispRemainingDue').textContent = formatINR(s.remainingAmountDue);
                }
            })
            .catch(err => console.error('Settlement fetch error:', err));
    }

    if (returnModal) {
        returnModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            if (!button) return;

            const id = button.getAttribute('data-rental-id');
            const rentalNo = button.getAttribute('data-rental-no');
            const customer = button.getAttribute('data-customer');
            const product = button.getAttribute('data-product');
            const advance = parseFloat(button.getAttribute('data-advance') || 0);
            const deposit = parseFloat(button.getAttribute('data-deposit') || 0);
            const checkin = button.getAttribute('data-checkin') || '-';
            const expected = button.getAttribute('data-expected') || '-';

            document.getElementById('returnRentalId').value = id;
            document.getElementById('modalRentalNo').textContent = rentalNo;
            document.getElementById('modalCustomer').textContent = customer;
            document.getElementById('modalProduct').textContent = product;
            document.getElementById('modalAdvance').textContent = formatINR(advance);
            document.getElementById('modalDeposit').textContent = formatINR(deposit);
            document.getElementById('modalDispStart').textContent = checkin;
            document.getElementById('modalDispExpected').textContent = expected;

            // Reset inputs
            additionalChargesInput.value = '0.00';
            depositDeductionInput.value = '0.00';
            deductionReasonInput.value = '';

            refreshReturnSettlement();
        });
    }

    if (returnDatetimeInput) {
        returnDatetimeInput.addEventListener('change', refreshReturnSettlement);
    }
    if (additionalChargesInput) {
        additionalChargesInput.addEventListener('input', refreshReturnSettlement);
    }
    if (depositDeductionInput) {
        depositDeductionInput.addEventListener('input', refreshReturnSettlement);
    }

    // Cancel Modal Population
    const cancelModal = document.getElementById('cancelModal');
    if (cancelModal) {
        cancelModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            if (!button) return;

            const id = button.getAttribute('data-rental-id');
            const rentalNo = button.getAttribute('data-rental-no');

            document.getElementById('cancelRentalId').value = id;
            document.getElementById('cancelRentalNo').textContent = rentalNo;
        });
    }
});
</script>

<%- include('includes/footer') %>
