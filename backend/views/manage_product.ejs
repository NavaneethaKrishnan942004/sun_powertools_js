<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: 'index.php' },
            { title: 'Settings', link: 'settings.php' },
            { title: 'DMS Masters', link: 'masters.php' },
            { title: 'Product Master' }
        ]) %>

        <!-- PAGE HEADING -->
        <div class="page-heading d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">
                    <i class="bi bi-box-seam text-primary me-2"></i>Product Master
                </h1>
                <p class="text-muted mb-0">Manage products catalog, specifications, sales pricing & rental rates.</p>
            </div>
            <a href="create_product.php" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create Product
            </a>
        </div>

        <!-- ALERTS -->
        <% if (locals.success) { %>
            <div class="alert alert-success alert-dismissible fade show auto-hide-alert d-flex align-items-center gap-2 shadow-sm mb-4">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="fw-medium"><%= success %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="fw-medium"><%= error %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- SEARCH + FILTER HEADER BOX -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3 p-md-4">
                <form method="GET" action="manage_product.php" id="filterForm">
                    <div class="row g-2 align-items-center">
                        <!-- Search Box -->
                        <div class="col">
                            <div class="manage-search-wrapper">
                                <i class="bi bi-search manage-search-icon"></i>
                                <input
                                    type="text"
                                    name="search"
                                    id="productSearch"
                                    class="form-control manage-search-input"
                                    placeholder="Search by Product ID, Name, or SKU..."
                                    value="<%= search %>"
                                    autocomplete="off"
                                >
                            </div>
                        </div>

                        <!-- Reset / Clear if filtered -->
                        <% if (search !== '' || statusFilter !== '' || categoryFilter !== '' || brandFilter !== '') { %>
                            <div class="col-auto">
                                <a href="manage_product.php" class="btn btn-outline-secondary" title="Reset Filters" style="height: 44px; display: inline-flex; align-items: center;">
                                    <i class="bi bi-x-lg me-1"></i> <span class="d-none d-sm-inline">Clear</span>
                                </a>
                            </div>
                        <% } %>

                        <!-- Filters Toggle Button -->
                        <div class="col-auto">
                            <button
                                type="button"
                                class="btn btn-outline-primary btn-filter-toggle"
                                data-bs-toggle="collapse"
                                data-bs-target="#filterSection"
                                aria-expanded="<%= (statusFilter !== '' || categoryFilter !== '' || brandFilter !== '') ? 'true' : 'false' %>"
                                aria-controls="filterSection"
                                id="filterToggleBtn"
                            >
                                <i class="bi bi-funnel"></i>
                                <span>Filters</span>
                                <i class="bi bi-chevron-down filter-chevron ms-1"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Expandable Filter Panel -->
                    <div class="collapse <%= (statusFilter !== '' || categoryFilter !== '' || brandFilter !== '') ? 'show' : '' %>" id="filterSection">
                        <div class="filter-panel-box">
                            <div class="row g-3">
                                <!-- STATUS -->
                                <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small fw-semibold text-muted">Status</label>
                                    <select name="status" class="form-select">
                                        <option value="">All Statuses</option>
                                        <option value="1" <%= statusFilter === '1' ? 'selected' : '' %>>Active</option>
                                        <option value="0" <%= statusFilter === '0' ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                </div>

                                <!-- CATEGORY -->
                                <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small fw-semibold text-muted">Category</label>
                                    <select name="category_id" class="form-select">
                                        <option value="">All Categories</option>
                                        <% categories.forEach(category => { %>
                                            <option value="<%= category.id %>" <%= String(categoryFilter) === String(category.id) ? 'selected' : '' %>>
                                                <%= category.category_code %> - <%= category.category_name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>

                                <!-- BRAND -->
                                <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small fw-semibold text-muted">Brand</label>
                                    <select name="brand_id" class="form-select">
                                        <option value="">All Brands</option>
                                        <% brands.forEach(brand => { %>
                                            <option value="<%= brand.id %>" <%= String(brandFilter) === String(brand.id) ? 'selected' : '' %>>
                                                <%= brand.brand_code %> - <%= brand.brand_name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div class="filter-actions">
                                <a href="manage_product.php" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                                </a>
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-check-lg me-1"></i> Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- PRODUCT TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="fw-bold mb-0 text-body">
                    <i class="bi bi-list-ul me-2 text-primary"></i>Products (<%= totalRecords %>)
                </h5>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Product ID</th>
                                <th>Product Name</th>
                                <th>Short Name</th>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Sale</th>
                                <th>Rental</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Created At</th>
                                <th>Updated By</th>
                                <th>Updated At</th>
                                <th class="action-column text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!products || products.length === 0) { %>
                                <tr>
                                    <td colspan="13" class="text-center py-5 text-muted">
                                        <div class="my-4">
                                            <i class="bi bi-box-seam display-4 text-muted d-block mb-3"></i>
                                            <h5 class="fw-semibold text-body">No Products Found</h5>
                                            <p class="text-muted mb-3">No products matched your search and filter criteria.</p>
                                            <% if (search || statusFilter || categoryFilter || brandFilter) { %>
                                                <a href="manage_product.php" class="btn btn-outline-secondary me-2">Clear Filters</a>
                                            <% } %>
                                            <a href="create_product.php" class="btn btn-primary">
                                                <i class="bi bi-plus-lg me-1"></i> Create Product
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% products.forEach(row => { %>
                                    <tr>
                                        <!-- PRODUCT ID -->
                                        <td class="ps-4 text-nowrap">
                                            <span class="status-dot <%= Number(row.status) === 1 ? 'active' : 'inactive' %>"></span>
                                            <strong><%= row.product_code %></strong>
                                        </td>

                                        <!-- NAME -->
                                        <td>
                                            <div class="fw-semibold text-body text-truncate" style="max-width: 260px;" title="<%= row.product_name %>">
                                                <a href="view_product.php?id=<%= row.id %>" class="text-decoration-none text-body">
                                                    <%= row.product_name %>
                                                </a>
                                            </div>
                                        </td>

                                        <!-- SHORT NAME -->
                                        <td class="text-nowrap"><%= row.short_name || '-' %></td>

                                        <!-- CATEGORY -->
                                        <td class="text-nowrap"><%= row.category_code %> - <%= row.category_name %></td>

                                        <!-- BRAND -->
                                        <td class="text-nowrap"><%= row.brand_code %> - <%= row.brand_name %></td>

                                        <!-- SALE -->
                                        <td>
                                            <% if (Number(row.sale_available) === 1) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Yes</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">No</span>
                                            <% } %>
                                        </td>

                                        <!-- RENTAL -->
                                        <td>
                                            <% if (Number(row.rental_available) === 1) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Yes</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">No</span>
                                            <% } %>
                                        </td>

                                        <!-- STATUS -->
                                        <td>
                                            <% if (Number(row.status) === 1) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                            <% } %>
                                        </td>

                                        <!-- CREATED BY -->
                                        <td class="text-nowrap"><%= row.created_by_name || row.created_by || '-' %></td>

                                        <!-- CREATED AT -->
                                        <td class="text-nowrap"><%= row.created_at ? String(row.created_at).slice(0, 19).replace('T', ' ') : '-' %></td>

                                        <!-- UPDATED BY -->
                                        <td class="text-nowrap"><%= row.updated_by_name || row.updated_by || '-' %></td>

                                        <!-- UPDATED AT -->
                                        <td class="text-nowrap"><%= row.updated_at ? String(row.updated_at).slice(0, 19).replace('T', ' ') : '-' %></td>

                                        <!-- ACTION -->
                                        <td class="action-column text-end pe-4 text-nowrap">
                                            <div class="btn-group btn-group-sm">
                                                <a href="view_product.php?id=<%= row.id %>" class="btn btn-outline-secondary" title="View">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="edit_product.php?id=<%= row.id %>" class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PAGINATION -->
            <%- renderPagination({ page, totalPages, totalRecords, limit, queryParams, baseUrl: 'manage_product.php' }) %>
        </div>

    </div>
</main>

<%- include('includes/footer') %>
