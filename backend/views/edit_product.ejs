<%- include('includes/header') %>

<main class="main-content">
<div class="container-fluid px-3 px-lg-4 py-4">

<!-- Breadcrumb Navigation -->
<%- renderBreadcrumbs([
    { title: '', icon: 'bi bi-house-door', link: '/' },
    { title: 'Product', link: '/products' },
    { title: 'Edit' }
]) %>

<div class="page-heading d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Edit Product</h1>
        <p class="text-muted mb-0">Update product information <%= product.product_code %>.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/products/view/<%= id %>" class="btn btn-outline-secondary">View</a>
        <a href="/products" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<% if (generalError) { %>
<div class="alert alert-danger">
    <%= generalError %>
</div>
<% } %>

<form method="POST" enctype="multipart/form-data">
<input type="hidden" name="id" value="<%= id %>">

<!-- BASIC INFORMATION -->
<div class="card shadow-sm mb-4">
<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="card-title mb-0">
        <h5 class="mb-0 fw-bold">
            Basic Information
        </h5>
    </div>
    <div class="card-header-actions">
        <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
            <input
                class="form-check-input"
                type="checkbox"
                name="status"
                id="editStatus"
                <%= Number(product.status) === 1 ? 'checked' : '' %>
            >
            <label class="form-check-label mb-0 fw-semibold" for="editStatus" id="editStatusLabel">
                <%= Number(product.status) === 1 ? 'Active' : 'Inactive' %>
            </label>
        </div>
    </div>
</div>

<div class="card-body">
<div class="row g-3">

<!-- PRODUCT ID -->


<!-- PRODUCT NAME -->
<div class="col-12">
    <label class="form-label">Product Name <span class="text-danger">*</span></label>
    <input
        type="text"
        name="product_name"
        class="form-control"
        value="<%= product.product_name %>"
        minlength="2"
        maxlength="200"
        required
    >
</div>

<!-- SHORT NAME -->
<div class="col-12 col-md-6">
    <label class="form-label">Short Name <span class="text-danger">*</span></label>
    <input
        type="text"
        name="short_name"
        class="form-control"
        value="<%= product.short_name %>"
        minlength="2"
        maxlength="100"
        required
    >
</div>

<!-- CATEGORY -->
<div class="col-12 col-md-6">
    <label class="form-label">Category <span class="text-danger">*</span></label>
    <select name="category_id" id="editCategoryId" class="form-select searchable-select" required>
        <option value="">Select Category</option>
        <% categories.forEach(category => { %>
        <option
            value="<%= category.id %>"
            <%= Number(product.category_id) === Number(category.id) ? 'selected' : '' %>
        >
            <%= category.category_code %> - <%= category.category_name %>
        </option>
        <% }) %>
    </select>
</div>

<!-- BRAND -->
<div class="col-12 col-md-6">
    <label class="form-label">Brand <span class="text-danger">*</span></label>
    <select name="brand_id" id="editBrandId" class="form-select searchable-select" required>
        <option value="">Select Brand</option>
        <% brands.forEach(brand => { %>
        <option
            value="<%= brand.id %>"
            <%= Number(product.brand_id) === Number(brand.id) ? 'selected' : '' %>
        >
            <%= brand.brand_code %> - <%= brand.brand_name %>
        </option>
        <% }) %>
    </select>
</div>

<!-- PRODUCT TYPE (STATIC DROPDOWN: SALES / RENTAL) -->
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold">Product Type <span class="text-danger">*</span></label>
    <select name="product_type" id="editProductType" class="form-select searchable-select" required>
        <option value="Sales" <%= product.product_type === 'Sales' ? 'selected' : '' %>>Sales</option>
        <option value="Rental" <%= product.product_type === 'Rental' ? 'selected' : '' %>>Rental</option>
    </select>
    <small class="text-muted d-block mt-1">Designates whether this product is available for Sales or Rental.</small>
</div>

<!-- RELATIONSHIP / HISTORICAL NOTICE -->
<div id="typeChangeNotice" class="col-12" style="display:none">
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-0 shadow-sm border border-warning-subtle">
        <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
        <div>
            <strong>Notice:</strong> Changing Product Type may affect where this product is available. Existing transactions will not be changed.
        </div>
    </div>
</div>

<!-- EXISTING IMAGES -->
<div class="col-12">
    <label class="form-label">Existing Product Images</label>
    <div class="row g-3">
        <% if (images.length === 0) { %>
        <div class="col-12 text-muted">No images available.</div>
        <% } else { %>
        <% images.forEach(image => { %>
        <div class="col-6 col-md-3">
            <div class="border rounded p-2">
                <img
                    src="<%= image.image_path %>"
                    class="img-fluid rounded existing-image-thumb"
                    data-previewable
                    alt="Product Image"
                    title="Click to view full preview"
                    style="height:150px;width:100%;object-fit:cover;cursor:pointer;"
                >
                <% if (Number(image.is_primary) === 1) { %>
                <span class="badge bg-primary mt-2">Primary</span>
                <% } %>
            </div>
        </div>
        <% }) %>
        <% } %>
    </div>
</div>

<!-- ADD IMAGES -->
<div class="col-12">
    <label class="form-label">Add Product Images</label>
    <input
        type="file"
        name="product_images"
        class="form-control"
        accept="image/jpeg,image/png,image/gif,image/webp"
        multiple
    >
    <small class="text-muted">Upload additional JPG, JPEG, PNG, GIF or WEBP images.</small>
</div>

<!-- DESCRIPTION -->
<div class="col-12">
    <label class="form-label">Description</label>
    <textarea name="description" class="form-control" rows="4" maxlength="2000"><%= product.description || '' %></textarea>
</div>

</div>
</div>
</div>

<!-- SALES -->
<div class="card shadow-sm mb-4" id="editSalesSectionCard" style="display: <%= product.product_type === 'Sales' ? 'block' : 'none' %>;">
<div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-tag me-2"></i>Sales Information</h5>
    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">Sales Specific</span>
</div>
<div class="card-body">
<div class="row g-3">

<input type="hidden" name="sale_available" id="editSaleAvailable" value="<%= product.product_type === 'Sales' ? 'yes' : 'no' %>">

<div class="col-12 col-md-4">
    <label class="form-label">Purchase Price (₹)</label>
    <div class="input-group">
        <span class="input-group-text">₹</span>
        <input
            type="number"
            name="purchase_price"
            class="form-control"
            step="0.01"
            min="0"
            value="<%= product.purchase_price !== null ? product.purchase_price : '' %>"
        >
    </div>
</div>

<div class="col-12 col-md-4">
    <label class="form-label">
        Selling Price (₹) <span class="text-danger edit-sale-required">*</span>
    </label>
    <div class="input-group">
        <span class="input-group-text">₹</span>
        <input
            type="number"
            name="selling_price"
            id="editSellingPrice"
            class="form-control"
            step="0.01"
            min="0"
            value="<%= product.selling_price !== null ? product.selling_price : '' %>"
        >
    </div>
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Discount Allowed</label>
    <select name="discount_allowed" id="editDiscountAllowed" class="form-select">
        <option value="yes" <%= Number(product.discount_allowed) === 1 ? 'selected' : '' %>>Yes</option>
        <option value="no" <%= Number(product.discount_allowed) === 0 ? 'selected' : '' %>>No</option>
    </select>
</div>

<div
    class="col-12 col-md-4"
    id="editDiscountWrapper"
    style="<%= Number(product.discount_allowed) === 1 ? '' : 'display:none' %>"
>
    <label class="form-label">Discount %</label>
    <div class="input-group">
        <input
            type="number"
            name="discount_percent"
            class="form-control"
            step="0.01"
            min="0"
            max="100"
            value="<%= product.discount_percent !== null ? product.discount_percent : '' %>"
        >
        <span class="input-group-text">%</span>
    </div>
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Unit of Sale</label>
    <input
        type="number"
        name="sale_unit"
        class="form-control"
        step="any"
        min="0"
        value="<%= product.sale_unit !== null ? product.sale_unit : '' %>"
    >
</div>

</div>
</div>
</div>

<!-- RENTAL -->
<div class="card shadow-sm mb-4" id="editRentalSectionCard" style="display: <%= product.product_type === 'Rental' ? 'block' : 'none' %>;">
<div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-clock-history me-2"></i>Rental Rates & Durations</h5>
    <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold">Rental Specific</span>
</div>
<div class="card-body">

<input type="hidden" name="rental_available" id="editRentalAvailable" value="<%= product.product_type === 'Rental' ? 'yes' : 'no' %>">

<div
    id="editRentalSection"
    class="mt-4"
    style="<%= Number(product.rental_available) === 1 ? '' : 'display:none' %>"
>
    <ul class="nav nav-tabs">
        <% const periods = { hourly: 'Hourly', daily: 'Daily', weekly: 'Weekly', monthly: 'Monthly' }; %>
        <% let first = true; %>
        <% for (const [key, label] of Object.entries(periods)) { %>
        <li class="nav-item">
            <button
                type="button"
                class="nav-link <%= first ? 'active' : '' %>"
                data-bs-toggle="tab"
                data-bs-target="#edit<%= key.charAt(0).toUpperCase() + key.slice(1) %>Tab"
            >
                <%= label %>
            </button>
        </li>
        <% first = false; %>
        <% } %>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        <% first = true; %>
        <% for (const [key, label] of Object.entries(periods)) { %>
        <% const rate = rentalRates[key] || null; %>
        <div
            class="tab-pane fade <%= first ? 'show active' : '' %>"
            id="edit<%= key.charAt(0).toUpperCase() + key.slice(1) %>Tab"
        >
            <div class="form-check form-switch mb-3">
                <input
                    class="form-check-input edit-rental-checkbox"
                    type="checkbox"
                    name="rental_available_period[<%= key %>]"
                    data-period="<%= key %>"
                    id="editAvailable<%= key.charAt(0).toUpperCase() + key.slice(1) %>"
                    <%= rate && Number(rate.available) === 1 ? 'checked' : '' %>
                >
                <label class="form-check-label" for="editAvailable<%= key.charAt(0).toUpperCase() + key.slice(1) %>">
                    Available
                </label>
            </div>

            <div
                class="edit-rental-fields"
                id="editRentalFields<%= key.charAt(0).toUpperCase() + key.slice(1) %>"
                style="<%= rate && Number(rate.available) === 1 ? '' : 'display:none' %>"
            >
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Rental Unit <span class="text-danger">*</span></label>
                        <select name="rental_unit_id[<%= key %>]" class="form-select searchable-select edit-rental-required">
                            <option value="">Select Unit</option>
                            <% units.forEach(unit => { %>
                            <option
                                value="<%= unit.id %>"
                                <%= rate && Number(rate.rental_unit_id) === Number(unit.id) ? 'selected' : '' %>
                            >
                                <%= unit.unit_code %> - <%= unit.unit_name %>
                            </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Security Deposit <span class="text-danger">*</span></label>
                        <input
                            type="number"
                            name="security_deposit[<%= key %>]"
                            class="form-control edit-rental-required"
                            step="0.01"
                            min="0"
                            placeholder="0.00"
                            value="<%= rate && rate.security_deposit !== null ? rate.security_deposit : '' %>"
                        >
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Rental Rate <span class="text-danger">*</span></label>
                        <input
                            type="number"
                            name="rental_rate[<%= key %>]"
                            class="form-control edit-rental-required"
                            step="0.01"
                            min="0"
                            placeholder="0.00"
                            value="<%= rate && rate.rental_rate !== null ? rate.rental_rate : '' %>"
                        >
                    </div>
                </div>
            </div>
        </div>
        <% first = false; %>
        <% } %>
    </div>
</div>

</div>
</div>

<!-- SPECIFICATIONS -->
<div class="card shadow-sm mb-4">
<div class="card-header">
    <h5 class="mb-0">Specifications</h5>
</div>
<div class="card-body">
<div class="row g-3">

<div class="col-12 col-md-4">
    <label class="form-label">Power Rating</label>
    <input type="text" name="power_rating" class="form-control" value="<%= product.power_rating || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Voltage</label>
    <input type="text" name="voltage" class="form-control" value="<%= product.voltage || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">RPM</label>
    <input type="text" name="rpm" class="form-control" value="<%= product.rpm || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Chuck / Disc Size</label>
    <input type="text" name="chuck_disc_size" class="form-control" value="<%= product.chuck_disc_size || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Weight</label>
    <input type="text" name="weight" class="form-control" value="<%= product.weight || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Battery Capacity</label>
    <input type="text" name="battery_capacity" class="form-control" value="<%= product.battery_capacity || '' %>">
</div>

<div class="col-12">
    <label class="form-label">Warranty Period</label>
    <input type="text" name="warranty_period" class="form-control" value="<%= product.warranty_period || '' %>">
</div>

</div>
</div>
</div>

<!-- WARRANTY -->
<div class="card shadow-sm mb-4">
<div class="card-header">
    <h5 class="mb-0">Warranty & Maintenance</h5>
</div>
<div class="card-body">
<div class="row g-3">

<div class="col-12 col-md-4">
    <label class="form-label">Warranty Applicable</label>
    <select name="warranty_applicable" id="editWarrantyApplicable" class="form-select">
        <option value="yes" <%= Number(product.warranty_applicable) === 1 ? 'selected' : '' %>>Yes</option>
        <option value="no" <%= Number(product.warranty_applicable) === 0 ? 'selected' : '' %>>No</option>
    </select>
</div>

<div
    class="col-12 col-md-4"
    id="editWarrantyWrapper"
    style="<%= Number(product.warranty_applicable) === 1 ? '' : 'display:none' %>"
>
    <label class="form-label">Warranty Period</label>
    <div class="input-group">
        <input
            type="number"
            name="warranty_months"
            class="form-control"
            min="0"
            step="1"
            value="<%= product.warranty_months !== null ? product.warranty_months : '' %>"
        >
        <span class="input-group-text">Month</span>
    </div>
</div>

</div>
</div>
</div>

<!-- BUTTONS -->
<div class="d-flex justify-content-end gap-2 mb-4">
    <a href="/products" class="btn btn-outline-secondary">Back</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i> Update
    </button>
</div>

</form>

</div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const status = document.getElementById('editStatus');
    const statusLabel = document.getElementById('editStatusLabel');
    if (status && statusLabel) {
        status.addEventListener('change', function () {
            statusLabel.textContent = this.checked ? 'Active' : 'Inactive';
        });
    }

    const editProductType = document.getElementById('editProductType');
    const editSalesSectionCard = document.getElementById('editSalesSectionCard');
    const editRentalSectionCard = document.getElementById('editRentalSectionCard');
    const editSaleAvailable = document.getElementById('editSaleAvailable');
    const editRentalAvailable = document.getElementById('editRentalAvailable');
    const editSellingPrice = document.getElementById('editSellingPrice');
    const editSaleRequired = document.querySelector('.edit-sale-required');
    const typeChangeNotice = document.getElementById('typeChangeNotice');
    const initialProductType = editProductType ? editProductType.value : '';

    function handleEditProductTypeChange() {
        const type = editProductType ? editProductType.value : '';

        // Show warning notice if product type changed from original
        if (typeChangeNotice) {
            typeChangeNotice.style.display = (type !== initialProductType) ? 'block' : 'none';
        }

        if (type === 'Sales') {
            if (editSalesSectionCard) editSalesSectionCard.style.display = 'block';
            if (editRentalSectionCard) editRentalSectionCard.style.display = 'none';
            if (editSaleAvailable) editSaleAvailable.value = 'yes';
            if (editRentalAvailable) editRentalAvailable.value = 'no';
            if (editSellingPrice) {
                editSellingPrice.required = true;
                if (editSaleRequired) editSaleRequired.style.display = 'inline';
            }
            document.querySelectorAll('.edit-rental-required').forEach(function (input) {
                input.required = false;
            });
        } else if (type === 'Rental') {
            if (editSalesSectionCard) editSalesSectionCard.style.display = 'none';
            if (editRentalSectionCard) {
                editRentalSectionCard.style.display = 'block';
                const rentalSec = document.getElementById('editRentalSection');
                if (rentalSec) rentalSec.style.display = 'block';
            }
            if (editSaleAvailable) editSaleAvailable.value = 'no';
            if (editRentalAvailable) editRentalAvailable.value = 'yes';
            if (editSellingPrice) {
                editSellingPrice.required = false;
                if (editSaleRequired) editSaleRequired.style.display = 'none';
            }
            document.querySelectorAll('.edit-rental-checkbox').forEach(function (checkbox) {
                const period = checkbox.dataset.period;
                const fields = document.getElementById('editRentalFields' + period.charAt(0).toUpperCase() + period.slice(1));
                if (fields && checkbox.checked) {
                    fields.querySelectorAll('.edit-rental-required').forEach(function (input) {
                        input.required = true;
                    });
                }
            });
        }
    }

    if (editProductType) {
        editProductType.addEventListener('change', handleEditProductTypeChange);
        handleEditProductTypeChange();
    }

    const discount = document.getElementById('editDiscountAllowed');
    const discountWrapper = document.getElementById('editDiscountWrapper');
    if (discount && discountWrapper) {
        discount.addEventListener('change', function () {
            discountWrapper.style.display = this.value === 'yes' ? 'block' : 'none';
        });
    }

    document.querySelectorAll('.edit-rental-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            const period = this.dataset.period;
            const fields = document.getElementById('editRentalFields' + period.charAt(0).toUpperCase() + period.slice(1));
            if (fields) {
                fields.style.display = this.checked ? 'block' : 'none';
                if (editProductType && editProductType.value === 'Rental') {
                    fields.querySelectorAll('.edit-rental-required').forEach(function (input) {
                        input.required = checkbox.checked;
                    });
                }
            }
        });
    });

    const warranty = document.getElementById('editWarrantyApplicable');
    const warrantyWrapper = document.getElementById('editWarrantyWrapper');
    if (warranty && warrantyWrapper) {
        warranty.addEventListener('change', function () {
            warrantyWrapper.style.display = this.value === 'yes' ? 'block' : 'none';
        });
    }

    if (window.SearchableSelect) {
        window.SearchableSelect.init('.searchable-select');
    }
});
</script>

<%- include('includes/footer') %>
