<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: '/' },
            { title: 'Master', link: '/masters' },
            { title: 'Product Type Master', link: '/product-types' },
            { title: 'View' }
        ]) %>

        <!-- Page Heading -->
        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-1">View Product Type</h1>
                <p class="text-muted mb-0">View product type details.</p>
            </div>
        </div>

        <% if (!productType) { %>
            <div class="alert alert-danger">Product Type not found.</div>
            <a href="/product-types" class="btn btn-secondary">Back</a>
        <% } else { %>
            <!-- Product Type Details -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="card-title mb-0">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-diagram-3 me-2 text-primary"></i>Product Type Details</h5>
                    </div>
                    <div class="card-header-actions">
                        <div class="d-flex gap-2">
                            <a href="/product-types" class="btn btn-outline-secondary">Back</a>
                            <a href="/product-types?edit=<%= productType.id %>" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row g-4">
                        <!-- Product Type Code -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Product Type ID : <%= e(productType.product_type_code) %>
                            </label>
                        </div>

                        <!-- Status -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Status : <% if (parseInt(productType.status) === 1) { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Inactive</span>
                                <% } %>
                            </label>
                        </div>

                        <!-- Product Type Name -->
                        <div class="col-6">
                            <label class="form-label text-muted">
                                Product Type Name : <%= e(productType.product_type_name) %>
                            </label>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label text-muted">
                                Description : <% if (productType.description) { %>
                                    <%- nl2br(productType.description) %>
                                <% } else { %>
                                    <span class="text-muted">-</span>
                                <% } %>
                            </label>
                        </div>

                        <!-- Created By -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Created By : <%= e(productType.created_by_name || productType.created_by || '-') %>
                            </label>
                        </div>

                        <!-- Created At -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Created At : <%= e(productType.created_at) %>
                            </label>
                        </div>

                        <!-- Updated By -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Updated By : <%= e(productType.updated_by_name || productType.updated_by || '-') %>
                            </label>
                        </div>

                        <!-- Updated At -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Updated At : <%= productType.updated_at ? e(productType.updated_at) : '-' %>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

    </div>
</main>

<%- include('includes/footer') %>
