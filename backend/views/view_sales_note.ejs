<%- include('includes/header') %>

<style>
@media print {
    body {
        background: #ffffff !important;
        color: #000000 !important;
        font-size: 13px !important;
    }
    .admin-navbar, .admin-sidebar, .sidebar-backdrop, .admin-breadcrumb-nav, .page-heading, .no-print, .footer {
        display: none !important;
    }
    .admin-main {
        margin-left: 0 !important;
        padding: 0 !important;
        width: 100% !important;
    }
    .container-fluid {
        padding: 0 !important;
        max-width: 100% !important;
    }
    .card {
        border: 1px solid #ddd !important;
        box-shadow: none !important;
        border-radius: 0 !important;
    }
    .print-invoice-card {
        border: none !important;
    }
    .badge {
        border: 1px solid #000 !important;
        color: #000 !important;
        background: transparent !important;
    }
    a {
        text-decoration: none !important;
        color: #000 !important;
    }
}
</style>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <div class="no-print">
            <%- renderBreadcrumbs([
                { title: '', icon: 'bi bi-house-door', link: '/' },
                { title: 'Sales Notes', link: '/sales-notes' },
                { title: sale.sales_note_no }
            ]) %>
        </div>

        <!-- PAGE TITLE & ACTIONS -->
        <div class="page-heading d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 no-print">
            <div>
                <h1 class="page-title mb-1">
                    <i class="bi bi-receipt-cutoff text-primary me-2"></i>Sales Note: <%= sale.sales_note_no %>
                </h1>
                <p class="text-muted mb-0">Generated on <%= new Date(sale.sales_date + 'T' + sale.sales_time).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }) %></p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Sales Note
                </button>
                <% const isCreditSale = (saleTypeInfo.type === 'credit') || (String(sale.sale_type).toLowerCase() === 'credit') || (Number(sale.credit_amount) > 0.001); %>
                <% const balAmt = (paymentStatusInfo.balance !== undefined) ? Number(paymentStatusInfo.balance) : Math.max(0, Number(sale.total_amount) - Number(sale.paid_amount)); %>
                <% if (Number(sale.status) === 1) { %>
                    <a href="/sales-notes/edit/<%= sale.id %>" class="btn btn-outline-warning">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <% if (isCreditSale && balAmt > 0.001) { %>
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#receivePaymentModal">
                            <i class="bi bi-cash-coin me-1"></i> Pay Credit Balance
                        </button>
                    <% } %>
                <% } %>
                <a href="/sales-notes" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>

        <!-- SUCCESS ALERT -->
        <% if (locals.success) { %>
            <div class="alert alert-success alert-dismissible fade show auto-hide-alert d-flex align-items-center gap-2 shadow-sm mb-4 no-print" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="fw-medium"><%= success %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- ERROR ALERT -->
        <% if (locals.error) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4 no-print" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="fw-medium"><%= error %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (Number(sale.status) === 0) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                <div>
                    <strong>This Sales Note is CANCELLED.</strong> Product stock and customer ledger were reverted.
                </div>
            </div>
        <% } %>

        <!-- INVOICE CARD CONTAINER -->
        <div class="card border-0 shadow-sm rounded-4 print-invoice-card p-4 p-lg-5 mb-4 bg-surface">

            <!-- HEADER / STORE INFO -->
            <div class="row align-items-start pb-4 mb-4 border-bottom g-3">
                <div class="col-12 col-sm-7">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                            <i class="bi bi-tools fs-5"></i>
                        </div>
                        <h3 class="fw-bold text-primary mb-0">Sun PowerTools</h3>
                    </div>
                    <p class="text-muted small mb-1">Heavy Machinery & Power Tools Sales, Spares and Service</p>
                    <p class="text-muted small mb-0">Coimbatore, Tamil Nadu, India &bull; Phone: +91 93459 88594</p>
                </div>
                <div class="col-12 col-sm-5 text-sm-end">
                    <h4 class="fw-bold text-body mb-1">SALES NOTE</h4>
                    <div class="text-primary fw-bold fs-5"><%= sale.sales_note_no %></div>
                    <div class="text-muted small">Date: <%= new Date(sale.sales_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></div>
                    <div class="text-muted small">Time: <%= sale.sales_time %></div>
                    <div class="mt-2 d-flex flex-wrap gap-1 justify-content-sm-end">
                        <%- saleTypeInfo.badge_html %>
                        <%- paymentStatusInfo.badge_html %>
                        <%- getPaymentTypeBadge(sale.payment_type) %>
                        <span class="badge <%= evalCredit.badge_class %>"><%= sale.credit_status %></span>
                        <% if (sale.credit_override) { %>
                            <span class="badge bg-danger text-white" title="Manager Override Applied">Override</span>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- CUSTOMER & INVOICE DETAILS -->
            <div class="row g-4 pb-4 mb-4 border-bottom">
                <!-- Customer Details -->
                <div class="col-12 col-md-6">
                    <h6 class="fw-bold text-muted text-uppercase small mb-2">Customer Details:</h6>
                    <h5 class="fw-bold text-body mb-1">
                        <%= sale.customer_name || 'Walk-in / Retail Customer' %>
                        <% if (sale.company_name) { %>
                            <span class="text-muted fs-6 fw-normal">(<%= sale.company_name %>)</span>
                        <% } %>
                    </h5>
                    <% if (sale.customer_id) { %>
                    <div class="small text-muted mb-1">
                        <span class="badge bg-light text-dark border me-1"><%= sale.customer_code %></span>
                        <i class="bi bi-telephone me-1"></i><%= sale.mobile_number %>
                        <% if (sale.email) { %>
                            &bull; <i class="bi bi-envelope me-1"></i><%= sale.email %>
                        <% } %>
                    </div>
                    <% if (sale.gst_number) { %>
                        <div class="small text-muted mb-1">GSTIN: <strong><%= sale.gst_number %></strong></div>
                    <% } %>
                    <div class="small text-muted">
                        <i class="bi bi-geo-alt me-1"></i>
                        <%= [sale.address, sale.area, sale.city, sale.state, sale.pincode].filter(Boolean).join(', ') || 'N/A' %>
                    </div>
                    <% } else { %>
                    <div class="text-muted small mt-1">
                        <i class="bi bi-person-check me-1"></i>Direct over-the-counter sale (Walk-in customer)
                    </div>
                    <% } %>
                </div>

                <!-- Credit & Audit Info -->
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-surface-soft rounded-3 border small">
                        <h6 class="fw-bold text-primary mb-2"><i class="bi bi-credit-card-2-front me-1"></i> Customer Financial & Credit Ledger</h6>
                        <% if (sale.customer_id) { %>
                        <div class="row g-2 text-center">
                            <div class="col-6 col-sm-3">
                                <span class="text-muted d-block small">Credit Limit</span>
                                <strong class="text-body">₹<%= numberFormat(sale.credit_limit, 2) %></strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted d-block small">Prev Outstanding</span>
                                <strong class="text-danger">₹<%= numberFormat(sale.previous_outstanding, 2) %></strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted d-block small">Credit Applied</span>
                                <strong class="text-danger">₹<%= numberFormat(sale.credit_amount, 2) %></strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted d-block small">New Outstanding</span>
                                <strong class="text-primary fw-bold">₹<%= numberFormat(sale.new_outstanding, 2) %></strong>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top text-muted">
                            <span>Remaining Avail Credit: <strong class="text-success">₹<%= numberFormat(Math.max(0.00, Number(sale.credit_limit) - Number(sale.new_outstanding)), 2) %></strong></span>
                            <span>Payment Terms: <strong><%= sale.payment_terms || 'Immediate' %></strong></span>
                        </div>
                        <% } else { %>
                        <div class="text-muted py-2">
                            <i class="bi bi-check2-circle text-success me-1"></i>No customer credit account needed for walk-in retail transactions.
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- PRODUCT ITEMS TABLE -->
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 5%;">#</th>
                            <th style="width: 35%;">Product Description</th>
                            <th class="text-center" style="width: 10%;">Unit</th>
                            <th class="text-center" style="width: 10%;">Qty</th>
                            <th class="text-end" style="width: 12%;">Rate (₹)</th>
                            <th class="text-end" style="width: 10%;">Disc (₹)</th>
                            <th class="text-center" style="width: 8%;">Tax %</th>
                            <th class="text-end" style="width: 10%;">Amount (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (items && items.length > 0) { %>
                            <% items.forEach((it, idx) => { %>
                                <tr>
                                    <td class="text-center text-muted"><%= idx + 1 %></td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary me-1"><%= it.product_code %></span>
                                        <strong class="text-body"><%= it.product_name %></strong>
                                        <% if (it.brand_name) { %>
                                            <div class="small text-muted"><%= it.brand_name %> &bull; <%= it.category_name || '' %></div>
                                        <% } %>
                                    </td>
                                    <td class="text-center text-muted"><%= it.unit_name || 'Qty' %></td>
                                    <td class="text-center fw-bold"><%= numberFormat(it.quantity) %></td>
                                    <td class="text-end">₹<%= numberFormat(it.unit_price, 2) %></td>
                                    <td class="text-end text-success">
                                        <%= Number(it.discount) > 0 ? '-₹' + numberFormat(it.discount, 2) : '—' %>
                                    </td>
                                    <td class="text-center text-muted">
                                        <%= Number(it.tax_percent) > 0 ? numberFormat(it.tax_percent) + '%' : '0%' %>
                                    </td>
                                    <td class="text-end fw-bold text-body">
                                        ₹<%= numberFormat(it.line_total, 2) %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="8" class="text-center py-3 text-muted">No items found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- PAYMENT SUMMARY & AUDIT -->
            <div class="row g-4">
                <!-- Left: Notes & Audit Trails -->
                <div class="col-12 col-md-6">
                    <% if (sale.notes) { %>
                        <div class="p-3 bg-surface-soft rounded-3 border mb-3">
                            <h6 class="fw-bold small text-muted text-uppercase mb-1">Notes / Remarks:</h6>
                            <p class="small text-body mb-0"><%- nl2br(e(sale.notes)) %></p>
                        </div>
                    <% } %>

                    <div class="small text-muted">
                        <div>Created By: <strong><%= sale.created_by_name || 'Admin' %></strong> on <%= sale.created_at ? new Date(sale.created_at).toLocaleString('en-GB') : '' %></div>
                        <% if (sale.updated_at) { %>
                            <div>Updated By: <strong><%= sale.updated_by_name || 'Admin' %></strong> on <%= new Date(sale.updated_at).toLocaleString('en-GB') %></div>
                        <% } %>
                    </div>
                </div>

                <!-- Right: Financial Grand Totals -->
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-surface-soft rounded-3 border">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal:</span>
                            <span class="fw-bold text-body">₹<%= numberFormat(sale.subtotal, 2) %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Discount:</span>
                            <span class="text-success fw-semibold">- ₹<%= numberFormat(sale.discount, 2) %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tax / GST:</span>
                            <span class="text-body fw-semibold">+ ₹<%= numberFormat(sale.tax, 2) %></span>
                        </div>
                        <% if (Number(sale.other_charges) > 0) { %>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Other Charges:</span>
                                <span class="text-body fw-semibold">+ ₹<%= numberFormat(sale.other_charges, 2) %></span>
                            </div>
                        <% } %>
                        <% const roundOffVal = (sale.round_off !== undefined && sale.round_off !== null) ? Number(sale.round_off) : 0; %>
                        <% if (Math.abs(roundOffVal) > 0.001) { %>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Round Off:</span>
                                <span class="text-body fw-semibold"><%= roundOffVal > 0 ? '+ ₹' + numberFormat(roundOffVal, 2) : '- ₹' + numberFormat(Math.abs(roundOffVal), 2) %></span>
                            </div>
                        <% } %>

                        <hr class="my-2">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-5 fw-bold text-body">Grand Total:</span>
                            <span class="fs-4 fw-extrabold text-primary">₹<%= numberFormat(sale.total_amount, 2) %></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <span class="text-muted small">Sale Type:</span>
                            <%- saleTypeInfo.badge_html %>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <span class="text-muted small">Payment Status:</span>
                            <%- paymentStatusInfo.badge_html %>
                        </div>

                        <% if (isCreditSale) { %>
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">Original Sale Total:</span>
                                <strong class="text-body">₹<%= numberFormat(sale.total_amount, 2) %></strong>
                            </div>
                            <% if (typeof allPayments !== 'undefined' && allPayments && allPayments.length > 0) { %>
                                <% allPayments.forEach(pmt => { %>
                                    <div class="d-flex justify-content-between mb-1 small">
                                        <span class="text-success fw-semibold"><%= pmt.payment_label %>:</span>
                                        <strong class="text-success">
                                            ₹<%= numberFormat(pmt.amount, 2) %>
                                            <small class="text-muted fw-normal">(<%= pmt.payment_method %>)</small>
                                        </strong>
                                    </div>
                                <% }) %>
                            <% } else if (Number(sale.paid_amount) > 0.001) { %>
                                <div class="d-flex justify-content-between mb-1 small">
                                    <span class="text-success fw-semibold">Payment 1:</span>
                                    <strong class="text-success">₹<%= numberFormat(sale.paid_amount, 2) %></strong>
                                </div>
                            <% } else { %>
                                <div class="d-flex justify-content-between mb-1 small">
                                    <span class="text-muted">Payments Received:</span>
                                    <strong class="text-muted">₹0.00</strong>
                                </div>
                            <% } %>
                            <div class="d-flex justify-content-between mb-1 small border-top pt-1">
                                <span class="text-primary fw-bold">Total Paid:</span>
                                <strong class="text-primary fw-bold">₹<%= numberFormat(sale.paid_amount, 2) %></strong>
                            </div>
                            <div class="d-flex justify-content-between small pt-1 border-top">
                                <span class="text-danger fw-bold">Remaining Credit:</span>
                                <strong class="<%= balAmt > 0.001 ? 'text-danger fw-bold fs-6' : 'text-success fw-bold' %>">
                                    ₹<%= numberFormat(balAmt, 2) %>
                                </strong>
                            </div>
                        <% } else { %>
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-success fw-semibold">Amount Paid:</span>
                                <strong class="text-success">₹<%= numberFormat(sale.paid_amount, 2) %></strong>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-danger fw-semibold">Balance to Pay:</span>
                                <strong class="<%= Number(paymentStatusInfo.balance) > 0.001 ? 'text-danger fw-bold' : 'text-muted' %>">
                                    ₹<%= numberFormat(paymentStatusInfo.balance, 2) %>
                                </strong>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- CREDIT PAYMENT HISTORY TABLE -->
            <% if (isCreditSale && typeof allPayments !== 'undefined' && allPayments && allPayments.length > 0) { %>
                <div class="mt-4 p-3 bg-surface-soft rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-primary mb-0">
                            <i class="bi bi-clock-history me-1"></i> Credit Payment History
                        </h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                            <%= allPayments.length %> Payment<%= allPayments.length !== 1 ? 's' : '' %> | Total Paid: ₹<%= numberFormat(sale.paid_amount, 2) %>
                        </span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered bg-surface mb-0 align-middle">
                            <thead class="table-light small">
                                <tr>
                                    <th style="width: 14%;">Payment</th>
                                    <th style="width: 22%;">Date & Time</th>
                                    <th style="width: 16%;">Payment Method</th>
                                    <th class="text-end" style="width: 18%;">Amount Paid</th>
                                    <th class="text-center" style="width: 10%;">Status</th>
                                    <th style="width: 20%;">Notes / Remarks</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <% allPayments.forEach((pmt) => { %>
                                    <tr>
                                        <td>
                                            <span class="badge <%= pmt.is_initial ? 'bg-primary text-white' : 'bg-info-subtle text-info border border-info-subtle' %> fw-bold">
                                                <%= pmt.payment_label %>
                                            </span>
                                        </td>
                                        <td><%= pmt.transaction_date ? new Date(pmt.transaction_date).toLocaleString('en-GB') : '-' %></td>
                                        <td><span class="badge bg-light text-dark border"><%= pmt.payment_method || 'Cash' %></span></td>
                                        <td class="text-end fw-bold text-success">₹<%= numberFormat(pmt.amount, 2) %></td>
                                        <td class="text-center"><span class="badge bg-success-subtle text-success border border-success-subtle">Paid</span></td>
                                        <td class="text-muted"><%= pmt.notes || (pmt.is_initial ? 'Initial payment at sale creation' : `Credit payment #${pmt.payment_number}`) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>

            <!-- INVOICE FOOTER NOTE -->
            <div class="mt-4 pt-3 border-top text-center text-muted small">
                <span>Thank you for choosing <strong>Sun PowerTools</strong>! Goods once sold can be serviced as per warranty terms.</span>
            </div>

        </div>

    </div>
</main>

<!-- RECEIVE PAYMENT MODAL -->
<% if (isCreditSale && balAmt > 0.001 && Number(sale.status) === 1) { %>
<div class="modal fade no-print" id="receivePaymentModal" tabindex="-1" aria-labelledby="receivePaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <form method="POST" action="/sales-notes/receive-payment" id="receivePaymentForm">
                <input type="hidden" name="sales_note_id" value="<%= sale.id %>">
                <div class="modal-header bg-surface py-3 px-4 border-bottom">
                    <div>
                        <h5 class="modal-title fw-bold text-success mb-0" id="receivePaymentModalLabel">
                            <i class="bi bi-cash-coin me-2"></i>Receive Payment (Payment <%= (typeof allPayments !== 'undefined' && allPayments && allPayments.length > 0) ? (allPayments.length + 1) : 2 %>)
                        </h5>
                        <small class="text-muted"><%= sale.sales_note_no %> &bull; <%= sale.customer_name || 'Walk-in Customer' %></small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Summary Card -->
                    <div class="p-3 bg-surface-soft rounded-3 border mb-3">
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <small class="text-muted d-block">Total Sales</small>
                                <strong class="fs-6 text-body">₹<%= numberFormat(sale.total_amount, 2) %></strong>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Already Paid</small>
                                <strong class="fs-6 text-success">₹<%= numberFormat(sale.paid_amount, 2) %></strong>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Current Balance</small>
                                <strong class="fs-6 text-danger fw-bold" id="viewModalDispBalance">₹<%= numberFormat(balAmt, 2) %></strong>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Amount Input -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold text-primary mb-0" for="viewModalPaymentAmount">
                                Payment Amount to Receive (₹) <span class="text-danger">*</span>
                            </label>
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" id="viewModalPayFullBtn">
                                Pay Full Balance
                            </button>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-surface">₹</span>
                            <input type="number" name="payment_amount" id="viewModalPaymentAmount" class="form-control form-control-lg fw-bold text-success" step="0.01" min="0.01" max="<%= balAmt.toFixed(2) %>" value="<%= balAmt.toFixed(2) %>" required>
                        </div>
                        <div id="viewModalAmountError" class="text-danger small mt-1 d-none fw-semibold">
                            <i class="bi bi-exclamation-circle me-1"></i><span id="viewModalAmountErrorText"></span>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Payment Method <span class="text-danger">*</span></label>
                        <select name="payment_method" class="form-select fw-semibold" required>
                            <option value="Cash">Cash</option>
                            <option value="UPI">UPI / QR Code</option>
                            <option value="Card">Credit / Debit Card</option>
                            <option value="Bank Transfer">Bank Transfer / NEFT</option>
                        </select>
                    </div>

                    <!-- Payment Date -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Payment Date</label>
                        <input type="date" name="payment_date" class="form-control form-control-sm" value="<%= new Date().toISOString().split('T')[0] %>">
                    </div>

                    <!-- Real-time After Payment Preview -->
                    <div class="p-3 bg-light rounded-3 border mb-3 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Total Paid After Payment:</span>
                            <strong id="viewModalNewPaidPreview" class="text-success">₹<%= numberFormat(sale.total_amount, 2) %></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Remaining Balance:</span>
                            <strong id="viewModalNewBalancePreview" class="text-danger">₹0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-1 mt-1">
                            <span class="fw-bold">Resulting Status:</span>
                            <span id="viewModalNewStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle fw-bold">Fully Paid</span>
                        </div>
                    </div>

                    <!-- Remarks / Reference -->
                    <div class="mb-0">
                        <label class="form-label small fw-semibold">Remarks / Transaction Reference (Optional)</label>
                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="e.g. GPay Ref #12345, cheque #...">
                    </div>
                </div>
                <div class="modal-footer bg-surface py-3 px-4 border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="viewModalSubmitBtn" class="btn btn-success fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Record Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const currentTotal = <%= Number(sale.total_amount) %>;
const currentPaid = <%= Number(sale.paid_amount) %>;
const currentBal = <%= Number(balAmt) %>;

const amtInput = document.getElementById('viewModalPaymentAmount');
const errBox = document.getElementById('viewModalAmountError');
const errText = document.getElementById('viewModalAmountErrorText');
const submitBtn = document.getElementById('viewModalSubmitBtn');
const newPaidPreview = document.getElementById('viewModalNewPaidPreview');
const newBalPreview = document.getElementById('viewModalNewBalancePreview');
const statusBadge = document.getElementById('viewModalNewStatusBadge');

if (amtInput) {
    document.getElementById('viewModalPayFullBtn').addEventListener('click', function() {
        amtInput.value = currentBal.toFixed(2);
        recalcViewModal();
    });

    amtInput.addEventListener('input', recalcViewModal);
}

function recalcViewModal() {
    const val = parseFloat(amtInput.value) || 0;
    if (val <= 0) {
        errText.textContent = 'Payment amount must be greater than ₹0.00.';
        errBox.classList.remove('d-none');
        submitBtn.disabled = true;
    } else if (val > currentBal + 0.01) {
        errText.textContent = `Payment cannot exceed current balance of ₹${currentBal.toFixed(2)}.`;
        errBox.classList.remove('d-none');
        submitBtn.disabled = true;
    } else {
        errBox.classList.add('d-none');
        submitBtn.disabled = false;
    }

    const nPaid = Math.min(currentTotal, currentPaid + val);
    const nBal = Math.max(0, currentTotal - nPaid);

    newPaidPreview.textContent = '₹' + nPaid.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    newBalPreview.textContent = '₹' + nBal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});

    if (nBal <= 0.001) {
        statusBadge.textContent = 'Fully Paid';
        statusBadge.className = 'badge bg-success-subtle text-success border border-success-subtle fw-bold';
    } else {
        statusBadge.textContent = 'Partially Paid';
        statusBadge.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-bold';
    }
}
</script>
<% } %>

<% if (autoPrint) { %>
<script>
window.addEventListener('load', function() {
    window.print();
});
</script>
<% } %>

<%- include('includes/footer') %>
