<%- include('includes/header') %>

<%
const exportParams = new URLSearchParams(queryParams || {}).toString();
const hasActiveFilters = Boolean(
    (dateRangePreset && dateRangePreset !== 'this_month') ||
    fromDate ||
    toDate ||
    (customerId && customerId > 0) ||
    status ||
    paymentStatus ||
    rentalPeriodType ||
    (productId && productId > 0) ||
    saleType
);
%>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: '/' },
            { title: 'Reports & Analytics' }
        ]) %>

        <!-- PAGE HEADER & ACTIONS -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1 d-flex align-items-center gap-2">
                    <span class="avatar-sm bg-primary-subtle text-primary rounded-3 d-inline-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                        <i class="bi bi-file-earmark-bar-graph fs-5"></i>
                    </span>
                    <span>Reports & Analytics</span>
                </h1>
                <p class="text-muted small mb-0">Generate comprehensive business reports, financial breakdowns, and exports for rentals and sales.</p>
            </div>

            <!-- EXPORT ACTION TOOLBAR -->
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <a href="/reports/export/excel?<%= exportParams %>" class="btn btn-outline-success shadow-sm d-inline-flex align-items-center gap-2" id="exportExcelBtn" title="Export current report to Microsoft Excel">
                    <i class="bi bi-file-earmark-excel"></i>
                    <span>Export Excel</span>
                </a>
                <a href="/reports/export/word?<%= exportParams %>" class="btn btn-outline-primary shadow-sm d-inline-flex align-items-center gap-2" id="exportWordBtn" title="Export current report to Microsoft Word">
                    <i class="bi bi-file-earmark-word"></i>
                    <span>Export Word</span>
                </a>
                <a href="/reports/export/pdf?<%= exportParams %>" target="_blank" class="btn btn-outline-danger shadow-sm d-inline-flex align-items-center gap-2" id="exportPdfBtn" title="Open printable report and save to PDF">
                    <i class="bi bi-file-earmark-pdf"></i>
                    <span>Print / PDF</span>
                </a>
            </div>
        </div>

        <!-- REPORT TYPE SELECTOR TABS -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-surface">
            <div class="card-body p-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="nav nav-pills gap-2" id="reportTypeTabs" role="tablist">
                        <a href="/reports?report_type=rentals&date_range=<%= e(dateRangePreset) %>" class="btn <%= reportType === 'rentals' ? 'btn-primary text-white' : 'btn-light text-body' %> rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                            <i class="bi bi-clock-history"></i>
                            <span>Rentals Report</span>
                            <% if (reportType === 'rentals') { %>
                                <span class="badge bg-white text-primary rounded-pill px-2 py-0.5 ms-1"><%= summary.totalRecords || 0 %></span>
                            <% } %>
                        </a>
                        <a href="/reports?report_type=sales&date_range=<%= e(dateRangePreset) %>" class="btn <%= reportType === 'sales' ? 'btn-primary text-white' : 'btn-light text-body' %> rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                            <i class="bi bi-receipt"></i>
                            <span>Sales Notes Report</span>
                            <% if (reportType === 'sales') { %>
                                <span class="badge bg-white text-primary rounded-pill px-2 py-0.5 ms-1"><%= summary.totalRecords || 0 %></span>
                            <% } %>
                        </a>
                    </div>

                    <div class="text-muted small d-flex align-items-center gap-2">
                        <i class="bi bi-calendar3"></i>
                        <span>Period: <strong><%= fromDate || 'Start' %></strong> to <strong><%= toDate || 'Present' %></strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- FILTER CARD -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-surface">
            <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-funnel text-primary fs-5"></i>
                    <h5 class="mb-0 fw-bold">Report Filters</h5>
                    <% if (hasActiveFilters) { %>
                        <span class="badge bg-primary-subtle text-primary rounded-pill ms-2">Filters Applied</span>
                    <% } %>
                </div>
                <a href="/reports?report_type=<%= e(reportType) %>" class="btn btn-sm btn-link text-decoration-none text-muted">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                </a>
            </div>
            <div class="card-body p-4">
                <form method="GET" action="/reports" id="reportFilterForm">
                    <input type="hidden" name="report_type" value="<%= e(reportType) %>">

                    <!-- Quick Preset Buttons -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase mb-2">Date Range Presets</label>
                        <div class="d-flex flex-wrap gap-2" id="presetButtons">
                            <button type="button" class="btn btn-sm <%= dateRangePreset === 'today' ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3 date-preset-btn" data-preset="today">Today</button>
                            <button type="button" class="btn btn-sm <%= dateRangePreset === 'this_week' ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3 date-preset-btn" data-preset="this_week">This Week</button>
                            <button type="button" class="btn btn-sm <%= dateRangePreset === 'this_month' ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3 date-preset-btn" data-preset="this_month">This Month</button>
                            <button type="button" class="btn btn-sm <%= dateRangePreset === 'custom' ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3 date-preset-btn" data-preset="custom">Custom Range</button>
                            <input type="hidden" name="date_range" id="dateRangePresetInput" value="<%= e(dateRangePreset) %>">
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- From Date -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold text-muted">From Date</label>
                            <input type="date" name="from_date" id="fromDateInput" class="form-control" value="<%= fromDate %>">
                        </div>

                        <!-- To Date -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold text-muted">To Date</label>
                            <input type="date" name="to_date" id="toDateInput" class="form-control" value="<%= toDate %>">
                        </div>

                        <!-- Customer Filter -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold text-muted">Customer</label>
                            <select name="customer_id" class="form-select">
                                <option value="">All Customers</option>
                                <% (customersList || []).forEach(function(c) { %>
                                    <option value="<%= c.id %>" <%= Number(customerId) === Number(c.id) ? 'selected' : '' %>>
                                        <%= e(c.customer_name) %> (<%= e(c.customer_code) %>)
                                    </option>
                                <% }); %>
                            </select>
                        </div>

                        <% if (reportType === 'rentals') { %>
                            <!-- Rental Status -->
                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Rental Status</label>
                                <select name="status" class="form-select">
                                    <option value="">All Statuses</option>
                                    <option value="Active" <%= status === 'Active' ? 'selected' : '' %>>Active</option>
                                    <option value="Overdue" <%= status === 'Overdue' ? 'selected' : '' %>>Overdue</option>
                                    <option value="Returned" <%= status === 'Returned' ? 'selected' : '' %>>Returned</option>
                                    <option value="Cancelled" <%= status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </div>

                            <!-- Advance Payment Status -->
                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Advance Status</label>
                                <select name="payment_status" class="form-select">
                                    <option value="">All Payments</option>
                                    <option value="fully_covered" <%= paymentStatus === 'fully_covered' ? 'selected' : '' %>>Fully Covered</option>
                                    <option value="partially_paid" <%= paymentStatus === 'partially_paid' ? 'selected' : '' %>>Partially Paid</option>
                                    <option value="unpaid" <%= paymentStatus === 'unpaid' ? 'selected' : '' %>>Unpaid Upfront</option>
                                </select>
                            </div>

                            <!-- Period Type -->
                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Rental Unit</label>
                                <select name="rental_period_type" class="form-select">
                                    <option value="">All Units</option>
                                    <option value="hourly" <%= rentalPeriodType === 'hourly' ? 'selected' : '' %>>Hourly</option>
                                    <option value="daily" <%= rentalPeriodType === 'daily' ? 'selected' : '' %>>Daily</option>
                                    <option value="weekly" <%= rentalPeriodType === 'weekly' ? 'selected' : '' %>>Weekly</option>
                                    <option value="monthly" <%= rentalPeriodType === 'monthly' ? 'selected' : '' %>>Monthly</option>
                                </select>
                            </div>

                            <!-- Product Filter -->
                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Rental Product</label>
                                <select name="product_id" class="form-select">
                                    <option value="">All Products</option>
                                    <% (productsList || []).filter(p => p.rental_available == 1).forEach(function(p) { %>
                                        <option value="<%= p.id %>" <%= Number(productId) === Number(p.id) ? 'selected' : '' %>>
                                            <%= e(p.product_name) %> (<%= e(p.product_code) %>)
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                        <% } else { %>
                            <!-- Sales Note Status -->
                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Note Status</label>
                                <select name="status" class="form-select">
                                    <option value="">All Statuses</option>
                                    <option value="Confirmed" <%= status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                                    <option value="Cancelled" <%= status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </div>

                            <!-- Sale Type -->
                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Sale Type</label>
                                <select name="sale_type" class="form-select">
                                    <option value="">All Sale Types</option>
                                    <option value="normal" <%= saleType === 'normal' ? 'selected' : '' %>>Normal Sales</option>
                                    <option value="credit" <%= saleType === 'credit' ? 'selected' : '' %>>Credit Sales</option>
                                </select>
                            </div>

                            <!-- Payment Status -->
                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Payment Status</label>
                                <select name="payment_status" class="form-select">
                                    <option value="">All Payment Statuses</option>
                                    <option value="Paid" <%= paymentStatus === 'Paid' ? 'selected' : '' %>>Fully Paid</option>
                                    <option value="Partial" <%= paymentStatus === 'Partial' ? 'selected' : '' %>>Partially Paid</option>
                                    <option value="Unpaid" <%= paymentStatus === 'Unpaid' ? 'selected' : '' %>>Unpaid / Credit</option>
                                </select>
                            </div>
                        <% } %>

                        <!-- Action Buttons -->
                        <div class="col-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                            <a href="/reports?report_type=<%= e(reportType) %>" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-1"></i>Clear
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm fw-semibold">
                                <i class="bi bi-search me-1"></i>Generate Report
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- KPI SUMMARY CARDS -->
        <div class="row g-3 mb-4">
            <% if (reportType === 'rentals') { %>
                <!-- Total Records -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="metric-card metric-primary p-3 rounded-4 shadow-sm border bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Total Rentals</span>
                            <div class="avatar-xs bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-clock-history fs-5"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1"><%= numberFormat(summary.totalRecords || 0, 0) %></h3>
                        <div class="text-muted small">
                            <span class="badge bg-success-subtle text-success me-1"><%= summary.returnedCount || 0 %> Returned</span>
                            <span class="badge bg-info-subtle text-info"><%= summary.activeCount || 0 %> Active</span>
                        </div>
                    </div>
                </div>

                <!-- Total Rental Amount -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="metric-card metric-info p-3 rounded-4 shadow-sm border bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Estimated Rental Revenue</span>
                            <div class="avatar-xs bg-info-subtle text-info rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-wallet2 fs-5"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-primary">₹<%= numberFormat(summary.totalRentalAmount || 0, 2) %></h3>
                        <div class="text-muted small">Total estimated rental billings</div>
                    </div>
                </div>

                <!-- Total Advance Collected -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="metric-card metric-success p-3 rounded-4 shadow-sm border bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Advance Collected</span>
                            <div class="avatar-xs bg-success-subtle text-success rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-cash-stack fs-5"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-success">₹<%= numberFormat(summary.totalAdvanceAmount || 0, 2) %></h3>
                        <div class="text-muted small">
                            <span class="badge bg-success-subtle text-success"><%= summary.fullyCoveredCount || 0 %> Fully Covered</span>
                        </div>
                    </div>
                </div>

                <!-- Estimated Outstanding Balance -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="metric-card <%= (summary.totalOutstandingAmount || 0) > 0 ? 'metric-warning' : 'metric-secondary' %> p-3 rounded-4 shadow-sm border bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Remaining On Return</span>
                            <div class="avatar-xs bg-warning-subtle text-warning-emphasis rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-hourglass-split fs-5"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-warning-emphasis">₹<%= numberFormat(summary.totalOutstandingAmount || 0, 2) %></h3>
                        <div class="text-muted small">
                            <% if ((summary.overdueCount || 0) > 0) { %>
                                <span class="badge bg-danger text-white"><%= summary.overdueCount %> Overdue</span>
                            <% } else { %>
                                Projected return collections
                            <% } %>
                        </div>
                    </div>
                </div>

            <% } else { %>

                <!-- Total Sales Records -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="metric-card metric-primary p-3 rounded-4 shadow-sm border bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Total Sales Notes</span>
                            <div class="avatar-xs bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-receipt fs-5"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1"><%= numberFormat(summary.totalRecords || 0, 0) %></h3>
                        <div class="text-muted small">
                            <span class="badge bg-success-subtle text-success me-1"><%= summary.fullyPaidCount || 0 %> Paid</span>
                            <span class="badge bg-warning-subtle text-warning-emphasis"><%= summary.partiallyPaidCount || 0 %> Partial</span>
                        </div>
                    </div>
                </div>

                <!-- Total Sales Amount -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="metric-card metric-info p-3 rounded-4 shadow-sm border bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Total Sales Value</span>
                            <div class="avatar-xs bg-info-subtle text-info rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-cart-check fs-5"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-primary">₹<%= numberFormat(summary.totalSalesAmount || 0, 2) %></h3>
                        <div class="text-muted small">Gross sales value</div>
                    </div>
                </div>

                <!-- Total Paid / Collected -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="metric-card metric-success p-3 rounded-4 shadow-sm border bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Total Amount Paid</span>
                            <div class="avatar-xs bg-success-subtle text-success rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-cash-stack fs-5"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-success">₹<%= numberFormat(summary.totalPaidAmount || 0, 2) %></h3>
                        <div class="text-muted small">Directly received payments</div>
                    </div>
                </div>

                <!-- Total Credit Outstanding -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="metric-card <%= (summary.totalCreditAmount || 0) > 0 ? 'metric-danger border-danger-subtle' : 'metric-secondary' %> p-3 rounded-4 shadow-sm border bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Credit / Outstanding</span>
                            <div class="avatar-xs bg-danger-subtle text-danger rounded-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-exclamation-octagon fs-5"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-danger">₹<%= numberFormat(summary.totalCreditAmount || 0, 2) %></h3>
                        <div class="text-muted small">Receivable across sales notes</div>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- DETAILED DATA TABLE -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-surface">
            <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-table text-primary fs-5"></i>
                    <h5 class="mb-0 fw-bold">Report Records (<%= records.length %>)</h5>
                </div>
                <% if (records.length > 0) { %>
                    <div class="text-muted small">
                        Showing all <%= records.length %> matching records
                    </div>
                <% } %>
            </div>

            <div class="table-responsive">
                <% if (records.length === 0) { %>
                    <!-- EMPTY RESULT STATE -->
                    <div class="p-5 text-center my-4">
                        <div class="avatar-lg bg-light text-muted rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width:72px;height:72px;">
                            <i class="bi bi-inbox fs-1 text-secondary"></i>
                        </div>
                        <h4 class="fw-bold text-secondary mb-2">No records found for the selected filters</h4>
                        <p class="text-muted max-w-md mx-auto mb-4">Try widening your date range, clearing customer or status filters, or selecting a different report type.</p>
                        <a href="/reports?report_type=<%= e(reportType) %>" class="btn btn-outline-primary px-4 rounded-pill">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset All Filters
                        </a>
                    </div>
                <% } else if (reportType === 'rentals') { %>
                    <!-- RENTALS TABLE -->
                    <table class="table table-hover align-middle mb-0" id="rentalsReportTable">
                        <thead class="table-light text-uppercase small fw-bold">
                            <tr>
                                <th scope="col" style="width: 50px;" class="text-center">#</th>
                                <th scope="col">Check-in Date</th>
                                <th scope="col">Rental #</th>
                                <th scope="col">Customer</th>
                                <th scope="col">Product</th>
                                <th scope="col">Unit & Duration</th>
                                <th scope="col" class="text-end">Est. Rental</th>
                                <th scope="col" class="text-end">Advance Paid</th>
                                <th scope="col" class="text-end">Bal. on Return</th>
                                <th scope="col" class="text-center">Status</th>
                                <th scope="col" class="text-end" style="width: 80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% records.forEach(function(row, idx) { %>
                                <tr>
                                    <td class="text-center text-muted small"><%= idx + 1 %></td>
                                    <td>
                                        <div class="fw-semibold"><%= formatDate(row.check_in_datetime, 'DD MMM YYYY') %></div>
                                        <small class="text-muted"><%= formatDate(row.check_in_datetime, 'hh:mm A') %></small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border"><%= e(row.rental_no || ('#' + row.id)) %></span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-body"><%= e(row.customer_name || 'N/A') %></div>
                                        <small class="text-muted"><%= e(row.mobile_number || '') %></small>
                                    </td>
                                    <td>
                                        <div class="fw-medium"><%= e(row.product_name || 'N/A') %></div>
                                        <small class="text-muted font-monospace"><%= e(row.product_code || '') %></small>
                                    </td>
                                    <td>
                                        <div><span class="badge bg-primary-subtle text-primary text-capitalize"><%= e(row.rental_period_type || 'daily') %></span></div>
                                        <small class="text-muted"><%= row.estimated_duration || 1 %> <%= (row.rental_period_type || 'day').replace(/ly$/, '') %>(s) @ ₹<%= numberFormat(row.rental_rate, 2) %></small>
                                    </td>
                                    <td class="text-end fw-semibold">
                                        ₹<%= numberFormat(row.total_rental_amount, 2) %>
                                    </td>
                                    <td class="text-end text-success fw-semibold">
                                        ₹<%= numberFormat(row.advance_rental_amount, 2) %>
                                    </td>
                                    <td class="text-end <%= (row.remaining_balance || 0) > 0 ? 'text-warning-emphasis fw-bold' : 'text-muted' %>">
                                        ₹<%= numberFormat(row.remaining_balance, 2) %>
                                    </td>
                                    <td class="text-center">
                                        <%- row.statusBadge %>
                                        <div>
                                            <% if (row.isFullyCovered) { %>
                                                <span class="badge bg-success-subtle text-success" style="font-size: 10px;">Fully Covered</span>
                                            <% } else if (row.isPartiallyPaid) { %>
                                                <span class="badge bg-info-subtle text-info" style="font-size: 10px;">Partial Adv</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 10px;">No Adv</span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <a href="/rentals/view/<%= row.id %>" class="btn btn-sm btn-outline-primary" title="View Rental">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="6" class="text-end">TOTALS (<%= records.length %> Records):</td>
                                <td class="text-end text-primary">₹<%= numberFormat(summary.totalRentalAmount || 0, 2) %></td>
                                <td class="text-end text-success">₹<%= numberFormat(summary.totalAdvanceAmount || 0, 2) %></td>
                                <td class="text-end text-warning-emphasis">₹<%= numberFormat(summary.totalOutstandingAmount || 0, 2) %></td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>

                <% } else { %>
                    <!-- SALES NOTES TABLE -->
                    <table class="table table-hover align-middle mb-0" id="salesReportTable">
                        <thead class="table-light text-uppercase small fw-bold">
                            <tr>
                                <th scope="col" style="width: 50px;" class="text-center">#</th>
                                <th scope="col">Date</th>
                                <th scope="col">Sales Note #</th>
                                <th scope="col">Customer</th>
                                <th scope="col">Sale Type</th>
                                <th scope="col" class="text-end">Gross Amount</th>
                                <th scope="col" class="text-end">Amount Paid</th>
                                <th scope="col" class="text-end">Balance / Credit</th>
                                <th scope="col" class="text-center">Payment Status</th>
                                <th scope="col" class="text-center">Note Status</th>
                                <th scope="col" class="text-end" style="width: 80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% records.forEach(function(row, idx) { %>
                                <tr>
                                    <td class="text-center text-muted small"><%= idx + 1 %></td>
                                    <td>
                                        <div class="fw-semibold"><%= formatDate(row.sales_date, 'DD MMM YYYY') %></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border"><%= e(row.sales_note_no || ('#' + row.id)) %></span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-body"><%= e(row.customer_name || 'N/A') %></div>
                                        <small class="text-muted"><%= e(row.customer_mobile || '') %></small>
                                    </td>
                                    <td>
                                        <% if (row.sale_type === 'credit') { %>
                                            <span class="badge bg-danger-subtle text-danger fw-semibold">Credit Sale</span>
                                        <% } else { %>
                                            <span class="badge bg-success-subtle text-success fw-semibold">Normal Sale</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end fw-semibold">
                                        ₹<%= numberFormat(row.total_amount, 2) %>
                                    </td>
                                    <td class="text-end text-success fw-semibold">
                                        ₹<%= numberFormat(row.paid_amount, 2) %>
                                    </td>
                                    <td class="text-end <%= (row.balance_amount || 0) > 0 ? 'text-danger fw-bold' : 'text-muted' %>">
                                        ₹<%= numberFormat(row.balance_amount, 2) %>
                                    </td>
                                    <td class="text-center">
                                        <% if (row.payment_status === 'Paid') { %>
                                            <span class="badge bg-success-subtle text-success">Paid</span>
                                        <% } else if (row.payment_status === 'Partial') { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis">Partial</span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger">Unpaid</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if (row.status == 1) { %>
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <a href="/sales-notes/view/<%= row.id %>" class="btn btn-sm btn-outline-primary" title="View Sales Note">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="5" class="text-end">TOTALS (<%= records.length %> Records):</td>
                                <td class="text-end text-primary">₹<%= numberFormat(summary.totalSalesAmount || 0, 2) %></td>
                                <td class="text-end text-success">₹<%= numberFormat(summary.totalPaidAmount || 0, 2) %></td>
                                <td class="text-end text-danger">₹<%= numberFormat(summary.totalCreditAmount || 0, 2) %></td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                <% } %>
            </div>
        </div>

    </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const presetButtons = document.querySelectorAll('.date-preset-btn');
    const presetInput = document.getElementById('dateRangePresetInput');
    const fromDateInput = document.getElementById('fromDateInput');
    const toDateInput = document.getElementById('toDateInput');
    const filterForm = document.getElementById('reportFilterForm');

    function pad(n) { return String(n).padStart(2, '0'); }
    function fmtDate(d) { return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }

    presetButtons.forEach(btn => {
        btn.addEventListener('click', function () {
            const preset = this.getAttribute('data-preset');
            presetInput.value = preset;

            presetButtons.forEach(b => {
                b.classList.remove('btn-primary');
                b.classList.add('btn-outline-secondary');
            });
            this.classList.remove('btn-outline-secondary');
            this.classList.add('btn-primary');

            const now = new Date();
            if (preset === 'today') {
                fromDateInput.value = fmtDate(now);
                toDateInput.value = fmtDate(now);
            } else if (preset === 'this_week') {
                const day = now.getDay();
                const diffToMonday = (day === 0 ? -6 : 1) - day;
                const monday = new Date(now);
                monday.setDate(now.getDate() + diffToMonday);
                const sunday = new Date(monday);
                sunday.setDate(monday.getDate() + 6);
                fromDateInput.value = fmtDate(monday);
                toDateInput.value = fmtDate(sunday);
            } else if (preset === 'this_month') {
                const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
                const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                fromDateInput.value = fmtDate(firstDay);
                toDateInput.value = fmtDate(lastDay);
            } else if (preset === 'custom') {
                // Keep inputs open for user selection
                fromDateInput.focus();
            }
        });
    });

    // If dates changed manually, set preset to custom
    [fromDateInput, toDateInput].forEach(inp => {
        inp.addEventListener('change', () => {
            presetInput.value = 'custom';
            presetButtons.forEach(b => {
                b.classList.toggle('btn-primary', b.getAttribute('data-preset') === 'custom');
                b.classList.toggle('btn-outline-secondary', b.getAttribute('data-preset') !== 'custom');
            });
        });
    });
});
</script>

<%- include('includes/footer') %>
