<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: 'index.php' },
            { title: 'Masters', link: 'masters.php' },
            { title: 'Customer Master' }
        ]) %>

        <!-- PAGE HEADING -->
        <div class="page-heading d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">
                    <i class="bi bi-people text-primary me-2"></i>Customer Master
                </h1>
            </div>
            <a href="create_customer.php" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Customer
            </a>
        </div>

        <!-- SUCCESS / ERROR FLASH MESSAGES -->
        <% if (locals.success) { %>
            <div class="alert alert-success alert-dismissible fade show auto-hide-alert d-flex align-items-center gap-2 shadow-sm mb-4">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="fw-medium"><%= e(success) %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="fw-medium"><%= e(error) %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- SEARCH & FILTER SECTION -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3 p-md-4">
                <form method="GET" action="manage_customer.php" id="customerFilterForm">
                    <div class="row g-2 align-items-center">
                        <!-- Search Input -->
                        <div class="col">
                            <div class="manage-search-wrapper">
                                <i class="bi bi-search manage-search-icon"></i>
                                <input
                                    type="text"
                                    name="search"
                                    id="customerSearch"
                                    class="form-control manage-search-input"
                                    placeholder="Search by Customer Code, Name, Company, or Mobile Number..."
                                    value="<%= e(search) %>"
                                    autocomplete="off"
                                >
                            </div>
                        </div>

                        <!-- Reset / Clear Button -->
                        <% if (search !== '' || customerTypeFilter !== '' || creditAllowedFilter !== '' || statusFilter !== '') { %>
                            <div class="col-auto">
                                <a href="manage_customer.php" class="btn btn-outline-secondary" title="Reset Filters" style="height: 44px; display: inline-flex; align-items: center;">
                                    <i class="bi bi-x-lg me-1"></i> <span class="d-none d-sm-inline">Clear</span>
                                </a>
                            </div>
                        <% } %>

                        <!-- Filters Toggle Button -->
                        <div class="col-auto">
                            <button
                                type="button"
                                class="btn btn-outline-primary btn-filter-toggle"
                                data-bs-toggle="collapse"
                                data-bs-target="#customerFilterSection"
                                aria-expanded="<%= (customerTypeFilter !== '' || creditAllowedFilter !== '' || statusFilter !== '') ? 'true' : 'false' %>"
                                aria-controls="customerFilterSection"
                            >
                                <i class="bi bi-funnel"></i>
                                <span>Filters</span>
                                <i class="bi bi-chevron-down filter-chevron ms-1"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Expandable Filter Panel -->
                    <div class="collapse <%= (customerTypeFilter !== '' || creditAllowedFilter !== '' || statusFilter !== '') ? 'show' : '' %>" id="customerFilterSection">
                        <div class="filter-panel-box">
                            <div class="row g-3">
                                <!-- Customer Type -->
                                <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small fw-semibold text-muted">Customer Type</label>
                                    <select name="customer_type" class="form-select">
                                        <option value="">All Types</option>
                                        <option value="Individual" <%= customerTypeFilter === 'Individual' ? 'selected' : '' %>>Individual</option>
                                        <option value="Business" <%= customerTypeFilter === 'Business' ? 'selected' : '' %>>Business</option>
                                    </select>
                                </div>

                                <!-- Credit Allowed -->
                                <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small fw-semibold text-muted">Credit Allowed</label>
                                    <select name="credit_allowed" class="form-select">
                                        <option value="">All Credit Status</option>
                                        <option value="1" <%= creditAllowedFilter === '1' ? 'selected' : '' %>>Credit Allowed</option>
                                        <option value="0" <%= creditAllowedFilter === '0' ? 'selected' : '' %>>No Credit</option>
                                    </select>
                                </div>

                                <!-- Status -->
                                <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small fw-semibold text-muted">Account Status</label>
                                    <select name="status" class="form-select">
                                        <option value="">All Status</option>
                                        <option value="1" <%= statusFilter === '1' ? 'selected' : '' %>>Active</option>
                                        <option value="0" <%= statusFilter === '0' ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                </div>
                            </div>

                            <div class="filter-actions">
                                <a href="manage_customer.php" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                                </a>
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-check-lg me-1"></i> Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- CUSTOMER TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="fw-bold mb-0 text-body">
                    Customers (<%= totalRecords %>)
                </h5>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Customer Code</th>
                                <th>Customer Name</th>
                                <th>Company Name</th>
                                <th>Mobile Number</th>
                                <th>Customer Type</th>
                                <th>Credit Allowed</th>
                                <th>Debit / Outstanding</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Updated By</th>
                                <th class="action-column text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!customers || customers.length === 0) { %>
                                <tr>
                                    <td colspan="11" class="text-center py-5 text-muted">
                                        <div class="my-4">
                                            <i class="bi bi-people display-4 text-muted d-block mb-3"></i>
                                            <h5 class="fw-semibold text-body">No Customers Found</h5>
                                            <p class="text-muted mb-3">No customer records matched your search and filter criteria.</p>
                                            <% if (search || customerTypeFilter || creditAllowedFilter || statusFilter) { %>
                                                <a href="manage_customer.php" class="btn btn-outline-secondary me-2">Clear Filters</a>
                                            <% } %>
                                            <a href="create_customer.php" class="btn btn-primary">
                                                <i class="bi bi-plus-lg me-1"></i> Add Customer
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% customers.forEach(function(row) { %>
                                    <tr>
                                        <!-- CODE -->
                                        <td class="ps-4 text-nowrap">
                                            <span class="status-dot <%= (parseInt(row.status) === 1) ? 'active' : 'inactive' %>"
                                                title="<%= (parseInt(row.status) === 1) ? 'Active' : 'Inactive' %>"></span>
                                            <strong><%= e(row.customer_code) %></strong>
                                        </td>

                                        <!-- NAME -->
                                        <td>
                                            <a href="view_customer.php?id=<%= row.id %>" class="fw-semibold text-decoration-none text-body">
                                                <%= e(row.customer_name) %>
                                            </a>
                                        </td>

                                        <!-- COMPANY -->
                                        <td class="text-muted text-nowrap">
                                            <%= row.company_name ? e(row.company_name) : '-' %>
                                        </td>

                                        <!-- MOBILE -->
                                        <td class="text-nowrap"><%= e(row.mobile_number) %></td>

                                        <!-- TYPE -->
                                        <td class="text-nowrap">
                                            <span class="badge <%= (row.customer_type === 'Business') ? 'bg-info-subtle text-info border border-info-subtle' : 'bg-secondary-subtle text-secondary border border-secondary-subtle' %>">
                                                <%= e(row.customer_type) %>
                                            </span>
                                        </td>

                                        <!-- CREDIT ALLOWED -->
                                        <td class="text-nowrap">
                                            <% if (parseInt(row.credit_allowed) === 1) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Yes</span>
                                                <small class="text-muted d-block">Limit: ₹<%= numberFormat(row.credit_limit, 2) %></small>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">No</span>
                                            <% } %>
                                        </td>

                                        <!-- DEBIT / OUTSTANDING -->
                                        <td class="text-nowrap">
                                            <%- formatCustomerBalance(row.summary) %>
                                        </td>

                                        <!-- STATUS -->
                                        <td class="text-nowrap">
                                            <% if (parseInt(row.status) === 1) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                            <% } %>
                                        </td>

                                        <!-- CREATED BY -->
                                        <td class="text-nowrap"><%= e(row.created_by_name || row.created_by || '-') %></td>

                                        <!-- UPDATED BY -->
                                        <td class="text-nowrap"><%= e(row.updated_by_name || row.updated_by || '-') %></td>

                                        <!-- ACTIONS -->
                                        <td class="action-column text-end pe-4 text-nowrap">
                                            <div class="btn-group btn-group-sm">
                                                <a href="view_customer.php?id=<%= row.id %>" class="btn btn-outline-secondary" title="View Profile">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="edit_customer.php?id=<%= row.id %>" class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <% if (parseInt(row.status) === 1) { %>
                                                    <a href="manage_customer.php?action=deactivate&id=<%= row.id %>" class="btn btn-outline-danger" title="Deactivate Customer" onclick="return confirm('Are you sure you want to deactivate customer <%= e(row.customer_code) %>?');">
                                                        <i class="bi bi-slash-circle"></i>
                                                    </a>
                                                <% } else { %>
                                                    <a href="manage_customer.php?action=activate&id=<%= row.id %>" class="btn btn-outline-success" title="Activate Customer">
                                                        <i class="bi bi-check-circle"></i>
                                                    </a>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PAGINATION -->
            <%- renderPagination({ page, totalPages, totalRecords, limit, queryParams, baseUrl: 'manage_customer.php' }) %>
        </div>

    </div>
</main>

<%- include('includes/footer') %>
