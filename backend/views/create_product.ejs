<%- include('includes/header') %>

<main class="main-content">
<div class="container-fluid px-3 px-lg-4 py-4">

<!-- Breadcrumb Navigation -->
<%- renderBreadcrumbs([
    { title: '', icon: 'bi bi-house-door', link: '/' },
    { title: 'Product', link: '/products' },
    { title: 'Add' }
]) %>

<!-- PAGE HEADING -->
<div class="page-heading d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Create Product</h1>
        <p class="text-muted mb-0">Add a new product for rental and sales.</p>
    </div>
    <a href="/products" class="btn btn-outline-secondary">Back</a>
</div>

<% if (generalError) { %>
<div class="alert alert-danger">
    <i class="bi bi-exclamation-circle me-2"></i>
    <%= generalError %>
</div>
<% } %>

<form method="POST" enctype="multipart/form-data" id="productForm">

<!-- SECTION 1 -->
<div class="card shadow-sm mb-4">
<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="card-title mb-0">
        <h5 class="mb-0 fw-bold">
           Basic Information
        </h5>
    </div>
    <div class="card-header-actions">
        <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
            <input
                class="form-check-input"
                type="checkbox"
                name="status"
                id="status"
                <%= (!old || old.status === undefined || old.status) ? 'checked' : '' %>
            >
            <label class="form-check-label mb-0 fw-semibold" id="statusLabel" for="status">
                <%= (!old || old.status === undefined || old.status) ? 'Active' : 'Inactive' %>
            </label>
        </div>
    </div>
</div>

<div class="card-body">
<div class="row g-3">

<!-- PRODUCT NAME -->
<div class="col-12">
    <label class="form-label">Product Name <span class="text-danger">*</span></label>
    <input
        type="text"
        name="product_name"
        class="form-control <%= productNameError ? 'is-invalid' : '' %>"
        value="<%= (old && old.product_name) || '' %>"
        minlength="2"
        maxlength="200"
        placeholder="Enter product name"
        required
    >
    <% if (productNameError) { %>
    <div class="validation-message"><%= productNameError %></div>
    <% } %>
</div>

<!-- SHORT NAME -->
<div class="col-12 col-md-6">
    <label class="form-label">Short Name <span class="text-danger">*</span></label>
    <input
        type="text"
        name="short_name"
        class="form-control <%= shortNameError ? 'is-invalid' : '' %>"
        value="<%= (old && old.short_name) || '' %>"
        minlength="2"
        maxlength="100"
        placeholder="Enter short name"
        required
    >
    <% if (shortNameError) { %>
    <div class="validation-message"><%= shortNameError %></div>
    <% } %>
</div>

<!-- CATEGORY -->
<div class="col-12 col-md-6">
    <label class="form-label">Category <span class="text-danger">*</span></label>
    <select name="category_id" id="categoryId" class="form-select searchable-select <%= categoryError ? 'is-invalid' : '' %>" required>
        <option value="">Select Category</option>
        <% categories.forEach(category => { %>
        <option
            value="<%= category.id %>"
            <%= (old && String(old.category_id) === String(category.id)) ? 'selected' : '' %>
        >
            <%= category.category_code %> - <%= category.category_name %>
        </option>
        <% }) %>
    </select>
    <% if (categoryError) { %>
    <div class="validation-message"><%= categoryError %></div>
    <% } %>
</div>

<!-- BRAND -->
<div class="col-12 col-md-6">
    <label class="form-label">Brand <span class="text-danger">*</span></label>
    <select name="brand_id" id="brandId" class="form-select searchable-select <%= brandError ? 'is-invalid' : '' %>" required>
        <option value="">Select Brand</option>
        <% brands.forEach(brand => { %>
        <option
            value="<%= brand.id %>"
            <%= (old && String(old.brand_id) === String(brand.id)) ? 'selected' : '' %>
        >
            <%= brand.brand_code %> - <%= brand.brand_name %>
        </option>
        <% }) %>
    </select>
    <% if (brandError) { %>
    <div class="validation-message"><%= brandError %></div>
    <% } %>
</div>

<!-- PRODUCT TYPE (STATIC DROPDOWN: SALES / RENTAL) -->
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold">Product Type <span class="text-danger">*</span></label>
    <select name="product_type" id="productType" class="form-select searchable-select <%= (typeof productTypeError !== 'undefined' && productTypeError) ? 'is-invalid' : '' %>" required>
        <option value="">Select Product Type</option>
        <option value="Sales" <%= (old && old.product_type === 'Sales') ? 'selected' : '' %>>Sales</option>
        <option value="Rental" <%= (old && old.product_type === 'Rental') ? 'selected' : '' %>>Rental</option>
    </select>
    <% if (typeof productTypeError !== 'undefined' && productTypeError) { %>
    <div class="validation-message text-danger small mt-1"><i class="bi bi-exclamation-circle me-1"></i><%= productTypeError %></div>
    <% } %>
</div>

<!-- IMAGES -->
<div class="col-12 col-md-6">
    <label class="form-label">Product Image <span class="text-danger">*</span></label>
    <input
        type="file"
        name="product_images"
        class="form-control <%= imageError ? 'is-invalid' : '' %>"
        accept="image/jpeg,image/png,image/gif,image/webp"
        multiple
        required
    >
    <small class="text-muted">You can upload multiple JPG, JPEG, PNG, GIF or WEBP images.</small>
    <% if (imageError) { %>
    <div class="validation-message"><%= imageError %></div>
    <% } %>
</div>

<!-- DESCRIPTION -->
<div class="col-12">
    <div class="d-flex justify-content-between">
        <label class="form-label">Description</label>
        <small class="text-muted" id="descriptionCount">0 / 2000</small>
    </div>
    <textarea
        name="description"
        id="description"
        class="form-control"
        rows="4"
        maxlength="2000"
        placeholder="Enter product description"
    ><%= (old && old.description) || '' %></textarea>
</div>

</div>
</div>
</div>

<!-- CONDITIONAL SECTION: SALES INFORMATION (SHOWN ONLY IF PRODUCT TYPE = SALES) -->
<div class="card shadow-sm mb-4" id="salesSectionCard" style="display: <%= (old && old.product_type === 'Sales') ? 'block' : 'none' %>;">
<div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h5 class="mb-0 fw-bold text-primary">
        <i class="bi bi-tag me-2"></i>Sales Information
    </h5>
    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">Sales Specific</span>
</div>
<div class="card-body">
<div class="row g-3">

<input type="hidden" name="sale_available" id="saleAvailable" value="<%= (old && old.product_type === 'Rental') ? 'no' : 'yes' %>">

<!-- PURCHASE PRICE -->
<div class="col-12 col-md-4">
    <label class="form-label">Purchase Price (₹)</label>
    <div class="input-group">
        <span class="input-group-text">₹</span>
        <input
            type="number"
            name="purchase_price"
            class="form-control"
            step="0.01"
            min="0"
            placeholder="0.00"
            value="<%= (old && old.purchase_price) || '' %>"
        >
    </div>
</div>

<!-- SELLING PRICE -->
<div class="col-12 col-md-4">
    <label class="form-label">
        Selling Price (₹) <span class="text-danger sale-required">*</span>
    </label>
    <div class="input-group">
        <span class="input-group-text">₹</span>
        <input
            type="number"
            name="selling_price"
            id="sellingPrice"
            class="form-control <%= sellingPriceError ? 'is-invalid' : '' %>"
            step="0.01"
            min="0"
            placeholder="0.00"
            value="<%= (old && old.selling_price) || '' %>"
        >
    </div>
    <% if (sellingPriceError) { %>
    <div class="validation-message"><%= sellingPriceError %></div>
    <% } %>
</div>

<!-- DISCOUNT -->
<div class="col-12 col-md-4">
    <label class="form-label">Discount Allowed</label>
    <select name="discount_allowed" id="discountAllowed" class="form-select">
        <option value="no" <%= (old && old.discount_allowed === 'no') ? 'selected' : '' %>>No</option>
        <option value="yes" <%= (old && old.discount_allowed === 'yes') ? 'selected' : '' %>>Yes</option>
    </select>
</div>

<!-- DISCOUNT % -->
<div class="col-12 col-md-4" id="discountPercentWrapper" style="display:none">
    <label class="form-label">Discount %</label>
    <div class="input-group">
        <input
            type="number"
            name="discount_percent"
            class="form-control"
            step="0.01"
            min="0"
            max="100"
            placeholder="Enter %"
            value="<%= (old && old.discount_percent) || '' %>"
        >
        <span class="input-group-text">%</span>
    </div>
</div>

<!-- UNIT OF SALE -->
<div class="col-12 col-md-4">
    <label class="form-label">Unit of Sale (Pack / Unit Qty)</label>
    <input
        type="number"
        name="sale_unit"
        class="form-control"
        step="any"
        min="0"
        placeholder="e.g. 1"
        value="<%= (old && old.sale_unit) || '1' %>"
    >
</div>

</div>
</div>
</div>

<!-- CONDITIONAL SECTION: RENTAL INFORMATION (SHOWN ONLY IF PRODUCT TYPE = RENTAL) -->
<div class="card shadow-sm mb-4" id="rentalSectionCard" style="display: <%= (old && old.product_type === 'Rental') ? 'block' : 'none' %>;">
<div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h5 class="mb-0 fw-bold text-primary">
        <i class="bi bi-clock-history me-2"></i>Rental Rates & Durations
    </h5>
    <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold">Rental Specific</span>
</div>
<div class="card-body">
<input type="hidden" name="rental_available" id="rentalAvailable" value="<%= (old && old.product_type === 'Rental') ? 'yes' : 'no' %>">

<div id="rentalSection" class="mt-2">
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#hourlyTab">Hourly</button></li>
        <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#dailyTab">Daily</button></li>
        <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#weeklyTab">Weekly</button></li>
        <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#monthlyTab">Monthly</button></li>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        <% const periods = { hourly: 'Hourly', daily: 'Daily', weekly: 'Weekly', monthly: 'Monthly' }; %>
        <% let first = true; %>
        <% for (const [key, label] of Object.entries(periods)) { %>
        <div class="tab-pane fade <%= first ? 'show active' : '' %>" id="<%= key %>Tab">
            <div class="form-check form-switch mb-3">
                <input
                    class="form-check-input rental-available-checkbox"
                    type="checkbox"
                    name="rental_available_period[<%= key %>]"
                    id="rentalAvailable<%= key.charAt(0).toUpperCase() + key.slice(1) %>"
                    data-period="<%= key %>"
                    <%= (key === 'daily' || (old && old.rental_available_period && old.rental_available_period[key])) ? 'checked' : '' %>
                >
                <label class="form-check-label fw-semibold" for="rentalAvailable<%= key.charAt(0).toUpperCase() + key.slice(1) %>">Enable <%= label %> Rental</label>
            </div>

            <div class="rental-fields" id="rentalFields<%= key.charAt(0).toUpperCase() + key.slice(1) %>" style="<%= (key === 'daily' || (old && old.rental_available_period && old.rental_available_period[key])) ? 'display:block' : 'display:none' %>">
                <div class="row g-3">
                    <!-- RENTAL UNIT -->
                    <div class="col-12 col-md-4">
                        <label class="form-label">Rental Unit <span class="text-danger">*</span></label>
                        <select name="rental_unit_id[<%= key %>]" class="form-select searchable-select rental-required">
                            <option value="">Select Unit</option>
                            <% units.forEach(unit => { %>
                            <option value="<%= unit.id %>" <%= (unit.unit_name && unit.unit_name.toLowerCase().includes(key)) ? 'selected' : '' %>>
                                <%= unit.unit_code %> - <%= unit.unit_name %>
                            </option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- SECURITY DEPOSIT -->
                    <div class="col-12 col-md-4">
                        <label class="form-label">Security Deposit (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input
                                type="number"
                                name="security_deposit[<%= key %>]"
                                class="form-control rental-required"
                                step="0.01"
                                min="0"
                                placeholder="0.00"
                                value="<%= (old && old.security_deposit && old.security_deposit[key]) || '' %>"
                            >
                        </div>
                    </div>

                    <!-- RENTAL RATE -->
                    <div class="col-12 col-md-4">
                        <label class="form-label">Rental Rate (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input
                                type="number"
                                name="rental_rate[<%= key %>]"
                                class="form-control rental-required"
                                step="0.01"
                                min="0"
                                placeholder="0.00"
                                value="<%= (old && old.rental_rate && old.rental_rate[key]) || '' %>"
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% first = false; %>
        <% } %>
    </div>
</div>

</div>
</div>

<!-- SECTION 4 SPECIFICATIONS -->
<div class="card shadow-sm mb-4">
<div class="card-header">
    <h5 class="mb-0">Specifications</h5>
</div>
<div class="card-body">
<div class="row g-3">

<div class="col-12 col-md-4">
    <label class="form-label">Power Rating</label>
    <input type="text" name="power_rating" class="form-control" placeholder="e.g. 750W" value="<%= (old && old.power_rating) || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Voltage</label>
    <input type="text" name="voltage" class="form-control" placeholder="e.g. 220V" value="<%= (old && old.voltage) || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">RPM</label>
    <input type="text" name="rpm" class="form-control" placeholder="e.g. 11000 RPM" value="<%= (old && old.rpm) || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Chuck / Disc Size</label>
    <input type="text" name="chuck_disc_size" class="form-control" placeholder="Enter size" value="<%= (old && old.chuck_disc_size) || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Weight</label>
    <input type="text" name="weight" class="form-control" placeholder="e.g. 2.5 KG" value="<%= (old && old.weight) || '' %>">
</div>

<div class="col-12 col-md-4">
    <label class="form-label">Battery Capacity</label>
    <input type="text" name="battery_capacity" class="form-control" placeholder="e.g. 5Ah" value="<%= (old && old.battery_capacity) || '' %>">
</div>



</div>
</div>
</div>

<!-- SECTION 5 WARRANTY -->
<div class="card shadow-sm mb-4">
<div class="card-header">
    <h5 class="mb-0">Warranty & Maintenance</h5>
</div>
<div class="card-body">
<div class="row g-3">

<div class="col-12 col-md-4">
    <label class="form-label">Warranty Applicable</label>
    <select name="warranty_applicable" id="warrantyApplicable" class="form-select">
        <option value="no" <%= (old && old.warranty_applicable === 'no') ? 'selected' : '' %>>No</option>
        <option value="yes" <%= (old && old.warranty_applicable === 'yes') ? 'selected' : '' %>>Yes</option>
    </select>
</div>

<div class="col-12 col-md-4" id="warrantyMonthsWrapper" style="display:none">
    <label class="form-label">Warranty Period</label>
    <div class="input-group">
        <input
            type="number"
            name="warranty_months"
            class="form-control"
            min="0"
            step="1"
            placeholder="Enter months"
            value="<%= (old && old.warranty_months) || '' %>"
        >
        <span class="input-group-text">Month</span>
    </div>
</div>

</div>
</div>
</div>

<!-- BUTTONS -->
<div class="d-flex justify-content-end gap-2 mb-4">
    <a href="/products" class="btn btn-outline-secondary">Back</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i> Save
    </button>
</div>

</form>

</div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const status = document.getElementById('status');
    const statusLabel = document.getElementById('statusLabel');
    if (status && statusLabel) {
        status.addEventListener('change', function () {
            statusLabel.textContent = this.checked ? 'Active' : 'Inactive';
        });
    }

    const description = document.getElementById('description');
    const descriptionCount = document.getElementById('descriptionCount');
    if (description && descriptionCount) {
        description.addEventListener('input', function () {
            descriptionCount.textContent = this.value.length + ' / 2000';
        });
    }

    const productType = document.getElementById('productType');
    const salesSectionCard = document.getElementById('salesSectionCard');
    const rentalSectionCard = document.getElementById('rentalSectionCard');
    const saleAvailable = document.getElementById('saleAvailable');
    const rentalAvailable = document.getElementById('rentalAvailable');
    const sellingPrice = document.getElementById('sellingPrice');
    const saleRequired = document.querySelector('.sale-required');

    function updateProductTypeSections() {
        const type = productType ? productType.value : '';

        if (type === 'Sales') {
            if (salesSectionCard) salesSectionCard.style.display = 'block';
            if (rentalSectionCard) rentalSectionCard.style.display = 'none';
            if (saleAvailable) saleAvailable.value = 'yes';
            if (rentalAvailable) rentalAvailable.value = 'no';
            if (sellingPrice) {
                sellingPrice.required = true;
                if (saleRequired) saleRequired.style.display = 'inline';
            }
            // Remove required attributes from hidden rental inputs
            document.querySelectorAll('.rental-required').forEach(function (input) {
                input.required = false;
            });
        } else if (type === 'Rental') {
            if (salesSectionCard) salesSectionCard.style.display = 'none';
            if (rentalSectionCard) rentalSectionCard.style.display = 'block';
            if (saleAvailable) saleAvailable.value = 'no';
            if (rentalAvailable) rentalAvailable.value = 'yes';
            if (sellingPrice) {
                sellingPrice.required = false;
                if (saleRequired) saleRequired.style.display = 'none';
            }
            // Re-apply required attributes for active rental periods
            document.querySelectorAll('.rental-available-checkbox').forEach(function (checkbox) {
                const period = checkbox.dataset.period;
                const fields = document.getElementById('rentalFields' + period.charAt(0).toUpperCase() + period.slice(1));
                if (fields && checkbox.checked) {
                    fields.querySelectorAll('.rental-required').forEach(function (input) {
                        input.required = true;
                    });
                }
            });
        } else {
            if (salesSectionCard) salesSectionCard.style.display = 'none';
            if (rentalSectionCard) rentalSectionCard.style.display = 'none';
            if (saleAvailable) saleAvailable.value = '';
            if (rentalAvailable) rentalAvailable.value = '';
            if (sellingPrice) {
                sellingPrice.required = false;
                if (saleRequired) saleRequired.style.display = 'none';
            }
            document.querySelectorAll('.rental-required').forEach(function (input) {
                input.required = false;
            });
        }
    }

    if (productType) {
        productType.addEventListener('change', updateProductTypeSections);
        updateProductTypeSections();
    }

    const discountAllowed = document.getElementById('discountAllowed');
    const discountWrapper = document.getElementById('discountPercentWrapper');
    if (discountAllowed && discountWrapper) {
        discountAllowed.addEventListener('change', function () {
            discountWrapper.style.display = this.value === 'yes' ? 'block' : 'none';
        });
        if (discountAllowed.value === 'yes') {
            discountWrapper.style.display = 'block';
        }
    }

    document.querySelectorAll('.rental-available-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            const period = this.dataset.period;
            const fields = document.getElementById('rentalFields' + period.charAt(0).toUpperCase() + period.slice(1));
            if (fields) {
                if (this.checked) {
                    fields.style.display = 'block';
                    if (productType && productType.value === 'Rental') {
                        fields.querySelectorAll('.rental-required').forEach(function (input) {
                            input.required = true;
                        });
                    }
                } else {
                    fields.style.display = 'none';
                    fields.querySelectorAll('.rental-required').forEach(function (input) {
                        input.required = false;
                    });
                }
            }
        });
    });

    const warrantyApplicable = document.getElementById('warrantyApplicable');
    const warrantyWrapper = document.getElementById('warrantyMonthsWrapper');
    if (warrantyApplicable && warrantyWrapper) {
        warrantyApplicable.addEventListener('change', function () {
            warrantyWrapper.style.display = this.value === 'yes' ? 'block' : 'none';
        });
        if (warrantyApplicable.value === 'yes') {
            warrantyWrapper.style.display = 'block';
        }
    }

    // Initialize all SearchableSelect comboboxes on this page
    if (window.SearchableSelect) {
        window.SearchableSelect.init('.searchable-select');
    }
});
</script>

<%- include('includes/footer') %>
