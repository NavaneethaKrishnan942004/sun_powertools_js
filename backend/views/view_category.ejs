<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: '/' },
            { title: 'Master', link: '/masters' },
            { title: 'Category Master', link: '/categories' },
            { title: 'View' }
        ]) %>

        <!-- Page Heading -->
        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-1">View Category</h1>
                <p class="text-muted mb-0">View category details.</p>
            </div>
        </div>

        <% if (!category) { %>
            <div class="alert alert-danger">Category not found.</div>
            <a href="/categories" class="btn btn-secondary">Back</a>
        <% } else { %>
            <!-- Category Details -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="card-title mb-0">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-tags me-2 text-primary"></i>Category Details</h5>
                    </div>
                    <div class="card-header-actions">
                        <div class="d-flex gap-2">
                            <a href="/categories" class="btn btn-outline-secondary">Back</a>
                            <a href="/categories?edit=<%= category.id %>" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row g-4">
                        <!-- Category Code -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Category ID : <%= e(category.category_code) %>
                            </label>
                        </div>

                        <!-- Status -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Status : <% if (parseInt(category.status) === 1) { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Inactive</span>
                                <% } %>
                            </label>
                        </div>

                        <!-- Category Name -->
                        <div class="col-6">
                            <label class="form-label text-muted">
                                Category Name : <%= e(category.category_name) %>
                            </label>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label text-muted">
                                Description : <% if (category.description) { %>
                                    <%- nl2br(category.description) %>
                                <% } else { %>
                                    <span class="text-muted">-</span>
                                <% } %>
                            </label>
                        </div>

                        <!-- Created By -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Created By : <%= e(category.created_by_name || category.created_by || '-') %>
                            </label>
                        </div>

                        <!-- Created At -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Created At : <%= e(category.created_at) %>
                            </label>
                        </div>

                        <!-- Updated By -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Updated By : <%= e(category.updated_by_name || category.updated_by || '-') %>
                            </label>
                        </div>

                        <!-- Updated At -->
                        <div class="col-6 col-md-3">
                            <label class="form-label text-muted">
                                Updated At : <%= category.updated_at ? e(category.updated_at) : '-' %>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

    </div>
</main>

<%- include('includes/footer') %>
