<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: 'index.php' },
            { title: 'Sales Notes', link: 'manage_sales_note.php' },
            { title: 'Create Sales Note' }
        ]) %>

        <!-- PAGE TITLE -->
        <div class="page-heading d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">
                    <i class="bi bi-cart-plus text-primary me-2"></i>Create Sales Note
                </h1>
                
            </div>
            <div class="d-flex gap-2">
                <a href="manage_sales_note.php" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Sales Notes
                </a>
            </div>
        </div>

        <!-- VALIDATION ERRORS -->
        <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <strong class="fs-6">Please correct the following errors:</strong>
                </div>
                <ul class="mb-0 ps-3">
                    <% errors.forEach(err => { %>
                        <li><%= err %></li>
                    <% }) %>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- MAIN SALES NOTE FORM -->
        <form method="POST" action="create_sales_note.php" id="salesNoteForm" novalidate>
            <div class="row g-4">

                <!-- LEFT COLUMN: CUSTOMER SELECTION & PRODUCT ITEMS -->
                <div class="col-12 col-xl-8">

                    <!-- 1. CUSTOMER & NOTE META CARD -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-person-badge me-2"></i>1. Customer & Sales Info
                            </h5>
                            <button type="button" class="btn btn-sm btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#quickAddCustomerModal">
                                <i class="bi bi-plus-lg me-1"></i> Add Customer
                            </button>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <!-- Note Number (Auto-generated) -->
                                <!-- <div class="col-12 col-sm-6 col-md-4">
                                    <label class="form-label small fw-semibold">Sales Note #</label>
                                    <input type="text" class="form-control bg-surface-soft fw-bold text-primary" value="<%= salesNoteNo %>" readonly>
                                    <small class="text-muted">Auto-generated</small>
                                </div> -->

                                <!-- Single Sales Date & Time Field -->
                                <div class="col-12 col-md-5">
                                    <label class="form-label small fw-semibold">Sales Date & Time <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-surface"><i class="bi bi-calendar-event text-primary"></i></span>
                                        <input type="datetime-local" name="sales_datetime" id="salesDateTime" class="form-control" value="<%= typeof currentSalesDateTime !== 'undefined' ? currentSalesDateTime : `${salesDate}T${salesTime}` %>" required>
                                    </div>
                                    <small class="text-muted">Defaults to current date & time</small>
                                </div>

                                <!-- Customer Selection -->
                                <div class="col-12 col-md-7">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-semibold mb-0">
                                            Select Customer <span id="customerRequiredStar" class="text-danger <%= (typeof saleType !== 'undefined' && saleType === 'credit') ? '' : 'd-none' %>">*</span>
                                        </label>
                                        <span class="badge <%= (typeof saleType !== 'undefined' && saleType === 'credit') ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-light text-secondary border' %> small" id="customerOptionalBadge">
                                            <%= (typeof saleType !== 'undefined' && saleType === 'credit') ? 'Required for Credit Sale' : 'Optional for Normal Sale' %>
                                        </span>
                                    </div>
                                    <select name="customer_id" id="customerSelect" class="form-select select2-customer">
                                        <option value="">-- Walk-in / Retail Customer (No Customer) --</option>
                                        <% customersList.forEach(c => { %>
                                            <option value="<%= c.id %>" <%= Number(selectedCustomerId) === Number(c.id) ? 'selected' : '' %>>
                                                <%= c.customer_code %> - <%= c.customer_name %> (<%= c.mobile_number %>)
                                            </option>
                                        <% }) %>
                                    </select>
                                    <div id="customerValidationFeedback" class="text-danger small mt-1 d-none">
                                        <i class="bi bi-exclamation-circle me-1"></i>Customer selection is required for Credit Sale.
                                    </div>
                                </div>
                            </div>

                            <!-- DYNAMIC CUSTOMER CREDIT PROFILE WIDGET -->
                            <div id="customerProfileBox" class="mt-4 p-3 rounded-3 border bg-surface-soft d-none">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
                                    <div>
                                        <h6 class="fw-bold mb-0 text-body" id="dispCustName">Customer Name</h6>
                                        <span class="text-muted small" id="dispCustCode">CUS-001</span> &bull;
                                        <span class="text-muted small" id="dispCustMobile">9876543210</span>
                                    </div>
                                    <div id="dispCreditBadge">
                                        <span class="badge bg-success-subtle text-success">Credit Allowed</span>
                                    </div>
                                </div>

                                <div class="row g-2 text-center">
                                    <!-- Credit Limit -->
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 bg-surface rounded border">
                                            <span class="text-muted small d-block">Credit Limit</span>
                                            <strong class="fs-6 text-body" id="dispCreditLimit">₹0.00</strong>
                                        </div>
                                    </div>
                                    <!-- Existing Outstanding -->
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 bg-surface rounded border">
                                            <span class="text-muted small d-block">Existing Outstanding</span>
                                            <strong class="fs-6 text-danger" id="dispPrevOutstanding">₹0.00</strong>
                                        </div>
                                    </div>
                                    <!-- Available Credit -->
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 bg-surface rounded border">
                                            <span class="text-muted small d-block">Available Credit</span>
                                            <strong class="fs-6 text-success" id="dispAvailableCredit">₹0.00</strong>
                                        </div>
                                    </div>
                                    <!-- New Projected Outstanding -->
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 bg-surface rounded border">
                                            <span class="text-muted small d-block">New Outstanding</span>
                                            <strong class="fs-6 text-primary" id="dispNewOutstanding">₹0.00</strong>
                                        </div>
                                    </div>
                                </div>

                                <!-- Customer Address & Terms -->
                                <div class="mt-2 small text-muted d-flex flex-wrap justify-content-between">
                                    <span><i class="bi bi-geo-alt me-1"></i><span id="dispCustAddress">Address</span></span>
                                    <span><i class="bi bi-clock me-1"></i>Terms: <span id="dispPaymentTerms" class="fw-semibold">Immediate</span></span>
                                </div>

                                <!-- Real-time Credit Warning Box -->
                                <div id="creditAlertBanner" class="alert alert-warning d-flex align-items-center gap-2 mt-3 mb-0 d-none" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                                    <div id="creditAlertMessage" class="small fw-medium">Credit Limit Message</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. PRODUCT SELECTION & ITEMS LIST CARD -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-box-seam me-2"></i>2. Product Items Selection
                            </h5>
                            <span class="badge bg-primary-subtle text-primary rounded-pill" id="itemCountBadge">0 Items</span>
                        </div>
                        <div class="card-body p-4">

                            <!-- Product Adder Selector -->
                            <div class="p-3 bg-surface-soft rounded-3 border mb-4">
                                <div class="row g-2 align-items-end">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold">Choose Product to Add</label>
                                        <select id="quickProductSelect" class="form-select">
                                            <option value="">-- Search / Select Product --</option>
                                            <% productsList.forEach(p => { %>
                                                <option value="<%= p.id %>"
                                                    data-code="<%= p.product_code %>"
                                                    data-name="<%= p.product_name %>"
                                                    data-price="<%= p.selling_price %>"
                                                    data-stock="<%= p.stock_quantity %>"
                                                    data-unit="<%= p.unit_name || 'Unit' %>"
                                                    data-discount="<%= p.discount_percent || 0 %>"
                                                    data-category="<%= p.category_name || '' %>"
                                                    data-brand="<%= p.brand_name || '' %>">
                                                    <%= p.product_code %> - <%= p.product_name %> (Stock: <%= Number(p.stock_quantity) %> | ₹<%= numberFormat(p.selling_price, 2) %>)
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label small fw-semibold">Stock Qty</label>
                                        <input type="text" id="quickStockDisplay" class="form-control bg-surface text-center fw-bold" readonly placeholder="-">
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label small fw-semibold">Qty to Add</label>
                                        <input type="number" id="quickQuantityInput" class="form-control text-center fw-bold" value="1" min="1" step="1">
                                    </div>
                                    <div class="col-12 col-md-2">
                                        <button type="button" id="addProductBtn" class="btn btn-primary w-100 fw-semibold">
                                            <i class="bi bi-plus-circle me-1"></i> Add
                                        </button>
                                    </div>
                                </div>
                                <div id="stockErrorAlert" class="text-danger small mt-2 d-none fw-semibold">
                                    <i class="bi bi-exclamation-circle me-1"></i><span id="stockErrorText">Insufficient stock.</span>
                                </div>
                            </div>

                            <!-- Line Items Table -->
                            <div class="table-responsive">
                                <table class="table table-bordered align-middle mb-0" id="itemsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="product-col-readable" style="min-width: 220px; width: 35%;">Product</th>
                                            <th class="text-center" style="width: 12%;">Qty</th>
                                            <th class="text-end" style="width: 15%;">Rate (₹)</th>
                                            <th class="text-end" style="width: 12%;">Disc (₹)</th>
                                            <th class="text-center" style="width: 10%;">GST %</th>
                                            <th class="text-end" style="width: 16%;">Amount (₹)</th>
                                            <th class="text-center" style="width: 5%;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="itemsTableBody">
                                        <!-- Dynamic Product Rows Injected Here via JS -->
                                        <tr id="noItemsRow">
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                <i class="bi bi-cart-x fs-3 d-block mb-1 text-muted"></i>
                                                No products added yet. Select a product above to add to this sales note.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- RIGHT COLUMN: PAYMENT, TOTALS & CONFIRMATION -->
                <div class="col-12 col-xl-4">

                    <!-- SUMMARY & FINANCIAL TOTALS CARD -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 position-sticky" style="top: 20px;">
                        <div class="card-header bg-surface py-3 px-4 border-bottom">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-calculator me-2"></i>3. Payment & Totals
                            </h5>
                        </div>
                        <div class="card-body p-4">

                            <!-- Cost Breakdown -->
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Subtotal:</span>
                                <span class="fw-bold text-body" id="summarySubtotal">₹0.00</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Item Discount:</span>
                                <span class="text-success fw-semibold" id="summaryDiscount">- ₹0.00</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">GST / Tax:</span>
                                <span class="text-body fw-semibold" id="summaryTax">+ ₹0.00</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted">Other Charges:</span>
                                <div style="width: 110px;">
                                    <input type="number" name="other_charges" id="otherChargesInput" class="form-control form-control-sm text-end" value="<%= otherCharges %>" min="0" step="0.01">
                                </div>
                            </div>

                            <hr class="my-3">

                            <!-- Calculated Grand Total -->
                            <div class="d-flex justify-content-between align-items-center mb-2 p-3 bg-surface-soft rounded-3 border">
                                <div>
                                    <span class="fs-6 fw-bold text-muted d-block">Calculated Grand Total:</span>
                                    <small class="text-muted">Based on items, tax & charges</small>
                                </div>
                                <span class="fs-4 fw-bold text-body" id="summaryGrandTotal">₹0.00</span>
                            </div>

                            <!-- Adjusted / Final Grand Total (Editable) -->
                            <div class="p-3 bg-surface rounded-3 border border-primary mb-3 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold text-primary mb-0" for="finalGrandTotalInput">
                                        <i class="bi bi-pencil-square me-1"></i>Adjusted / Final Grand Total <span class="text-danger">*</span>
                                    </label>
                                    <span id="discountPercentBadge" class="badge bg-light text-secondary border px-2 py-1 small">
                                        Discount: 0% (₹0.00)
                                    </span>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white fw-bold">₹</span>
                                    <input type="number" name="final_grand_total" id="finalGrandTotalInput" class="form-control form-control-lg fw-extrabold text-primary" step="0.01" min="0.01" placeholder="0.00" value="<%= typeof finalGrandTotal !== 'undefined' ? finalGrandTotal : '' %>" required>
                                    <button type="button" class="btn btn-outline-secondary" id="resetFinalTotalBtn" title="Reset to calculated grand total">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                </div>
                                <div id="finalTotalError" class="text-danger small mt-1 d-none fw-semibold">
                                    <i class="bi bi-exclamation-circle me-1"></i><span id="finalTotalErrorText"></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                                    <span>Discount Amount: <strong class="text-success" id="effectiveDiscountAmount">₹0.00</strong></span>
                                    <span>Discount Applied: <strong class="text-success" id="effectiveDiscountRate">0%</strong></span>
                                </div>
                            </div>

                            <% const currentSaleType = (typeof saleType !== 'undefined' && saleType) ? saleType : 'sale'; %>
                            <!-- SALE VS CREDIT SALE SELECTION (Placed after Grand Total) -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold d-block">Sale Type <span class="text-danger">*</span></label>
                                <div class="btn-group w-100" role="group" aria-label="Sale Type Selection">
                                    <input type="radio" class="btn-check" name="sale_type" id="saleTypeNormal" value="sale" <%= (currentSaleType === 'sale') ? 'checked' : '' %> autocomplete="off">
                                    <label class="btn btn-outline-success fw-bold py-2 text-center" for="saleTypeNormal">
                                        <i class="bi bi-cash-stack me-1"></i> Normal Sale
                                    </label>

                                    <input type="radio" class="btn-check" name="sale_type" id="saleTypeCredit" value="credit" <%= (currentSaleType === 'credit') ? 'checked' : '' %> autocomplete="off">
                                    <label class="btn btn-outline-primary fw-bold py-2 text-center" for="saleTypeCredit">
                                        <i class="bi bi-credit-card-2-front me-1"></i> Credit Sale
                                    </label>
                                </div>
                                <div class="small text-muted mt-1" id="saleTypeNote">
                                    <i class="bi bi-info-circle me-1"></i>Standard selling price workflow with full payment. Customer selection is optional.
                                </div>
                            </div>

                            <!-- NORMAL SALE PAYMENT METHOD -->
                            <div id="normalSalePaymentBox" class="mb-3 <%= (currentSaleType === 'credit') ? 'd-none' : '' %>">
                                <label class="form-label small fw-semibold">Payment Method <span class="text-danger">*</span></label>
                                <select name="payment_type" id="paymentTypeSelect" class="form-select fw-semibold">
                                    <option value="Cash" <%= paymentType === 'Cash' ? 'selected' : '' %>>Cash (Full Payment)</option>
                                    <option value="UPI" <%= paymentType === 'UPI' ? 'selected' : '' %>>UPI / QR Code</option>
                                    <option value="Card" <%= paymentType === 'Card' ? 'selected' : '' %>>Credit / Debit Card</option>
                                    <option value="Bank Transfer" <%= paymentType === 'Bank Transfer' ? 'selected' : '' %>>Bank Transfer / NEFT</option>
                                </select>
                            </div>

                            <!-- CREDIT SALE DETAILS BOX -->
                            <div id="creditSaleDetailsBox" class="mb-3 p-3 bg-surface-soft rounded-3 border border-primary-subtle <%= (currentSaleType === 'credit') ? '' : 'd-none' %>">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <span class="fw-bold text-primary small"><i class="bi bi-credit-card me-1"></i> Credit Sale Terms</span>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Customer Required</span>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Amount Received Now (₹)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-surface">₹</span>
                                        <input type="number" name="amount_received" id="amountReceivedInput" class="form-control fw-bold text-success" value="<%= typeof amountReceived !== 'undefined' ? amountReceived : '0.00' %>" min="0" step="0.01" placeholder="0.00">
                                    </div>
                                    <div id="amountReceivedError" class="text-danger small mt-1 d-none">
                                        <i class="bi bi-exclamation-circle me-1"></i>Amount Received cannot exceed Final Grand Total.
                                    </div>
                                    <small class="text-muted d-block mt-0.5">Enter 0 for full credit, or partial amount received.</small>
                                </div>

                                <div class="mb-2" id="creditPaymentMethodGroup">
                                    <label class="form-label small fw-semibold">Payment Method for Received Amount</label>
                                    <select name="payment_method" id="creditPaymentMethod" class="form-select form-select-sm">
                                        <option value="Cash">Cash</option>
                                        <option value="UPI">UPI / QR Code</option>
                                        <option value="Card">Card</option>
                                        <option value="Bank Transfer">Bank Transfer</option>
                                    </select>
                                </div>

                                <!-- Prominent Balance to Pay Warning Panel -->
                                <div class="balance-highlight-card my-3" id="balanceHighlightBox">
                                    <div class="balance-title">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Balance to Pay
                                    </div>
                                    <div class="balance-value" id="prominentBalanceToPay">
                                        ₹0.00
                                    </div>
                                    <div class="balance-desc">
                                        Customer needs to pay this remaining amount.
                                    </div>
                                </div>

                                <div class="p-2 bg-surface rounded border d-flex justify-content-between align-items-center mt-2">
                                    <span class="text-muted small">Credit Amount (Balance):</span>
                                    <strong class="fs-6 text-danger" id="dispCreditAmount">₹0.00</strong>
                                </div>
                            </div>

                            <!-- Customer Balance Impact Preview -->
                            <div class="p-3 bg-surface-soft rounded-3 border mb-3 small" id="customerImpactCard">
                                <div class="fw-bold mb-2 text-body d-flex justify-content-between">
                                    <span>Customer Balance Impact:</span>
                                    <span id="custImpactStatus" class="badge bg-secondary-subtle text-secondary">Walk-in</span>
                                </div>
                                <div id="custImpactDetails">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Previous Outstanding:</span>
                                        <strong id="sidePrevBal">₹0.00</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">+ Credit from this Sale:</span>
                                        <strong class="text-danger" id="sideCreditAdded">₹0.00</strong>
                                    </div>
                                    <div class="d-flex justify-content-between border-top pt-1 mt-1">
                                        <span class="fw-bold">New Total Outstanding:</span>
                                        <strong class="text-primary fw-bold" id="sideNewBal">₹0.00</strong>
                                    </div>
                                </div>
                                <div id="custImpactWalkinNotice" class="text-muted small d-none">
                                    <i class="bi bi-info-circle me-1"></i>Walk-in customer sale. No customer ledger entry created.
                                </div>
                            </div>

                            <!-- Manager Credit Override Checkbox -->
                            <div id="overrideBox" class="form-check p-3 bg-danger-subtle text-danger rounded-3 border border-danger-subtle mb-3 <%= creditOverride ? '' : 'd-none' %>">
                                <input class="form-check-input ms-0 me-2" type="checkbox" name="credit_override" id="creditOverrideChk" value="1" <%= creditOverride ? 'checked' : '' %>>
                                <label class="form-check-label small fw-bold" for="creditOverrideChk">
                                    Authorize Credit Limit Override
                                </label>
                                <div class="small mt-1 text-danger-emphasis">
                                    Sale exceeds customer's credit limit. Check this box to authorize and record this transaction.
                                </div>
                            </div>

                            <!-- Notes / Remarks -->
                            <div class="mb-4">
                                <label class="form-label small fw-semibold">Notes / Remarks</label>
                                <textarea name="notes" class="form-control" rows="2" placeholder="Optional notes for customer or invoice..."><%= notes %></textarea>
                            </div>

                            <!-- Save / Submit Button -->
                            <button type="submit" id="saveSaleBtn" class="btn btn-primary w-100 py-2.5 fw-bold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Save & Generate Sales Note
                            </button>

                        </div>
                    </div>

                </div>

            </div>
        </form>

    </div>
</main>

<!-- JAVASCRIPT LOGIC FOR SALES NOTE INTERACTION -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    let currentCustomer = null;
    let items = []; // Line items array

    const salesNoteForm = document.getElementById('salesNoteForm');
    const customerSelect = document.getElementById('customerSelect');
    const customerProfileBox = document.getElementById('customerProfileBox');
    const dispCustName = document.getElementById('dispCustName');
    const dispCustCode = document.getElementById('dispCustCode');
    const dispCustMobile = document.getElementById('dispCustMobile');
    const dispCustAddress = document.getElementById('dispCustAddress');
    const dispPaymentTerms = document.getElementById('dispPaymentTerms');
    const dispCreditBadge = document.getElementById('dispCreditBadge');
    const dispCreditLimit = document.getElementById('dispCreditLimit');
    const dispPrevOutstanding = document.getElementById('dispPrevOutstanding');
    const dispAvailableCredit = document.getElementById('dispAvailableCredit');
    const dispNewOutstanding = document.getElementById('dispNewOutstanding');
    const creditAlertBanner = document.getElementById('creditAlertBanner');
    const creditAlertMessage = document.getElementById('creditAlertMessage');

    const quickProductSelect = document.getElementById('quickProductSelect');
    const quickStockDisplay = document.getElementById('quickStockDisplay');
    const quickQuantityInput = document.getElementById('quickQuantityInput');
    const addProductBtn = document.getElementById('addProductBtn');
    const stockErrorAlert = document.getElementById('stockErrorAlert');
    const stockErrorText = document.getElementById('stockErrorText');

    const itemsTableBody = document.getElementById('itemsTableBody');
    const itemCountBadge = document.getElementById('itemCountBadge');
    const summarySubtotal = document.getElementById('summarySubtotal');
    const summaryDiscount = document.getElementById('summaryDiscount');
    const summaryTax = document.getElementById('summaryTax');
    const otherChargesInput = document.getElementById('otherChargesInput');
    const summaryGrandTotal = document.getElementById('summaryGrandTotal');

    // Final Grand Total & Discount Elements
    const finalGrandTotalInput = document.getElementById('finalGrandTotalInput');
    const resetFinalTotalBtn = document.getElementById('resetFinalTotalBtn');
    const discountPercentBadge = document.getElementById('discountPercentBadge');
    const finalTotalError = document.getElementById('finalTotalError');
    const finalTotalErrorText = document.getElementById('finalTotalErrorText');
    const effectiveDiscountAmount = document.getElementById('effectiveDiscountAmount');
    const effectiveDiscountRate = document.getElementById('effectiveDiscountRate');
    const prominentBalanceToPay = document.getElementById('prominentBalanceToPay');
    const balanceHighlightBox = document.getElementById('balanceHighlightBox');

    let isFinalTotalManuallyEdited = Boolean(finalGrandTotalInput && finalGrandTotalInput.value.trim() !== '');

    // Sale Type & Payment Elements
    const saleTypeNormal = document.getElementById('saleTypeNormal');
    const saleTypeCredit = document.getElementById('saleTypeCredit');
    const saleTypeNote = document.getElementById('saleTypeNote');
    const normalSalePaymentBox = document.getElementById('normalSalePaymentBox');
    const creditSaleDetailsBox = document.getElementById('creditSaleDetailsBox');
    const paymentTypeSelect = document.getElementById('paymentTypeSelect');
    const amountReceivedInput = document.getElementById('amountReceivedInput');
    const amountReceivedError = document.getElementById('amountReceivedError');
    const dispCreditAmount = document.getElementById('dispCreditAmount');

    // Customer Validation & Impact Elements
    const customerRequiredStar = document.getElementById('customerRequiredStar');
    const customerOptionalBadge = document.getElementById('customerOptionalBadge');
    const customerValidationFeedback = document.getElementById('customerValidationFeedback');
    const custImpactStatus = document.getElementById('custImpactStatus');
    const custImpactDetails = document.getElementById('custImpactDetails');
    const custImpactWalkinNotice = document.getElementById('custImpactWalkinNotice');
    const sidePrevBal = document.getElementById('sidePrevBal');
    const sideCreditAdded = document.getElementById('sideCreditAdded');
    const sideNewBal = document.getElementById('sideNewBal');
    const overrideBox = document.getElementById('overrideBox');

    // 1. CUSTOMER SELECTION & AJAX FETCH
    function loadCustomerDetails(customerId) {
        if (!customerId) {
            customerProfileBox.classList.add('d-none');
            currentCustomer = null;
            if (saleTypeCredit && saleTypeCredit.checked) {
                customerValidationFeedback.classList.remove('d-none');
            }
            recalculateAll();
            return;
        }

        customerValidationFeedback.classList.add('d-none');

        fetch('ajax_sales_note.php?action=get_customer&customer_id=' + customerId)
            .then(res => res.json())
            .then(data => {
                if (data.success && data.customer) {
                    currentCustomer = data.customer;
                    dispCustName.textContent = currentCustomer.customer_name + (currentCustomer.company_name ? ' (' + currentCustomer.company_name + ')' : '');
                    dispCustCode.textContent = currentCustomer.customer_code;
                    dispCustMobile.textContent = currentCustomer.mobile_number;
                    dispCustAddress.textContent = currentCustomer.address;
                    dispPaymentTerms.textContent = currentCustomer.payment_terms || 'Immediate';
                    dispCreditLimit.textContent = '₹' + parseFloat(currentCustomer.credit_limit).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                    dispPrevOutstanding.textContent = '₹' + parseFloat(currentCustomer.current_outstanding).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                    dispAvailableCredit.textContent = '₹' + parseFloat(currentCustomer.available_credit).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});

                    // Credit allowed toggle
                    if (parseInt(currentCustomer.credit_allowed) === 1) {
                        dispCreditBadge.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle">Credit Allowed</span>';
                    } else {
                        dispCreditBadge.innerHTML = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle">No Credit Allowed</span>';
                    }

                    customerProfileBox.classList.remove('d-none');
                    recalculateAll();
                } else {
                    alert('Error loading customer: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(err => console.error('AJAX Customer Error:', err));
    }

    customerSelect.addEventListener('change', function() {
        loadCustomerDetails(this.value);
    });

    if (customerSelect.value) {
        loadCustomerDetails(customerSelect.value);
    }

    // 2. SALE TYPE TOGGLE (Normal Sale vs Credit Sale)
    function updateSaleTypeUI() {
        const isCredit = saleTypeCredit && saleTypeCredit.checked;
        if (isCredit) {
            creditSaleDetailsBox.classList.remove('d-none');
            normalSalePaymentBox.classList.add('d-none');
            if (customerRequiredStar) customerRequiredStar.classList.remove('d-none');
            if (customerOptionalBadge) {
                customerOptionalBadge.textContent = 'Required for Credit Sale';
                customerOptionalBadge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle small';
            }
            if (saleTypeNote) {
                saleTypeNote.innerHTML = '<i class="bi bi-info-circle me-1"></i>Credit sale. Enter amount received now (if any); remaining balance becomes customer credit. Customer is required.';
            }
            if (!customerSelect.value) {
                customerValidationFeedback.classList.remove('d-none');
            } else {
                customerValidationFeedback.classList.add('d-none');
            }
        } else {
            creditSaleDetailsBox.classList.add('d-none');
            normalSalePaymentBox.classList.remove('d-none');
            if (customerRequiredStar) customerRequiredStar.classList.add('d-none');
            if (customerOptionalBadge) {
                customerOptionalBadge.textContent = 'Optional for Unknown Customer Sale';
                customerOptionalBadge.className = 'badge bg-light text-secondary border small';
            }
            if (saleTypeNote) {
                saleTypeNote.innerHTML = '<i class="bi bi-info-circle me-1"></i>Standard selling price workflow with full payment. Customer selection is optional.';
            }
            if (customerValidationFeedback) customerValidationFeedback.classList.add('d-none');
            if (amountReceivedError) amountReceivedError.classList.add('d-none');
        }
        recalculateAll();
    }

    if (saleTypeNormal) saleTypeNormal.addEventListener('change', updateSaleTypeUI);
    if (saleTypeCredit) saleTypeCredit.addEventListener('change', updateSaleTypeUI);

    // 3. PRODUCT SELECTOR CHANGE
    quickProductSelect.addEventListener('change', function() {
        stockErrorAlert.classList.add('d-none');
        const opt = this.options[this.selectedIndex];
        if (!opt || !opt.value) {
            quickStockDisplay.value = '-';
            return;
        }
        const stock = parseFloat(opt.dataset.stock) || 0;
        quickStockDisplay.value = stock;
        quickQuantityInput.max = stock;
    });

    // 4. ADD PRODUCT TO ITEMS TABLE
    addProductBtn.addEventListener('click', function() {
        stockErrorAlert.classList.add('d-none');
        const opt = quickProductSelect.options[quickProductSelect.selectedIndex];
        if (!opt || !opt.value) {
            alert('Please select a product first.');
            return;
        }

        const productId = parseInt(opt.value);
        const code = opt.dataset.code;
        const name = opt.dataset.name;
        const rate = parseFloat(opt.dataset.price) || 0;
        const stock = parseFloat(opt.dataset.stock) || 0;
        const unit = opt.dataset.unit || 'Unit';
        const defaultDiscount = parseFloat(opt.dataset.discount) || 0;
        const qty = parseFloat(quickQuantityInput.value) || 1;

        // Check if already in table
        const existingItem = items.find(i => i.product_id === productId);
        const currentQtyInTable = existingItem ? existingItem.quantity : 0;
        const newTotalQty = currentQtyInTable + qty;

        if (newTotalQty > stock) {
            stockErrorText.textContent = `Insufficient stock for "${name}". Available: ${stock}, Requested: ${newTotalQty}`;
            stockErrorAlert.classList.remove('d-none');
            return;
        }

        if (existingItem) {
            existingItem.quantity = newTotalQty;
        } else {
            const lineDisc = defaultDiscount > 0 ? (rate * qty * defaultDiscount) / 100 : 0.00;
            items.push({
                product_id: productId,
                product_code: code,
                product_name: name,
                unit_name: unit,
                stock: stock,
                quantity: qty,
                unit_price: rate,
                discount: lineDisc,
                tax_percent: 0.00
            });
        }

        // Reset quick adder
        quickProductSelect.value = '';
        quickStockDisplay.value = '-';
        quickQuantityInput.value = 1;

        renderItemsTable();
        recalculateAll();
    });

    // 5. RENDER ITEMS TABLE
    function renderItemsTable() {
        if (items.length === 0) {
            itemsTableBody.innerHTML = `
                <tr id="noItemsRow">
                    <td colspan="7" class="text-center py-4 text-muted">
                        <i class="bi bi-cart-x fs-3 d-block mb-1 text-muted"></i>
                        No products added yet. Select a product above to add to this sales note.
                    </td>
                </tr>
            `;
            itemCountBadge.textContent = '0 Items';
            return;
        }

        let html = '';
        items.forEach((item, idx) => {
            const lineSub = item.quantity * item.unit_price;
            const lineDisc = Math.min(lineSub, parseFloat(item.discount) || 0);
            const taxable = Math.max(0, lineSub - lineDisc);
            const lineTax = (taxable * (parseFloat(item.tax_percent) || 0)) / 100;
            const lineTotal = taxable + lineTax;

            html += `
                <tr data-index="${idx}">
                    <td class="product-col-readable" style="min-width: 220px;">
                        <input type="hidden" name="items[${idx}][product_id]" value="${item.product_id}">
                        <span class="badge bg-secondary-subtle text-secondary me-1">${escapeHtml(item.product_code)}</span>
                        <strong class="text-body">${escapeHtml(item.product_name)}</strong>
                        <div class="small text-muted">Stock: ${item.stock} ${escapeHtml(item.unit_name)}</div>
                    </td>
                    <td class="text-center">
                        <input type="number" name="items[${idx}][quantity]" class="form-control form-control-sm text-center item-qty" 
                               value="${item.quantity}" min="1" max="${item.stock}" step="1" data-index="${idx}">
                    </td>
                    <td class="text-end">
                        <input type="hidden" name="items[${idx}][unit_price]" value="${item.unit_price}">
                        ₹${item.unit_price.toFixed(2)}
                    </td>
                    <td class="text-end">
                        <input type="number" name="items[${idx}][discount]" class="form-control form-control-sm text-end item-disc" 
                               value="${item.discount.toFixed(2)}" min="0" step="0.01" data-index="${idx}">
                    </td>
                    <td class="text-center">
                        <select name="items[${idx}][tax_percent]" class="form-select form-select-sm item-tax text-center" data-index="${idx}">
                            <option value="0" ${item.tax_percent === 0 ? 'selected' : ''}>0%</option>
                            <option value="5" ${item.tax_percent === 5 ? 'selected' : ''}>5%</option>
                            <option value="12" ${item.tax_percent === 12 ? 'selected' : ''}>12%</option>
                            <option value="18" ${item.tax_percent === 18 ? 'selected' : ''}>18%</option>
                            <option value="28" ${item.tax_percent === 28 ? 'selected' : ''}>28%</option>
                        </select>
                    </td>
                    <td class="text-end fw-bold text-body">
                        ₹${lineTotal.toFixed(2)}
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger item-remove-btn" data-index="${idx}" title="Remove Product">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </td>
                </tr>
            `;
        });

        itemsTableBody.innerHTML = html;
        itemCountBadge.textContent = `${items.length} Item${items.length > 1 ? 's' : ''}`;

        // Bind table row inputs
        document.querySelectorAll('.item-qty').forEach(input => {
            input.addEventListener('change', function() {
                const idx = parseInt(this.dataset.index);
                let val = parseFloat(this.value) || 1;
                if (val > items[idx].stock) {
                    alert(`Quantity exceeds available stock (${items[idx].stock}). Adjusted to maximum.`);
                    val = items[idx].stock;
                    this.value = val;
                }
                items[idx].quantity = Math.max(1, val);
                renderItemsTable();
                recalculateAll();
            });
        });

        document.querySelectorAll('.item-disc').forEach(input => {
            input.addEventListener('change', function() {
                const idx = parseInt(this.dataset.index);
                items[idx].discount = Math.max(0, parseFloat(this.value) || 0);
                renderItemsTable();
                recalculateAll();
            });
        });

        document.querySelectorAll('.item-tax').forEach(select => {
            select.addEventListener('change', function() {
                const idx = parseInt(this.dataset.index);
                items[idx].tax_percent = parseFloat(this.value) || 0;
                renderItemsTable();
                recalculateAll();
            });
        });

        document.querySelectorAll('.item-remove-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const idx = parseInt(this.dataset.index);
                items.splice(idx, 1);
                renderItemsTable();
                recalculateAll();
            });
        });
    }

    // 6. RECALCULATE FINANCIALS & REAL-TIME CREDIT LOGIC
    function recalculateAll() {
        let subtotal = 0;
        let totalDiscount = 0;
        let totalTax = 0;

        items.forEach(item => {
            const lineSub = item.quantity * item.unit_price;
            const lineDisc = Math.min(lineSub, parseFloat(item.discount) || 0);
            const taxable = Math.max(0, lineSub - lineDisc);
            const lineTax = (taxable * (parseFloat(item.tax_percent) || 0)) / 100;

            subtotal += lineSub;
            totalDiscount += lineDisc;
            totalTax += lineTax;
        });

        const otherCharges = Math.max(0, parseFloat(otherChargesInput.value) || 0);
        const calculatedGrandTotal = Math.max(0, (subtotal - totalDiscount) + totalTax + otherCharges);

        summarySubtotal.textContent = '₹' + subtotal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        summaryDiscount.textContent = '- ₹' + totalDiscount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        summaryTax.textContent = '+ ₹' + totalTax.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        summaryGrandTotal.textContent = '₹' + calculatedGrandTotal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});

        // Determine Final Grand Total
        let finalTotal;
        const rawFinalValue = (finalGrandTotalInput && finalGrandTotalInput.value !== undefined) ? finalGrandTotalInput.value.trim() : '';

        // If not manually edited by user or empty, automatically sync with calculatedGrandTotal
        if (!isFinalTotalManuallyEdited || rawFinalValue === '') {
            finalTotal = calculatedGrandTotal;
            if (finalGrandTotalInput) {
                finalGrandTotalInput.value = calculatedGrandTotal > 0 ? calculatedGrandTotal.toFixed(2) : '0.00';
            }
        } else {
            finalTotal = parseFloat(rawFinalValue);
            if (isNaN(finalTotal)) finalTotal = calculatedGrandTotal;
        }

        // Validate Final Grand Total & Calculate Effective Discount Percentage
        if (finalTotal <= 0 && items.length > 0) {
            if (finalTotalError && finalTotalErrorText) {
                finalTotalErrorText.textContent = 'Final Grand Total must be greater than ₹0.00.';
                finalTotalError.classList.remove('d-none');
            }
            if (discountPercentBadge) {
                discountPercentBadge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small';
                discountPercentBadge.textContent = 'Invalid Total';
            }
            if (effectiveDiscountAmount) effectiveDiscountAmount.textContent = '₹0.00';
            if (effectiveDiscountRate) effectiveDiscountRate.textContent = '0%';
        } else if (finalTotal > calculatedGrandTotal + 0.01) {
            if (finalTotalError && finalTotalErrorText) {
                finalTotalErrorText.textContent = `Final Grand Total (₹${finalTotal.toFixed(2)}) cannot exceed calculated Grand Total (₹${calculatedGrandTotal.toFixed(2)}).`;
                finalTotalError.classList.remove('d-none');
            }
            if (discountPercentBadge) {
                discountPercentBadge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small';
                discountPercentBadge.textContent = 'Invalid (Negative Discount)';
            }
            if (effectiveDiscountAmount) effectiveDiscountAmount.textContent = '₹0.00';
            if (effectiveDiscountRate) effectiveDiscountRate.textContent = '0%';
        } else {
            if (finalTotalError) finalTotalError.classList.add('d-none');
            const discountAmt = Math.max(0, calculatedGrandTotal - finalTotal);
            const discountPct = calculatedGrandTotal > 0 ? (discountAmt / calculatedGrandTotal) * 100 : 0;

            if (effectiveDiscountAmount) {
                effectiveDiscountAmount.textContent = '₹' + discountAmt.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            }
            if (effectiveDiscountRate) {
                effectiveDiscountRate.textContent = discountPct.toFixed(2) + '%';
            }

            if (discountPercentBadge) {
                if (discountAmt > 0.001) {
                    discountPercentBadge.className = 'badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small';
                    discountPercentBadge.textContent = `Discount: ${discountPct.toFixed(1)}% (₹${discountAmt.toFixed(2)})`;
                } else {
                    discountPercentBadge.className = 'badge bg-light text-secondary border px-2 py-1 small';
                    discountPercentBadge.textContent = 'Discount: 0% (₹0.00)';
                }
            }
        }

        const isCredit = saleTypeCredit && saleTypeCredit.checked;
        let paidAmount = 0.00;
        let creditAmount = 0.00;

        if (!isCredit) {
            paidAmount = finalTotal;
            creditAmount = 0.00;
            if (amountReceivedError) amountReceivedError.classList.add('d-none');
        } else {
            let received = parseFloat(amountReceivedInput.value);
            if (isNaN(received) || received < 0) {
                received = 0.00;
            }
            if (received > finalTotal + 0.01) {
                if (amountReceivedError) {
                    amountReceivedError.innerHTML = `<i class="bi bi-exclamation-circle me-1"></i>Amount Received (₹${received.toFixed(2)}) cannot exceed Final Grand Total (₹${finalTotal.toFixed(2)}).`;
                    amountReceivedError.classList.remove('d-none');
                }
                paidAmount = finalTotal;
                creditAmount = 0.00;
            } else {
                if (amountReceivedError) amountReceivedError.classList.add('d-none');
                paidAmount = received;
                creditAmount = Math.max(0.00, finalTotal - paidAmount);
            }
            if (dispCreditAmount) {
                dispCreditAmount.textContent = '₹' + creditAmount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            }
            if (prominentBalanceToPay) {
                prominentBalanceToPay.textContent = '₹' + creditAmount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            }
        }

        // Customer Balance Impact & Outstanding
        if (currentCustomer) {
            const prevBal = parseFloat(currentCustomer.current_outstanding || 0);
            const creditLimit = parseFloat(currentCustomer.credit_limit || 0);
            const creditAllowed = parseInt(currentCustomer.credit_allowed || 0, 10);
            const newBal = prevBal + creditAmount;
            const availCredit = (creditAllowed && creditLimit > 0) ? Math.max(0, creditLimit - newBal) : 0;

            if (custImpactStatus) {
                custImpactStatus.textContent = currentCustomer.customer_code;
                custImpactStatus.className = 'badge bg-primary-subtle text-primary';
            }
            if (custImpactDetails) custImpactDetails.classList.remove('d-none');
            if (custImpactWalkinNotice) custImpactWalkinNotice.classList.add('d-none');

            sidePrevBal.textContent = '₹' + prevBal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            sideCreditAdded.textContent = '₹' + creditAmount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            sideNewBal.textContent = '₹' + newBal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});

            dispNewOutstanding.textContent = '₹' + newBal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            dispAvailableCredit.textContent = '₹' + availCredit.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});

            if (creditAmount > 0) {
                if (creditAllowed === 0) {
                    creditAlertBanner.className = 'alert alert-danger d-flex align-items-center gap-2 mt-3 mb-0';
                    creditAlertMessage.textContent = 'Credit is not allowed for this customer.';
                    creditAlertBanner.classList.remove('d-none');
                    overrideBox.classList.add('d-none');
                } else if (creditLimit > 0 && newBal > creditLimit) {
                    const excess = newBal - creditLimit;
                    creditAlertBanner.className = 'alert alert-danger d-flex align-items-center gap-2 mt-3 mb-0';
                    creditAlertMessage.innerHTML = `<strong>Credit limit exceeded!</strong> Available Credit was ₹${Math.max(0, creditLimit - prevBal).toFixed(2)}. Requested Credit exceeds limit by ₹${excess.toFixed(2)}.`;
                    creditAlertBanner.classList.remove('d-none');
                    overrideBox.classList.remove('d-none');
                } else if (creditLimit > 0 && newBal >= creditLimit * 0.8) {
                    creditAlertBanner.className = 'alert alert-warning d-flex align-items-center gap-2 mt-3 mb-0';
                    creditAlertMessage.textContent = `Warning: Customer is approaching credit limit (${((newBal/creditLimit)*100).toFixed(1)}% utilized).`;
                    creditAlertBanner.classList.remove('d-none');
                    overrideBox.classList.add('d-none');
                } else {
                    creditAlertBanner.classList.add('d-none');
                    overrideBox.classList.add('d-none');
                }
            } else {
                creditAlertBanner.classList.add('d-none');
                overrideBox.classList.add('d-none');
            }
        } else {
            // No customer selected
            if (isCredit) {
                if (custImpactStatus) {
                    custImpactStatus.textContent = 'Customer Required';
                    custImpactStatus.className = 'badge bg-danger-subtle text-danger';
                }
                if (custImpactDetails) custImpactDetails.classList.add('d-none');
                if (custImpactWalkinNotice) {
                    custImpactWalkinNotice.classList.remove('d-none');
                    custImpactWalkinNotice.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i><strong>Customer required for Credit Sale!</strong> Please select customer from master list.</span>';
                }
            } else {
                if (custImpactStatus) {
                    custImpactStatus.textContent = 'Walk-in';
                    custImpactStatus.className = 'badge bg-secondary-subtle text-secondary';
                }
                if (custImpactDetails) custImpactDetails.classList.add('d-none');
                if (custImpactWalkinNotice) {
                    custImpactWalkinNotice.classList.remove('d-none');
                    custImpactWalkinNotice.innerHTML = '<span class="text-muted"><i class="bi bi-info-circle me-1"></i>Walk-in customer sale. No customer ledger entry created.</span>';
                }
            }
            creditAlertBanner.classList.add('d-none');
            overrideBox.classList.add('d-none');
        }
    }

    // Input event listeners
    otherChargesInput.addEventListener('input', recalculateAll);
    if (paymentTypeSelect) paymentTypeSelect.addEventListener('change', recalculateAll);
    if (amountReceivedInput) amountReceivedInput.addEventListener('input', recalculateAll);

    if (resetFinalTotalBtn) {
        resetFinalTotalBtn.addEventListener('click', function() {
            isFinalTotalManuallyEdited = false;
            recalculateAll();
        });
    }

    if (finalGrandTotalInput) {
        finalGrandTotalInput.addEventListener('input', function() {
            isFinalTotalManuallyEdited = true;
            recalculateAll();
        });
    }

    // Form submission validation
    salesNoteForm.addEventListener('submit', function(e) {
        if (items.length === 0) {
            e.preventDefault();
            alert('Please add at least one product to the sales note.');
            return false;
        }

        const rawFinal = parseFloat(finalGrandTotalInput.value);
        if (isNaN(rawFinal) || rawFinal <= 0) {
            e.preventDefault();
            finalTotalErrorText.textContent = 'Final Grand Total must be greater than ₹0.00.';
            finalTotalError.classList.remove('d-none');
            finalGrandTotalInput.focus();
            alert('Please enter a valid Final Grand Total greater than ₹0.00.');
            return false;
        }

        const subtotal = items.reduce((sum, item) => sum + (item.quantity * item.unit_price) - Math.min(item.quantity * item.unit_price, item.discount || 0) + ((item.quantity * item.unit_price - Math.min(item.quantity * item.unit_price, item.discount || 0)) * (item.tax_percent || 0) / 100), 0);
        const other = parseFloat(otherChargesInput.value) || 0;
        const calcTotal = subtotal + other;

        if (rawFinal > calcTotal + 0.01) {
            e.preventDefault();
            finalTotalErrorText.textContent = `Final Grand Total (₹${rawFinal.toFixed(2)}) cannot exceed calculated Grand Total (₹${calcTotal.toFixed(2)}).`;
            finalTotalError.classList.remove('d-none');
            finalGrandTotalInput.focus();
            alert(`Adjusted / Final Grand Total cannot exceed calculated Grand Total (₹${calcTotal.toFixed(2)}).`);
            return false;
        }

        const isCredit = saleTypeCredit && saleTypeCredit.checked;
        if (isCredit) {
            if (!customerSelect.value) {
                e.preventDefault();
                customerValidationFeedback.classList.remove('d-none');
                customerSelect.focus();
                alert('Customer selection is required for Credit Sale. Please select a customer.');
                return false;
            }

            const received = parseFloat(amountReceivedInput.value) || 0;
            if (received > rawFinal + 0.01) {
                e.preventDefault();
                amountReceivedError.classList.remove('d-none');
                amountReceivedInput.focus();
                alert(`Amount Received (₹${received.toFixed(2)}) cannot exceed Final Grand Total (₹${rawFinal.toFixed(2)}).`);
                return false;
            }
        }
    });

    // Quick Add Customer AJAX submission
    const quickAddCustomerForm = document.getElementById('quickAddCustomerForm');
    const quickCustomerModalAlert = document.getElementById('quickCustomerModalAlert');
    const quickSaveCustomerBtn = document.getElementById('quickSaveCustomerBtn');

    if (quickAddCustomerForm) {
        quickAddCustomerForm.addEventListener('submit', function(e) {
            e.preventDefault();
            quickCustomerModalAlert.classList.add('d-none');
            quickCustomerModalAlert.textContent = '';

            const name = document.getElementById('quickCustName').value.trim();
            const mobile = document.getElementById('quickCustMobile').value.trim();
            if (!name || !mobile) {
                quickCustomerModalAlert.textContent = 'Please provide both Customer Name and Mobile Number.';
                quickCustomerModalAlert.classList.remove('d-none');
                return;
            }

            quickSaveCustomerBtn.disabled = true;
            quickSaveCustomerBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            const payload = {
                ajax: '1',
                customer_name: name,
                customer_type: document.getElementById('quickCustType').value,
                company_name: document.getElementById('quickCustCompany').value.trim(),
                mobile_number: mobile,
                credit_allowed: document.getElementById('quickCustCreditAllowed').checked ? 1 : 0,
                credit_limit: document.getElementById('quickCustCreditLimit').value,
                address: document.getElementById('quickCustAddress').value.trim(),
                opening_balance: '0.00',
                opening_balance_type: 'Debit',
                status: 1
            };

            fetch('create_customer.php', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                quickSaveCustomerBtn.disabled = false;
                quickSaveCustomerBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save & Select Customer';

                if (data.success && data.customer) {
                    const c = data.customer;
                    // Add option to customerSelect
                    const newOpt = new Option(`${c.customer_code} - ${c.customer_name} (${c.mobile_number})`, c.id, true, true);
                    customerSelect.add(newOpt);
                    customerSelect.value = c.id;

                    // Trigger change and load details
                    loadCustomerDetails(c.id);

                    // Close modal
                    const modalEl = document.getElementById('quickAddCustomerModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modalInstance.hide();
                    quickAddCustomerForm.reset();

                    alert(`Customer ${c.customer_name} (${c.customer_code}) created and selected successfully!`);
                } else {
                    quickCustomerModalAlert.textContent = data.message || (data.errors ? data.errors.join(', ') : 'Failed to create customer.');
                    quickCustomerModalAlert.classList.remove('d-none');
                }
            })
            .catch(err => {
                quickSaveCustomerBtn.disabled = false;
                quickSaveCustomerBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save & Select Customer';
                quickCustomerModalAlert.textContent = 'Network or server error while creating customer: ' + err.message;
                quickCustomerModalAlert.classList.remove('d-none');
            });
        });
    }

    // Escape HTML helper
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Initialize UI on page load
    updateSaleTypeUI();
});
</script>

<!-- QUICK ADD CUSTOMER MODAL -->
