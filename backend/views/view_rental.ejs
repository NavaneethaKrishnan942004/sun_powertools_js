<%- include('includes/header') %>

<main class="main-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Breadcrumb Navigation -->
        <%- renderBreadcrumbs([
            { title: '', icon: 'bi bi-house-door', link: 'index.php' },
            { title: 'Rentals', link: 'manage_rental.php' },
            { title: 'View Rental ' + rental.rental_no }
        ]) %>

        <!-- PAGE HEADER -->
        <div class="page-heading d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h1 class="page-title mb-0">
                        <i class="bi bi-clock-history text-primary me-2"></i>Rental Contract <%= rental.rental_no %>
                    </h1>
                    <%- getRentalStatusBadge(rental.rental_status, rental.expected_checkout_datetime) %>
                </div>
                <p class="text-muted mb-0">Created on <%= String(rental.created_at).replace('T', ' ').slice(0, 19) %> <%= rental.created_by_name ? `by ${rental.created_by_name}` : '' %></p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Contract
                </button>
                <a href="manage_rental.php" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Rentals
                </a>
                <% if (['Active', 'Overdue'].includes(rental.effective_status)) { %>
                    <button type="button" class="btn btn-success shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#returnModal">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Return Product / Check-In
                    </button>
                <% } %>
            </div>
        </div>

        <!-- ALERTS / NOTIFICATIONS -->
        <% if (locals.success) { %>
            <div class="alert alert-success alert-dismissible fade show auto-hide-alert d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="fw-medium"><%= success %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="fw-medium"><%= error %></div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="row g-4">

            <!-- LEFT COLUMN: CUSTOMER, PRODUCT & TIMING DETAILS -->
            <div class="col-12 col-lg-8">

                <!-- 1. CUSTOMER CARD -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-person-circle me-2"></i>Customer Information
                        </h5>
                        <a href="view_customer.php?id=<%= rental.customer_id %>" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-box-arrow-up-right me-1"></i> View Profile
                        </a>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label text-muted small mb-0">Customer Name</label>
                                <div class="fw-bold text-body fs-6"><%= rental.customer_name %></div>
                                <% if (rental.company_name) { %>
                                    <small class="text-muted"><%= rental.company_name %></small>
                                <% } %>
                            </div>
                            <div class="col-6 col-sm-3">
                                <label class="form-label text-muted small mb-0">Customer Code</label>
                                <div><span class="badge bg-light text-dark border"><%= rental.customer_code %></span></div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <label class="form-label text-muted small mb-0">Customer Type</label>
                                <div class="fw-medium"><%= rental.customer_type || 'Individual' %></div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label text-muted small mb-0">Mobile Number</label>
                                <div class="fw-medium"><i class="bi bi-telephone text-primary me-1"></i><%= rental.mobile_number %></div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label text-muted small mb-0">Email Address</label>
                                <div><%= rental.customer_email || 'Not provided' %></div>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted small mb-0">Address</label>
                                <div>
                                    <%= [rental.customer_address, rental.customer_city, rental.customer_state, rental.customer_pincode].filter(Boolean).join(', ') || 'N/A' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. PRODUCT DETAILS CARD -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-surface py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-tools me-2"></i>Rented Equipment & Rates
                        </h5>
                        <a href="view_product.php?id=<%= rental.product_id %>" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-box-arrow-up-right me-1"></i> View Product
                        </a>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4 align-items-center">
                            <% if (productImage) { %>
                                <div class="col-12 col-sm-3 text-center">
                                    <img src="/<%= productImage.replace(/^\/+/, '') %>" class="img-fluid rounded-3 border p-1" style="max-height: 120px; object-fit: cover;" alt="<%= rental.product_name %>">
                                </div>
                            <% } %>
                            <div class="col-12 <%= productImage ? 'col-sm-9' : 'col-sm-12' %>">
                                <h5 class="fw-bold text-body mb-1"><%= rental.product_name %></h5>
                                <div class="small text-muted mb-3">
                                    <span class="badge bg-light text-dark border"><%= rental.product_code %></span>
                                    <% if (rental.short_name) { %> &bull; <span><%= rental.short_name %></span><% } %>
                                    <% if (rental.brand_name) { %> &bull; <span class="fw-medium text-body"><%= rental.brand_name %></span><% } %>
                                    <% if (rental.category_name) { %> &bull; <span><%= rental.category_name %></span><% } %>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 bg-surface-soft rounded border text-center">
                                            <span class="text-muted small d-block">Billing Period</span>
                                            <strong class="text-capitalize text-body"><%= rental.rental_period_type || 'Daily' %></strong>
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 bg-surface-soft rounded border text-center">
                                            <span class="text-muted small d-block">Estimated Duration</span>
                                            <strong class="text-body"><%= rental.estimated_duration || 1 %> <%= (rental.rental_period_type || 'day').replace(/s$/, '') %>(s)</strong>
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 bg-surface-soft rounded border text-center">
                                            <span class="text-muted small d-block">Rental Rate</span>
                                            <strong class="text-primary">₹<%= numberFormat(rental.rental_rate, 2) %></strong>
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 bg-surface-soft rounded border text-center">
                                            <span class="text-muted small d-block">Current Stock</span>
                                            <strong class="text-success"><%= rental.current_stock %> units</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. RENTAL SCHEDULE & DURATION TIMELINE -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-surface py-3 px-4 border-bottom">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-calendar2-week me-2"></i>Rental Schedule & Duration Timeline
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <!-- Check-In -->
                            <div class="col-12 col-sm-4">
                                <div class="p-3 bg-surface-soft rounded-3 border border-success-subtle h-100">
                                    <div class="d-flex align-items-center gap-2 text-success fw-bold mb-1">
                                        <i class="bi bi-box-arrow-right"></i> Rental Start (Check-In)
                                    </div>
                                    <div class="fs-6 fw-bold text-body">
                                        <%= rental.check_in_datetime ? String(rental.check_in_datetime).replace('T', ' ').slice(0, 16) : '-' %>
                                    </div>
                                    <small class="text-muted">Equipment handed over to customer</small>
                                </div>
                            </div>

                            <!-- Expected Checkout -->
                            <div class="col-12 col-sm-4">
                                <div class="p-3 bg-surface-soft rounded-3 border <%= rental.effective_status === 'Overdue' ? 'border-danger bg-danger-subtle text-danger' : 'border-primary-subtle' %> h-100">
                                    <div class="d-flex align-items-center gap-2 <%= rental.effective_status === 'Overdue' ? 'text-danger fw-bold' : 'text-primary fw-bold' %> mb-1">
                                        <i class="bi bi-box-arrow-in-left"></i> Expected Return
                                    </div>
                                    <div class="fs-6 fw-bold text-body">
                                        <%= rental.expected_checkout_datetime ? String(rental.expected_checkout_datetime).replace('T', ' ').slice(0, 16) : '-' %>
                                    </div>
                                    <small class="<%= rental.effective_status === 'Overdue' ? 'text-danger fw-semibold' : 'text-muted' %>">
                                        <%= rental.effective_status === 'Overdue' ? 'Overdue - Not Returned Yet' : `Est: ${rental.estimated_duration || 1} ${rental.rental_period_type || 'day'}(s)` %>
                                    </small>
                                </div>
                            </div>

                            <!-- Actual Return -->
                            <div class="col-12 col-sm-4">
                                <div class="p-3 bg-surface-soft rounded-3 border <%= rental.actual_return_datetime ? 'border-success' : 'border-secondary-subtle' %> h-100">
                                    <div class="d-flex align-items-center gap-2 <%= rental.actual_return_datetime ? 'text-success fw-bold' : 'text-muted fw-bold' %> mb-1">
                                        <i class="bi bi-check-circle"></i> Actual Return
                                    </div>
                                    <div class="fs-6 fw-bold <%= rental.actual_return_datetime ? 'text-success' : 'text-muted' %>">
                                        <%= rental.actual_return_datetime ? String(rental.actual_return_datetime).replace('T', ' ').slice(0, 16) : 'Not Returned Yet' %>
                                    </div>
                                    <small class="text-muted">
                                        <%= rental.actual_return_datetime ? `Actual Duration: ${rental.actual_duration || liveSettlement.actualDurationText}` : 'Awaiting return' %>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Duration Comparison Banner -->
                        <div class="mt-3 p-3 bg-surface-soft border rounded-3">
                            <div class="row g-2 text-center text-sm-start">
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted small d-block">Estimated Duration:</span>
                                    <strong class="text-body"><%= rental.estimated_duration || 1 %> <%= (rental.rental_period_type || 'day').replace(/s$/, '') %>(s)</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted small d-block">Actual Duration:</span>
                                    <strong class="<%= rental.actual_return_datetime ? 'text-success' : 'text-primary' %>">
                                        <%= rental.actual_duration || liveSettlement.actualDurationText %>
                                    </strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted small d-block">Overdue Duration:</span>
                                    <strong class="<%= (Number(rental.overdue_amount) > 0 || liveSettlement.isOverdue) ? 'text-danger' : 'text-muted' %>">
                                        <%= rental.overdue_duration || liveSettlement.overdueDurationText %>
                                    </strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted small d-block">Overdue Fee:</span>
                                    <strong class="<%= (Number(rental.overdue_amount) > 0 || liveSettlement.overdueAmount > 0) ? 'text-danger' : 'text-body' %>">
                                        ₹<%= numberFormat(rental.actual_return_datetime ? rental.overdue_amount : liveSettlement.overdueAmount, 2) %>
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <% if (rental.notes) { %>
                            <div class="mt-3 pt-3 border-top">
                                <label class="form-label text-muted small fw-semibold mb-1">Notes & History</label>
                                <div class="p-2.5 bg-surface-soft rounded border small">
                                    <%- nl2br(rental.notes) %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN: FINANCIAL BREAKDOWN, DEPOSITS & ACTIONS -->
            <div class="col-12 col-lg-4">

                <!-- FINANCIAL SUMMARY CARD -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-surface py-3 px-4 border-bottom">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-cash-coin me-2"></i>Financial & Settlement Summary
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Rental Rate:</span>
                            <strong class="text-body">₹<%= numberFormat(rental.rental_rate, 2) %> / <%= rental.rental_period_type || 'day' %></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Estimated Duration:</span>
                            <strong class="text-body"><%= rental.estimated_duration || 1 %> <%= rental.rental_period_type || 'day' %>(s)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Original Rental Fee:</span>
                            <strong class="text-body">₹<%= numberFormat((rental.estimated_duration || 1) * rental.rental_rate, 2) %></strong>
                        </div>

                        <% if (Number(rental.overdue_amount) > 0 || (!rental.actual_return_datetime && liveSettlement.overdueAmount > 0)) { %>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-danger fw-semibold">Overdue Additional Fee:</span>
                                <strong class="text-danger">+ ₹<%= numberFormat(rental.actual_return_datetime ? rental.overdue_amount : liveSettlement.overdueAmount, 2) %></strong>
                            </div>
                        <% } %>

                        <% if (Number(rental.additional_charges) > 0) { %>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Additional / Damage Fee:</span>
                                <strong class="text-danger">+ ₹<%= numberFormat(rental.additional_charges, 2) %></strong>
                            </div>
                        <% } %>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Advance Paid:</span>
                            <strong class="text-success">₹<%= numberFormat(rental.advance_rental_amount, 2) %></strong>
                        </div>

                        <hr class="my-2">

                        <!-- DEPOSIT ACCOUNTING SECTION -->
                        <div class="p-2.5 bg-surface-soft rounded-3 border mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small">Security Deposit Held:</span>
                                <strong class="text-body small">₹<%= numberFormat(rental.security_deposit, 2) %></strong>
                            </div>
                            <% if (Number(rental.deposit_deduction_amount) > 0) { %>
                                <div class="d-flex justify-content-between mb-1 text-danger small">
                                    <span>Deposit Deductions (<%= rental.deposit_deduction_reason || 'Damage/Penalty' %>):</span>
                                    <strong>- ₹<%= numberFormat(rental.deposit_deduction_amount, 2) %></strong>
                                </div>
                            <% } %>
                            <% if (Number(rental.deposit_return_amount) > 0 || Number(rental.refund_amount) > 0) { %>
                                <div class="d-flex justify-content-between text-success small">
                                    <span>Deposit Refunded:</span>
                                    <strong>₹<%= numberFormat(rental.deposit_return_amount || rental.refund_amount, 2) %></strong>
                                </div>
                            <% } else if (rental.actual_return_datetime && Number(rental.security_deposit) > 0) { %>
                                <div class="d-flex justify-content-between text-muted small">
                                    <span>Deposit Refunded:</span>
                                    <span>₹0.00 (Applied to Dues)</span>
                                </div>
                            <% } %>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold text-body">Total Rental Amount:</span>
                            <strong class="fw-bold text-primary fs-5">₹<%= numberFormat(rental.total_rental_amount, 2) %></strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted small">Payment Mode:</span>
                            <span class="badge bg-light text-dark border"><%= rental.payment_method || 'Cash' %></span>
                        </div>

                        <!-- Return / Cancel Actions -->
                        <% if (['Active', 'Overdue'].includes(rental.effective_status)) { %>
                            <div class="d-grid gap-2 mt-4">
                                <button type="button" class="btn btn-success btn-lg shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#returnModal">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Return Product / Settle
                                </button>
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                    <i class="bi bi-x-circle me-1"></i> Cancel Rental
                                </button>
                            </div>
                        <% } else if (rental.effective_status === 'Returned') { %>
                            <div class="alert alert-success d-flex align-items-center gap-2 mb-0 py-2.5">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <div class="small fw-semibold">Contract returned and fully settled. Stock restored.</div>
                            </div>
                        <% } else if (rental.effective_status === 'Cancelled') { %>
                            <div class="alert alert-secondary d-flex align-items-center gap-2 mb-0 py-2.5">
                                <i class="bi bi-x-circle-fill text-secondary fs-5"></i>
                                <div class="small fw-semibold">This rental was cancelled.</div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- CUSTOMER BALANCE CARD -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-surface py-3 px-4 border-bottom">
                        <h6 class="fw-bold mb-0 text-body">
                            <i class="bi bi-wallet2 me-2 text-primary"></i>Customer Account Summary
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Credit Limit:</span>
                            <strong class="text-body small">₹<%= numberFormat(customerSummary.credit_limit, 2) %></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Current Total Outstanding:</span>
                            <strong class="text-danger small">₹<%= numberFormat(customerSummary.current_outstanding, 2) %></strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Total Rental Transactions:</span>
                            <strong class="text-primary small">₹<%= numberFormat(customerSummary.total_rentals, 2) %></strong>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</main>

<!-- RETURN PRODUCT MODAL WITH LIVE CALCULATION -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="POST" action="return_rental.php" id="viewReturnForm">
                <input type="hidden" name="id" value="<%= rental.id %>">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-success" id="returnModalLabel">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Return Rental Product & Settlement
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- RENTAL SUMMARY HEADER -->
                    <div class="p-3 bg-surface-soft rounded-3 border mb-3">
                        <div class="row g-2">
                            <div class="col-12 col-sm-6">
                                <span class="text-muted small">Customer:</span>
                                <strong class="d-block"><%= rental.customer_name %> (<%= rental.customer_code %>)</strong>
                            </div>
                            <div class="col-12 col-sm-6">
                                <span class="text-muted small">Product:</span>
                                <strong class="d-block"><%= rental.product_name %></strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted small">Billing Period:</span>
                                <strong class="d-block text-capitalize"><%= rental.rental_period_type || 'Daily' %></strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted small">Rate:</span>
                                <strong class="d-block text-primary">₹<%= numberFormat(rental.rental_rate, 2) %></strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted small">Deposit Amount:</span>
                                <strong class="d-block text-body">₹<%= numberFormat(rental.security_deposit, 2) %></strong>
                            </div>
                            <div class="col-6 col-sm-3">
                                <span class="text-muted small">Advance Paid:</span>
                                <strong class="d-block text-success">₹<%= numberFormat(rental.advance_rental_amount, 2) %></strong>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Actual Return Date & Time -->
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-semibold">Actual Return Date & Time <span class="text-danger">*</span></label>
                            <input
                                type="datetime-local"
                                name="actual_return_datetime"
                                id="modalActualReturnDatetime"
                                class="form-control"
                                value="<%= currentDatetimeLocal %>"
                                required
                            >
                        </div>

                        <!-- Additional Charges / Damage Charges -->
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-semibold">Additional Charges / Late Penalty (₹)</label>
                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                name="additional_charges"
                                id="modalAdditionalCharges"
                                class="form-control"
                                value="0.00"
                            >
                        </div>

                        <!-- Deposit Deductions -->
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-semibold">Deposit Deductions (Damage / Loss) (₹)</label>
                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                name="deposit_deduction_amount"
                                id="modalDepositDeduction"
                                class="form-control"
                                value="0.00"
                            >
                        </div>

                        <!-- Deposit Deduction Reason -->
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-semibold">Reason for Deposit Deduction</label>
                            <input
                                type="text"
                                name="deposit_deduction_reason"
                                id="modalDeductionReason"
                                class="form-control"
                                placeholder="e.g., Broken bit, missing tool box..."
                            >
                        </div>

                        <!-- Notes / Condition -->
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Condition Notes / Remarks</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Tool inspected and restocked in working condition..."></textarea>
                        </div>
                    </div>

                    <!-- LIVE SETTLEMENT CALCULATION SUMMARY CARD -->
                    <div class="mt-4 p-3 bg-light border rounded-3">
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-receipt me-1"></i>Live Return Settlement Summary
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-muted">Rental Start:</td>
                                        <td class="text-end fw-semibold"><%= String(rental.check_in_datetime).replace('T', ' ').slice(0, 16) %></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Expected Return:</td>
                                        <td class="text-end fw-semibold"><%= String(rental.expected_checkout_datetime).replace('T', ' ').slice(0, 16) %></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Actual Duration:</td>
                                        <td class="text-end fw-bold text-primary" id="modalDispActualDuration"><%= liveSettlement.actualDurationText %></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Overdue Duration:</td>
                                        <td class="text-end fw-bold" id="modalDispOverdueDuration"><%= liveSettlement.overdueDurationText %></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Original Rental Amount:</td>
                                        <td class="text-end fw-semibold" id="modalDispOriginalAmount">₹<%= numberFormat(liveSettlement.originalRentalAmount, 2) %></td>
                                    </tr>
                                    <tr id="modalOverdueRow">
                                        <td class="text-muted text-danger">Additional Overdue Fee:</td>
                                        <td class="text-end fw-bold text-danger" id="modalDispOverdueAmount">₹<%= numberFormat(liveSettlement.overdueAmount, 2) %></td>
                                    </tr>
                                    <tr class="border-top">
                                        <td class="fw-bold text-body">Total Rental Amount:</td>
                                        <td class="text-end fw-bold text-primary fs-6" id="modalDispTotalAmount">₹<%= numberFormat(liveSettlement.totalRentalAmount, 2) %></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Advance Paid:</td>
                                        <td class="text-end text-success fw-semibold" id="modalDispAdvance">₹<%= numberFormat(liveSettlement.advanceRentalAmount, 2) %></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Security Deposit Held:</td>
                                        <td class="text-end fw-semibold" id="modalDispDeposit">₹<%= numberFormat(liveSettlement.securityDeposit, 2) %></td>
                                    </tr>
                                    <tr id="modalDepositReturnRow" class="border-top">
                                        <td class="fw-bold text-success">Security Deposit Returned to Customer:</td>
                                        <td class="text-end fw-bold text-success fs-6" id="modalDispDepositReturned">₹<%= numberFormat(liveSettlement.depositReturnAmount, 2) %></td>
                                    </tr>
                                    <tr id="modalDepositUsedRow">
                                        <td class="text-muted">Deposit Applied Toward Outstanding Charges:</td>
                                        <td class="text-end text-warning-emphasis fw-semibold" id="modalDispDepositUsed">₹<%= numberFormat(liveSettlement.depositUsed, 2) %></td>
                                    </tr>
                                    <tr class="border-top bg-surface-soft">
                                        <td class="fw-bold text-danger fs-6">Remaining Amount Due from Customer:</td>
                                        <td class="text-end fw-bold text-danger fs-5" id="modalDispRemainingDue">₹<%= numberFormat(liveSettlement.remainingAmountDue, 2) %></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-check-lg me-1"></i> Confirm Product Return & Settle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CANCEL RENTAL MODAL -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="POST" action="cancel_rental.php">
                <input type="hidden" name="id" value="<%= rental.id %>">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-danger" id="cancelModalLabel">
                        <i class="bi bi-x-circle me-2"></i>Cancel Rental Contract
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <i class="bi bi-exclamation-triangle text-warning display-4 mb-3 d-block"></i>
                    <h6 class="fw-bold mb-2">Cancel rental <span class="text-primary"><%= rental.rental_no %></span>?</h6>
                    <p class="text-muted small mb-3">Cancelling this rental will restore the product stock back to inventory and cancel the customer ledger transaction.</p>
                    <div class="text-start">
                        <label class="form-label small fw-semibold">Reason for Cancellation</label>
                        <input type="text" name="reason" class="form-control" placeholder="Customer cancelled, wrong order, etc." required>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Yes, Cancel Rental
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const actualReturnInput = document.getElementById('modalActualReturnDatetime');
    const additionalChargesInput = document.getElementById('modalAdditionalCharges');
    const depositDeductionInput = document.getElementById('modalDepositDeduction');
    const deductionReasonInput = document.getElementById('modalDeductionReason');

    function formatINR(val) {
        const num = parseFloat(val) || 0;
        return '₹' + num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function refreshReturnSettlement() {
        const rentalId = <%= rental.id %>;
        const actualReturn = actualReturnInput.value;
        const addCharges = additionalChargesInput.value || 0;
        const deductions = depositDeductionInput.value || 0;
        const reason = deductionReasonInput.value || '';

        fetch(`/ajax_rental.php?action=calculate_return_settlement&rental_id=${rentalId}&actual_return=${encodeURIComponent(actualReturn)}&additional_charges=${encodeURIComponent(addCharges)}&deposit_deductions=${encodeURIComponent(deductions)}&deposit_deduction_reason=${encodeURIComponent(reason)}`)
            .then(res => res.json())
            .then(data => {
                if (data.success && data.settlement) {
                    const s = data.settlement;
                    document.getElementById('modalDispActualDuration').textContent = s.actualDurationText;
                    document.getElementById('modalDispOverdueDuration').textContent = s.overdueDurationText;
                    document.getElementById('modalDispOriginalAmount').textContent = formatINR(s.originalRentalAmount);
                    document.getElementById('modalDispOverdueAmount').textContent = formatINR(s.overdueAmount);
                    document.getElementById('modalDispTotalAmount').textContent = formatINR(s.totalRentalAmount);
                    document.getElementById('modalDispDepositReturned').textContent = formatINR(s.depositReturnAmount);
                    document.getElementById('modalDispDepositUsed').textContent = formatINR(s.depositUsed);
                    document.getElementById('modalDispRemainingDue').textContent = formatINR(s.remainingAmountDue);
                }
            })
            .catch(err => console.error('Settlement fetch error:', err));
    }

    if (actualReturnInput) {
        actualReturnInput.addEventListener('change', refreshReturnSettlement);
    }
    if (additionalChargesInput) {
        additionalChargesInput.addEventListener('input', refreshReturnSettlement);
    }
    if (depositDeductionInput) {
        depositDeductionInput.addEventListener('input', refreshReturnSettlement);
    }
});
</script>

