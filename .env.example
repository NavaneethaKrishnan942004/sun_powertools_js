# Sun PowerTools ERP Environment Configuration

# Application Server
PORT=3000
NODE_ENV=production
SESSION_SECRET=sun_powertools_production_secret_key_change_me

# Database Connection (XAMPP for local, Remote Cloud MySQL for Render)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=powertools_db

# Optional: Cloud MySQL SSL (set to true for cloud providers like Aiven, TiDB, PlanetScale, Railway)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: Alternatively use a single database connection URI (if provided by your cloud host)
# DATABASE_URL=mysql://username:password@hostname:3306/dbname?ssl-mode=REQUIRED
